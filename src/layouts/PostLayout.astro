---
import { Image, getImage } from "astro:assets";
import { Icon } from "astro-icon/components";
import Layout from "@layouts/Layout.astro";
import { formatDate } from "@utils/date";
import PostHeadings from "@components/table-of-contents/PostHeadings.astro";
import RelatedPosts from "@components/blog/RelatedPosts.astro";
import SocialShare from "@components/blog/SocialShare.astro";
import ServicesPromo from "@components/blog/ServicesPromo.astro";
import SeriesNav from "@components/widgets/SeriesNav.astro";
import ReadingProgress from "@components/blog/ReadingProgress.astro";
import Breadcrumb from "@components/common/Breadcrumb.astro";
import { getAllAuthors, getAllPublishedPosts } from "@utils/postsCache";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";

import { getEntrySlug } from "@utils/content";
import {
  getLocaleBasePath,
  getPostLocale,
  getPostTranslationKey,
  isPostIdInLocale,
} from "@utils/i18n";
import { buildArchivePath, toTaxonomySlug } from "@utils/slugs";
import { getRelatedPosts } from "@utils/relatedPosts";
import { getReadingTime } from "@utils/readingTime";
import { t } from "@i18n/ui";
import { formatTaxonomyLabel } from "@utils/labels";

interface Props {
  post: CollectionEntry<"posts">;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, meta_title, description, image, date, lastmod, categories, authors, tags } =
  post.data;
const imageAlt = post.data.imageAlt || title;
const postSlug = getEntrySlug(post);
const locale = getPostLocale(post);
const homePath = getLocaleBasePath(locale);
const blogPath = locale === "es" ? "/es/blog/" : "/blog/";
// Get the canonical URL for this post
// Make sure we have a valid site URL to avoid the TypeError: Invalid URL error
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.pathname;

// Shared build-time posts cache — one collection scan for all posts
const allPosts = await getAllPublishedPosts();
const allLocalePosts = allPosts.filter((p) => isPostIdInLocale(p.id, locale));

const postTranslationKey = getPostTranslationKey(post);
const translatedPosts = allPosts.filter(
  (entry) => getPostTranslationKey(entry) === postTranslationKey
);

const hreflangs = translatedPosts.map((entry) => {
  const slug = getEntrySlug(entry);
  const entryLocale = getPostLocale(entry);
  const href = Astro.site ? new URL(`/${slug}/`, Astro.site).toString() : `/${slug}/`;

  return {
    lang: entryLocale,
    href,
  };
});

const defaultEntry = translatedPosts.find((entry) => getPostLocale(entry) === "en") || post;
const defaultHref = Astro.site
  ? new URL(`/${getEntrySlug(defaultEntry)}/`, Astro.site).toString()
  : `/${getEntrySlug(defaultEntry)}/`;
const seoHreflangs = [...hreflangs, { lang: "x-default", href: defaultHref }];

// Compute reading time
const readingTime = getReadingTime(post.body || "");
const readingTimeLabel = t(locale, "minRead");
const isUpdated = Boolean(lastmod && (!date || lastmod.toDateString() !== date.toDateString()));

// Look up author social links for structured data
const firstAuthor = authors && authors.length > 0 ? authors[0] : null;
let authorForSeo: { name: string; url?: string; sameAs?: string[] } | undefined;
let authorProfile: { name: string; image?: string; bio?: string; url: string } | undefined;
if (firstAuthor) {
  const allAuthors = await getAllAuthors();
  const authorEntry = allAuthors.find(
    (a) => a.id === firstAuthor || a.data.title?.toLowerCase() === firstAuthor.toLowerCase()
  );
  const authorArchiveUrl = buildArchivePath("authors", toTaxonomySlug(firstAuthor), locale);
  if (authorEntry) {
    authorProfile = {
      name: firstAuthor,
      image: authorEntry.data.image,
      bio: authorEntry.data.description,
      url: authorArchiveUrl,
    };
  } else {
    authorProfile = { name: firstAuthor, url: authorArchiveUrl };
  }
  const social = authorEntry?.data.social;
  const sameAs = social
    ? [
        social.twitter,
        social.facebook,
        social.instagram,
        social.github,
        social.linkedin,
        social.youtube,
        social.website,
      ].filter((v): v is string => Boolean(v) && v !== "https://www.instagram.com/")
    : undefined;
  const authorUrl = Astro.site
    ? new URL(
        buildArchivePath("authors", toTaxonomySlug(firstAuthor), locale),
        Astro.site
      ).toString()
    : buildArchivePath("authors", toTaxonomySlug(firstAuthor), locale);
  authorForSeo = {
    name: firstAuthor,
    url: authorUrl,
    ...(sameAs && sameAs.length > 0 ? { sameAs } : {}),
  };
}

// Compute related posts once here and pass to both PostHeadings sidebar and RelatedPosts section
const otherLocalePosts = allLocalePosts.filter((p) => getEntrySlug(p) !== postSlug);
const sidebarRelatedPosts = getRelatedPosts(post, otherLocalePosts, 3);

// Exclude sidebar picks so the bottom "Related Posts" section shows different articles
const sidebarRelatedSlugs = new Set(sidebarRelatedPosts.map((p) => getEntrySlug(p)));
const bottomRelatedPool = otherLocalePosts.filter((p) => !sidebarRelatedSlugs.has(getEntrySlug(p)));

// Generate breadcrumbs for structured data
const breadcrumbs = [
  { name: t(locale, "home"), url: homePath },
  { name: t(locale, "blog"), url: blogPath },
];

if (categories && categories.length > 0) {
  breadcrumbs.push({
    name: formatTaxonomyLabel(categories[0]),
    url: buildArchivePath("categories", toTaxonomySlug(categories[0]), locale),
  });
}

breadcrumbs.push({ name: title, url: canonicalURL });

// og:image — emit a 1200px JPEG variant instead of the untransformed original
const ogImage = image ? await getImage({ src: image, width: 1200, format: "jpeg" }) : undefined;
---

<Layout
  title={title}
  metaTitle={meta_title}
  description={description}
  image={ogImage?.src ?? image.src}
  imageWidth={ogImage?.attributes.width ?? image.width}
  imageHeight={ogImage?.attributes.height ?? image.height}
  article={true}
  canonical={canonicalURL}
  lang={locale}
  hreflangs={seoHreflangs}
  publishDate={date}
  modifiedDate={lastmod}
  author={authorForSeo}
  tags={tags}
  categories={categories}
  breadcrumbs={breadcrumbs}
  wideContent={true}
>
  <!-- Reading Progress Bar -->
  <ReadingProgress />

  <div class="w-full py-8" style="transition: opacity 0.3s ease;">
    <!-- Content + right-rail TOC grid; the rail only exists at xl and up -->
    <div class="mx-auto max-w-[45rem] xl:max-w-[64rem] 2xl:max-w-[68rem] px-4 sm:px-6 xl:grid xl:grid-cols-[minmax(0,1fr)_16rem] 2xl:grid-cols-[minmax(0,1fr)_18rem] xl:gap-12">
      <article
        class="min-w-0"
        data-pagefind-body
        data-pagefind-meta={`locale:${locale}`}
        data-pagefind-filter={`locale:${locale}`}
      >
        <!-- Post Header -->
        <header class="mb-10">
          <!-- Section trail doubles as the category eyebrow; the title is not repeated -->
          <Breadcrumb items={breadcrumbs} className="mb-4!" showCurrent={false} />

          <h1
            class="font-display text-[clamp(2rem,1.35rem+2.7vw,3.125rem)] font-bold leading-[1.08] tracking-[-0.02em] text-balance text-gray-900 dark:text-white"
            style={`view-transition-name: post-title-${postSlug}`}
          >
            {title}
          </h1>

          {description && (
            <p class="mt-5 max-w-[62ch] text-lg sm:text-xl leading-relaxed text-pretty text-gray-600 dark:text-gray-300">
              {description}
            </p>
          )}

          <!-- Byline (excluded from the search index so the author avatar
               isn't picked as the result thumbnail and the name isn't indexed) -->
          <div
            class="mt-7 flex items-center gap-3.5 border-t border-gray-200 pt-6 dark:border-gray-800"
            data-pagefind-ignore
          >
            {authorProfile?.image && (
              <a href={authorProfile.url} class="shrink-0" tabindex="-1" aria-hidden="true">
                <img
                  src={authorProfile.image}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  class="h-11 w-11 rounded-full object-cover ring-1 ring-gray-200 dark:ring-gray-700"
                />
              </a>
            )}
            <div class="min-w-0 leading-snug">
              {authorProfile && (
                <a
                  href={authorProfile.url}
                  class="font-semibold text-gray-900 underline decoration-gray-300 underline-offset-2 transition-colors duration-200 hover:text-blue-600 hover:decoration-blue-400 dark:text-white dark:decoration-gray-600 dark:hover:text-blue-400"
                >
                  {authorProfile.name}
                </a>
              )}
              <p class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-sm text-gray-500 dark:text-gray-400">
                {isUpdated && lastmod && (
                  <>
                    <span
                      class="inline-flex items-center gap-1 font-semibold text-blue-700 dark:text-blue-400"
                      title={t(locale, "lastUpdated")}
                    >
                      <Icon name="mdi:update" class="h-3.5 w-3.5" aria-hidden="true" />
                      {t(locale, "updated")}{" "}
                      <time datetime={lastmod.toISOString()}>{formatDate(lastmod, locale)}</time>
                    </span>
                    <span aria-hidden="true" class="hidden sm:inline">
                      ·
                    </span>
                    <span class="basis-full sm:hidden" aria-hidden="true"></span>
                  </>
                )}
                {date && (
                  <>
                    <span>
                      {isUpdated && `${t(locale, "published")} `}
                      <time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
                    </span>
                    <span aria-hidden="true">·</span>
                  </>
                )}
                <span>
                  {readingTime.minutes > 0 ? readingTime.minutes : 1} {readingTimeLabel}
                </span>
              </p>
            </div>
          </div>

          <!-- Featured Image -->
          {image && (
            <div class="mt-8 overflow-hidden rounded-lg bg-gray-100 ring-1 ring-gray-900/5 aspect-video dark:bg-gray-800 dark:ring-white/10">
              <Image
                src={image}
                alt={imageAlt}
                class="w-full h-full object-cover"
                width={1280}
                height={720}
                loading="eager"
                fetchpriority="high"
                sizes="(max-width: 1280px) calc(100vw - 2rem), (max-width: 1536px) 720px, 752px"
                widths={[480, 768, 1024, 1280]}
                format="webp"
                quality={80}
                data-pagefind-meta="image[src]"
                style={`view-transition-name: post-image-${postSlug}`}
              />
            </div>
          )}
        </header>

        <!-- Series Navigation (if part of a series) -->
        {post.data.series && Array.isArray(post.data.series) && post.data.series.length === 2 && (
          <SeriesNav
            currentSlug={postSlug}
            seriesName={post.data.series[0]}
            seriesPosition={post.data.series[1]}
          />
        )}

        <!-- Post Content -->
        <div
          class="prose prose-lg dark:prose-invert prose-blue prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-img:rounded-lg w-full max-w-none!"
          style="min-height: 200px;"
          data-post-body
        >
          <slot />
        </div>

        <!-- Tags (end of article) -->
        {tags && tags.length > 0 && (
          <div class="mt-10 flex flex-wrap gap-2 border-t border-gray-200 pt-6 dark:border-gray-700">
            {tags.map((tag: string) => (
              <a
                href={buildArchivePath("tags", toTaxonomySlug(tag), locale)}
                class="rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700 transition-colors duration-200 hover:bg-blue-100 hover:text-blue-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-blue-900 dark:hover:text-blue-300"
              >
                #{formatTaxonomyLabel(tag)}
              </a>
            ))}
          </div>
        )}

        <!-- Author byline -->
        {authorProfile && (
          <aside class="not-prose mt-8 rounded-lg border border-gray-200 bg-gray-50 p-5 dark:border-gray-700 dark:bg-gray-800/50">
            <div class="flex items-start gap-4">
              {authorProfile.image && (
                <img
                  src={authorProfile.image}
                  alt={authorProfile.name}
                  width="48"
                  height="48"
                  loading="lazy"
                  class="h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-gray-200 dark:ring-gray-700"
                />
              )}
              <div class="min-w-0">
                <p class="text-sm font-semibold text-gray-900 dark:text-white">
                  {t(locale, "writtenBy")}{" "}
                  <a
                    href={authorProfile.url}
                    class="text-blue-600 underline decoration-blue-300 underline-offset-2 transition-colors duration-200 hover:text-blue-700 hover:decoration-blue-500 dark:text-blue-400 dark:decoration-blue-500/60 dark:hover:text-blue-300"
                  >
                    {authorProfile.name}
                  </a>
                </p>
                {authorProfile.bio && (
                  <p class="mt-1 text-sm leading-relaxed text-gray-600 dark:text-gray-400 line-clamp-3">
                    {authorProfile.bio}
                  </p>
                )}
                <a
                  href={authorProfile.url}
                  class="group mt-2 inline-flex items-center gap-1 text-sm font-medium text-blue-600 transition-colors duration-200 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
                >
                  {t(locale, "moreGuidesFrom").replace("{name}", authorProfile.name)}
                  <Icon
                    name="mdi:arrow-right"
                    class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5"
                  />
                </a>
              </div>
            </div>
            <div class="mt-4 border-t border-gray-200 pt-4 dark:border-gray-700">
              <SocialShare
                title={title}
                description={description}
                url={canonicalURL}
                locale={locale}
                variant="inline"
              />
            </div>
          </aside>
        )}

        {!authorProfile && (
          <SocialShare title={title} description={description} url={canonicalURL} locale={locale} />
        )}

        <ServicesPromo locale={locale} />

        <!-- Related Posts (excludes the ones already shown in the sidebar) -->
        <RelatedPosts currentPost={post} preloadedPosts={bottomRelatedPool} />
      </article>

      <!-- Right rail: sticky TOC + related (xl and up) -->
      <PostHeadings headings={headings} currentPost={post} relatedPosts={sidebarRelatedPosts} />
    </div>
  </div>

  <!-- Code block copy buttons -->
  <script>
    (() => {
      const win = window as typeof window & { __bitdozeCodeCopyBooted?: boolean };
      const copyIcon =
        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      const checkIcon =
        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

      async function copyText(text: string): Promise<boolean> {
        if (typeof navigator !== "undefined" && navigator.clipboard?.writeText) {
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch {
            // Fall through to execCommand fallback (permissions / insecure context)
          }
        }

        try {
          const textarea = document.createElement("textarea");
          textarea.value = text;
          textarea.setAttribute("readonly", "");
          textarea.style.position = "fixed";
          textarea.style.top = "0";
          textarea.style.left = "0";
          textarea.style.width = "1px";
          textarea.style.height = "1px";
          textarea.style.padding = "0";
          textarea.style.border = "none";
          textarea.style.outline = "none";
          textarea.style.boxShadow = "none";
          textarea.style.background = "transparent";
          textarea.style.opacity = "0";
          document.body.appendChild(textarea);
          textarea.focus();
          textarea.select();
          textarea.setSelectionRange(0, text.length);
          const legacyCopy = (document as Document & { execCommand?: (command: string) => boolean })
            .execCommand;
          const ok = legacyCopy ? legacyCopy.call(document, "copy") : false;
          document.body.removeChild(textarea);
          return ok;
        } catch {
          return false;
        }
      }

      function setButtonState(btn: HTMLButtonElement, state: "idle" | "copied" | "error") {
        const withLabel = btn.classList.contains("code-copy-btn--header");
        const es = document.documentElement.lang === "es";
        const labels = es
          ? { idle: "Copiar", copied: "Copiado", error: "Error" }
          : { idle: "Copy", copied: "Copied", error: "Failed" };
        const ariaLabels = es
          ? { copied: "Copiado", error: "Error al copiar", idle: "Copiar código" }
          : { copied: "Copied", error: "Copy failed", idle: "Copy code" };
        btn.classList.remove("copied", "copy-error");
        if (state === "copied") btn.classList.add("copied");
        if (state === "error") btn.classList.add("copy-error");
        const icon = state === "copied" ? checkIcon : copyIcon;
        btn.innerHTML = withLabel ? `${icon}<span>${labels[state]}</span>` : icon;
        btn.setAttribute("aria-label", ariaLabels[state]);
      }

      function initCodeCopy() {
        const codeBlocks = document.querySelectorAll(".prose pre");
        codeBlocks.forEach((pre) => {
          if (!(pre instanceof HTMLElement)) return;
          const parent = pre.parentElement;
          if (!parent || parent.classList.contains("code-copy-wrapper")) return;

          const btn = document.createElement("button");
          btn.type = "button";

          const header = parent.matches("figure.code-block")
            ? parent.querySelector(":scope > .code-block-header")
            : null;
          if (header) {
            if (header.querySelector(".code-copy-btn")) return;
            btn.className = "code-copy-btn code-copy-btn--header";
            header.appendChild(btn);
          } else {
            const wrapper = document.createElement("div");
            wrapper.className = "code-copy-wrapper";
            parent.insertBefore(wrapper, pre);
            wrapper.appendChild(pre);
            btn.className = "code-copy-btn";
            wrapper.appendChild(btn);
          }

          setButtonState(btn, "idle");
          btn.addEventListener("click", async (event) => {
            event.preventDefault();
            event.stopPropagation();
            const code = pre.querySelector("code");
            const text = code?.textContent || pre.textContent || "";
            if (!text) {
              setButtonState(btn, "error");
              setTimeout(() => setButtonState(btn, "idle"), 2000);
              return;
            }
            const ok = await copyText(text);
            setButtonState(btn, ok ? "copied" : "error");
            setTimeout(() => setButtonState(btn, "idle"), 2000);
          });
        });
      }

      if (!win.__bitdozeCodeCopyBooted) {
        win.__bitdozeCodeCopyBooted = true;
      }
      initCodeCopy();
    })();
  </script>
  <dialog class="img-lightbox" aria-label={t(locale, "enlargedImage")} data-img-lightbox>
    <button type="button" class="img-lightbox-close" aria-label={t(locale, "close")}>
      <Icon name="mdi:close" class="w-6 h-6" />
    </button>
    <img alt="" />
  </dialog>

  <!-- Image zoom + heading permalinks -->
  <script>
    (() => {
      const win = window as typeof window & { __bitdozePostEnhanceBooted?: boolean };

      function initImageZoom() {
        const dialog = document.querySelector<HTMLDialogElement>("[data-img-lightbox]");
        const body = document.querySelector("[data-post-body]");
        if (!dialog || !body || dialog.dataset.ready) return;
        dialog.dataset.ready = "true";
        const zoomImg = dialog.querySelector("img")!;

        body.querySelectorAll<HTMLImageElement>("p > img").forEach((img) => {
          if (img.closest("a")) return;
          img.dataset.zoomable = "";
          img.tabIndex = 0;
          img.setAttribute("role", "button");
          img.setAttribute("aria-haspopup", "dialog");
        });

        const open = (img: HTMLImageElement) => {
          zoomImg.src = img.currentSrc || img.src;
          zoomImg.alt = img.alt;
          dialog.showModal();
        };

        body.addEventListener("click", (event) => {
          const img = (event.target as Element).closest<HTMLImageElement>("img[data-zoomable]");
          if (img) open(img);
        });
        body.addEventListener("keydown", (event) => {
          const e = event as KeyboardEvent;
          if (e.key !== "Enter" && e.key !== " ") return;
          const img = (e.target as Element).closest<HTMLImageElement>("img[data-zoomable]");
          if (!img) return;
          e.preventDefault();
          open(img);
        });
        // Any click (backdrop, image, close button) dismisses; Esc is handled natively.
        dialog.addEventListener("click", () => dialog.close());
        dialog.addEventListener("close", () => zoomImg.removeAttribute("src"));
      }

      function initHeadingAnchors() {
        document
          .querySelectorAll<HTMLElement>("[data-post-body] > h2[id], [data-post-body] > h3[id]")
          .forEach((heading) => {
            if (heading.querySelector(".heading-anchor")) return;
            const anchor = document.createElement("a");
            anchor.className = "heading-anchor not-prose";
            anchor.href = `#${heading.id}`;
            anchor.textContent = "#";
            // Decorative affordance: hidden from the a11y tree and skipped in tab
            // order, so screen readers announce the heading text only. The same
            // destination is reachable through the TOC links.
            anchor.setAttribute("aria-hidden", "true");
            anchor.setAttribute("tabindex", "-1");
            anchor.dataset.pagefindIgnore = "";
            anchor.addEventListener("click", async (event) => {
              event.preventDefault();
              const url = `${location.origin}${location.pathname}#${heading.id}`;
              history.replaceState(history.state, "", `#${heading.id}`);
              const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
              heading.scrollIntoView({
                behavior: reduceMotion ? "auto" : "smooth",
                block: "start",
              });
              try {
                await navigator.clipboard?.writeText(url);
                anchor.classList.add("copied");
                setTimeout(() => anchor.classList.remove("copied"), 1500);
              } catch {
                // Clipboard blocked; the URL hash is still updated.
              }
            });
            heading.append(anchor);
          });
      }

      function init() {
        initImageZoom();
        initHeadingAnchors();
      }

      if (!win.__bitdozePostEnhanceBooted) {
        win.__bitdozePostEnhanceBooted = true;
      }
      init();
    })();
  </script>
  <style is:global>
    .code-copy-wrapper {
      position: relative;
    }
    .code-copy-wrapper > pre {
      padding-right: 3rem;
    }
    .code-copy-btn {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      padding: 0.375rem;
      background: rgba(0, 0, 0, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 0.375rem;
      color: rgba(255, 255, 255, 0.85);
      cursor: pointer;
      /* Always visible enough on touch; stronger on hover/focus */
      opacity: 0.85;
      transition:
        opacity 0.2s,
        background 0.2s;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    @media (hover: hover) and (pointer: fine) {
      .code-copy-btn {
        opacity: 0;
      }
      .code-copy-wrapper:hover .code-copy-btn,
      .code-copy-btn:focus,
      .code-copy-btn:focus-visible,
      .code-copy-btn.copied {
        opacity: 1;
      }
    }
    .code-copy-btn:hover {
      background: rgba(0, 0, 0, 0.65);
      color: #fff;
    }
    .code-copy-btn.copied {
      color: #4ade80;
      opacity: 1;
    }
    .code-copy-btn.copy-error {
      color: #f87171;
      opacity: 1;
    }
    .code-copy-btn:focus-visible {
      outline: 2px solid #3b82f6;
      outline-offset: 2px;
      opacity: 1;
    }
    .code-copy-btn.code-copy-btn--header {
      position: static;
      gap: 0.375rem;
      padding: 0.25rem 0.5rem;
      background: transparent;
      border-color: transparent;
      color: #9ca3af;
      font-family: var(--font-sans);
      font-size: 0.75rem;
      font-weight: 500;
      line-height: 1;
      text-transform: none;
      letter-spacing: normal;
      opacity: 1;
    }
    .code-copy-btn.code-copy-btn--header svg {
      width: 14px;
      height: 14px;
    }
    .code-copy-btn.code-copy-btn--header:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: #30363d;
      color: #fff;
    }
    .code-copy-btn.code-copy-btn--header.copied {
      color: #4ade80;
    }
    .code-copy-btn.code-copy-btn--header.copy-error {
      color: #f87171;
    }

    /* Heading permalinks: sit in the left gutter so they never reflow the heading */
    [data-post-body] > h2[id],
    [data-post-body] > h3[id] {
      position: relative;
    }
    .heading-anchor {
      position: absolute;
      top: 0;
      left: -1.1em;
      width: 1em;
      color: var(--color-text-muted);
      font-weight: 500;
      text-align: center;
      text-decoration: none;
      opacity: 0;
      transition:
        opacity 0.15s,
        color 0.15s;
    }
    [data-post-body] > h2:not(:first-child) > .heading-anchor {
      top: 1em;
    }
    [data-post-body] > h2:hover > .heading-anchor,
    [data-post-body] > h3:hover > .heading-anchor,
    .heading-anchor:focus-visible,
    .heading-anchor.copied {
      opacity: 1;
    }
    .heading-anchor:hover,
    .heading-anchor.copied {
      color: var(--color-primary-600);
    }
    @media (max-width: 767px), (hover: none) {
      .heading-anchor {
        display: none;
      }
    }

    /* Image lightbox */
    [data-post-body] img[data-zoomable] {
      cursor: zoom-in;
    }
    .img-lightbox {
      max-width: none;
      max-height: none;
      width: 100vw;
      height: 100dvh;
      margin: 0;
      padding: 1rem;
      border: 0;
      background: transparent;
      cursor: zoom-out;
    }
    .img-lightbox[open] {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .img-lightbox::backdrop {
      background: rgba(3, 7, 18, 0.88);
    }
    .img-lightbox img {
      max-width: min(100%, 1600px);
      max-height: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      border-radius: 0.5rem;
      background: #fff;
    }
    .img-lightbox-close {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 9999px;
      background: rgba(17, 24, 39, 0.8);
      color: #f9fafb;
      cursor: pointer;
    }
    .img-lightbox-close:hover {
      background: #1f2937;
    }
  </style>
</Layout>

---
import { Icon } from "astro-icon/components";
import Layout from "@layouts/Layout.astro";
import { formatDate } from "@utils/date";
import ReadingProgress from "@components/blog/ReadingProgress.astro";
import Breadcrumb from "@components/common/Breadcrumb.astro";
import { siteConfig } from "@config/site";
import { getReadingTime } from "@utils/readingTime";
import { getEntrySlug } from "@utils/content";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";

interface Props {
  digest: CollectionEntry<"news">;
  headings?: MarkdownHeading[];
  prev?: CollectionEntry<"news"> | null;
  next?: CollectionEntry<"news"> | null;
}

const { digest, headings = [], prev = null, next = null } = Astro.props;
const { title, description, date } = digest.data;
const digestSlug = getEntrySlug(digest);

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.pathname;

const readingTime = getReadingTime(digest.body || "");

const canonicalAbs = Astro.site
  ? new URL(`/news/${digestSlug}/`, Astro.site).toString()
  : `/news/${digestSlug}/`;

// Section jump chips — h2s only, in document order
const sectionHeadings = headings.filter((h) => h.depth === 2);

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "News", url: "/news/" },
  { name: title, url: canonicalURL },
];
---

<Layout
  title={`${title} - ${siteConfig.name}`}
  description={description}
  article={true}
  noindex={true}
  canonical={canonicalURL}
  lang="en"
  hreflangs={[
    { lang: "en", href: canonicalAbs },
    { lang: "x-default", href: canonicalAbs },
  ]}
  publishDate={date}
  author={{ name: siteConfig.author }}
  breadcrumbs={breadcrumbs}
>
  <ReadingProgress />

  <div class="w-full py-8" style="transition: opacity 0.3s ease;">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <article class="min-w-0" data-pagefind-body data-pagefind-meta="locale:en" data-pagefind-filter="locale:en">
        <Breadcrumb items={breadcrumbs} className="mb-6" />

        <header class="mb-10">
          <p class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-blue-700 dark:bg-blue-950/60 dark:text-blue-300">
            <Icon name="mdi:newspaper-variant-outline" class="h-3.5 w-3.5" />
            Daily Digest
          </p>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold leading-[1.1] tracking-tight text-balance text-gray-900 dark:text-white">
            {title}
          </h1>

          {
            description && (
              <div class="mt-6 rounded-xl border border-blue-100 bg-blue-50/60 px-5 py-4 dark:border-blue-900/60 dark:bg-blue-950/30">
                <p class="text-lg leading-relaxed text-pretty text-gray-700 dark:text-gray-200">
                  {description}
                </p>
              </div>
            )
          }

          <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-gray-500 dark:text-gray-400">
            <span class="inline-flex items-center gap-1.5">
              <Icon name="mdi:calendar" class="h-4 w-4" />
              <time datetime={date.toISOString()}>{formatDate(date, "en")}</time>
            </span>
            <span class="inline-flex items-center gap-1.5">
              <Icon name="mdi:clock-outline" class="h-4 w-4" />
              {readingTime.minutes > 0 ? readingTime.minutes : 1} min read
            </span>
          </div>

          {
            sectionHeadings.length > 1 && (
              <nav class="mt-6 flex flex-wrap items-center gap-2" aria-label="Jump to section">
                <span class="text-xs font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500">
                  Jump to
                </span>
                {sectionHeadings.map((h) => (
                  <a href={`#${h.slug}`} class="digest-jump-chip">
                    {h.text.replace(/^\d+\.\s*/, "")}
                  </a>
                ))}
              </nav>
            )
          }
        </header>

        <div
          class="digest-body prose prose-lg dark:prose-invert prose-blue prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400 w-full max-w-none!"
          style="min-height: 200px;"
        >
          <slot />
        </div>

        <!-- Prev / next digest navigation -->
        {
          (prev || next) && (
            <nav
              class="not-prose mt-10 grid gap-3 border-t border-gray-200 pt-6 dark:border-gray-700 sm:grid-cols-2"
              aria-label="Digest navigation"
            >
              {prev ? (
                <a
                  href={`/news/${getEntrySlug(prev)}/`}
                  class="group rounded-lg border border-gray-200 bg-gray-50 p-4 transition-colors duration-200 hover:border-blue-300 hover:bg-blue-50 dark:border-gray-700 dark:bg-gray-800/50 dark:hover:border-blue-800 dark:hover:bg-blue-950/30"
                >
                  <span class="flex items-center gap-1 text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">
                    <Icon name="mdi:arrow-left" class="h-3.5 w-3.5" />
                    Previous digest
                  </span>
                  <span class="mt-1 block text-sm font-semibold text-gray-900 group-hover:text-blue-700 dark:text-gray-100 dark:group-hover:text-blue-300">
                    {prev.data.title}
                  </span>
                </a>
              ) : (
                <span />
              )}
              {next ? (
                <a
                  href={`/news/${getEntrySlug(next)}/`}
                  class="group rounded-lg border border-gray-200 bg-gray-50 p-4 text-right transition-colors duration-200 hover:border-blue-300 hover:bg-blue-50 dark:border-gray-700 dark:bg-gray-800/50 dark:hover:border-blue-800 dark:hover:bg-blue-950/30"
                >
                  <span class="flex items-center justify-end gap-1 text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">
                    Next digest
                    <Icon name="mdi:arrow-right" class="h-3.5 w-3.5" />
                  </span>
                  <span class="mt-1 block text-sm font-semibold text-gray-900 group-hover:text-blue-700 dark:text-gray-100 dark:group-hover:text-blue-300">
                    {next.data.title}
                  </span>
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }

        <div class="not-prose mt-8">
          <a
            href="/news/"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
          >
            <Icon name="mdi:arrow-left" class="h-4 w-4" />
            All news digests
          </a>
        </div>
      </article>
    </div>
  </div>
</Layout>

<style is:global>
  /* Digest body — every item in a digest is list-shaped content, so panels
     apply to all li elements inside .digest-body. Tokens per DESIGN.md:
     paper-muted panels, console-muted dark twin, flat at rest, blue wash on
     hover (lift-on-intent), no borders. */

  .digest-jump-chip {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    background: #dbeafe;
    color: #1d4ed8;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
    padding: 0.25rem 0.625rem;
    transition: background-color 200ms ease-in-out, color 200ms ease-in-out;
  }

  .digest-jump-chip:hover {
    background: #bfdbfe;
  }

  .dark .digest-jump-chip {
    background: rgba(30, 58, 138, 0.45);
    color: #93c5fd;
  }

  .dark .digest-jump-chip:hover {
    background: rgba(30, 58, 138, 0.7);
  }

  /* Section rhythm: hairline separator + air above each section, none on the first */
  .digest-body h2 {
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid #e5e7eb;
  }

  .digest-body h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .dark .digest-body h2 {
    border-top-color: #374151;
  }

  /* Item text: the lead <strong> and its summary share one paragraph (soft
     break), so only the leading strong gets headline weight — the rest of
     the paragraph stays normal muted body text. */
  .digest-body ul > li > p,
  .digest-body ol > li > p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #4b5563;
    margin: 0;
  }

  .digest-body ul > li > p + p,
  .digest-body ol > li > p + p {
    margin-top: 0.5rem;
  }

  .dark .digest-body ul > li > p,
  .dark .digest-body ol > li > p {
    color: #9ca3af;
  }

  .digest-body ul > li > p:first-child > strong:first-child,
  .digest-body ol > li > p:first-child > strong:first-child {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5;
    color: #111827;
  }

  .dark .digest-body ul > li > p:first-child > strong:first-child,
  .dark .digest-body ol > li > p:first-child > strong:first-child {
    color: #f9fafb;
  }

  .digest-body ul > li:hover,
  .digest-body ol > li:hover {
    background: #eff6ff;
  }

  .dark .digest-body ul > li,
  .dark .digest-body ol > li {
    background: #1f2937;
  }

  .dark .digest-body ul > li:hover,
  .dark .digest-body ol > li:hover {
    background: rgba(59, 130, 246, 0.12);
  }


  /* Numbered lists (HN section): mono number chip instead of plain marker */
  .digest-body ol {
    counter-reset: digest-ol;
  }

  .digest-body ol > li {
    counter-increment: digest-ol;
    padding-left: 3.5rem;
  }

  .digest-body ol > li::before {
    content: counter(digest-ol);
    position: absolute;
    left: 1rem;
    top: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    background: #dbeafe;
    color: #1d4ed8;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      "Liberation Mono", "Courier New", monospace;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .dark .digest-body ol > li::before {
    background: rgba(30, 58, 138, 0.45);
    color: #93c5fd;
  }

  /* Trailing italic asides ("Also tracked: …") — quiet, small, no chrome */
  .digest-body > p:has(> em:only-child) {
    font-size: 0.85rem;
    line-height: 1.65;
    color: #6b7280;
    margin-top: 1rem;
  }

  .dark .digest-body > p:has(> em:only-child) {
    color: #9ca3af;
  }

  /* Tables (trending repos): header on paper-subtle, zebra on paper-muted,
     stars column in mono, scrollable when narrow */
  .digest-body .digest-table-wrap {
    overflow-x: auto;
    margin: 1.25rem 0;
  }

  .digest-body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .digest-body th {
    background: #f3f4f6;
    color: #111827;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-align: left;
    padding: 0.5rem 0.75rem;
    white-space: nowrap;
  }

  .dark .digest-body th {
    background: #374151;
    color: #f9fafb;
  }

  .digest-body td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid #e5e7eb;
    color: #374151;
    vertical-align: top;
  }

  .dark .digest-body td {
    border-bottom-color: #374151;
    color: #d1d5db;
  }

  .digest-body tbody tr:nth-child(even) {
    background: #f9fafb;
  }

  .dark .digest-body tbody tr:nth-child(even) {
    background: rgba(17, 24, 39, 0.4);
  }

  .digest-body td:nth-child(1) {
    color: #6b7280;
    font-weight: 500;
  }

  /* Stars column in mono */
  .digest-body td:nth-child(3) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      "Liberation Mono", "Courier New", monospace;
    font-size: 0.8125rem;
    white-space: nowrap;
  }
</style>

---
import { Icon } from "astro-icon/components";
import { formatDate } from "@utils/date";
import { getEntrySlug } from "@utils/content";
import type { CollectionEntry } from "astro:content";

interface Props {
  digest: CollectionEntry<"news">;
  featured?: boolean;
}

const { digest, featured = false } = Astro.props;
const { title, description, date } = digest.data;
const slug = getEntrySlug(digest);
const href = `/news/${slug}/`;
---

<article
  class:list={[
    "group flex h-full flex-col rounded-lg bg-white p-5 shadow-[0_4px_6px_rgba(0,0,0,0.07)] transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_10px_15px_rgba(0,0,0,0.08)] dark:bg-gray-800 dark:shadow-[0_4px_6px_rgba(0,0,0,0.3)] dark:hover:shadow-[0_10px_15px_rgba(0,0,0,0.4)]",
    featured && "md:col-span-2 lg:col-span-2 md:p-7",
  ]}
>
  <div class="mb-2 flex flex-wrap items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
    {featured && <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-300">Latest</span>}
    <span class="inline-flex items-center gap-1.5">
      <Icon name="mdi:calendar" class="h-4 w-4" />
      <time datetime={date.toISOString()}>{formatDate(date, "en")}</time>
    </span>
  </div>

  <h2 class:list={["leading-snug tracking-tight", featured ? "text-2xl font-bold" : "text-lg font-bold"]}>
    <a
      href={href}
      class="text-gray-900 transition-colors duration-200 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400"
    >
      {title}
    </a>
  </h2>

  <p class:list={["mt-2 flex-1 leading-relaxed text-gray-600 dark:text-gray-300", featured ? "text-base" : "text-sm"]}>
    {description}
  </p>

  <a
    href={href}
    class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-blue-600 transition-colors duration-200 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
  >
    Read digest
    <Icon
      name="mdi:arrow-right"
      class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
    />
  </a>
</article>

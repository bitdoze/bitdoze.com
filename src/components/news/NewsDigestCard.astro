---
import { Icon } from "astro-icon/components";
import { formatDate } from "@utils/date";
import { getEntrySlug } from "@utils/content";
import type { CollectionEntry } from "astro:content";

interface Props {
  digest: CollectionEntry<"news">;
  featured?: boolean;
}

const { digest, featured = false } = Astro.props;
const { title, description, date } = digest.data;
const slug = getEntrySlug(digest);
const href = `/news/${slug}/`;
---

<article
  class:list={[
    "group flex h-full flex-col rounded-lg border border-(--color-border-base) bg-white p-5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md dark:bg-gray-800",
    featured && "md:col-span-2 lg:col-span-2 md:p-7",
  ]}
>
  <div class="mb-2 flex flex-wrap items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
    {featured && (
      <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-300">
        Latest
      </span>
    )}
    {/* Date as a mono chip — every digest title is identical, so the
        description carries the headline instead (opus-55 §5.7). */}
    <time
      datetime={date.toISOString()}
      class="rounded-md bg-gray-100 px-2 py-0.5 font-mono text-xs text-gray-600 dark:bg-gray-700 dark:text-gray-300"
    >
      {formatDate(date, "en")}
    </time>
  </div>

  <h2
    class:list={[
      "leading-snug tracking-tight",
      featured ? "text-2xl font-bold" : "text-lg font-bold",
    ]}
  >
    <a
      href={href}
      class="text-gray-900 transition-colors duration-200 group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400"
    >
      {description}
    </a>
  </h2>

  <p class="mt-2 flex-1 text-sm leading-relaxed text-gray-500 dark:text-gray-400">{title}</p>

  <a
    href={href}
    class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-blue-600 transition-colors duration-200 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
    aria-label={`Read digest: ${title}`}
  >
    Read digest
    <Icon
      name="mdi:arrow-right"
      class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
    />
  </a>
</article>

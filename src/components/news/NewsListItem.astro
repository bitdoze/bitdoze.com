---
// Overrides the li element for news digests. Digest items are flat list items
// with a fixed shape (see AGENTS.md "Item line format"):
//
//   <strong>Title (date)</strong>[(HN meta)] — <a>source</a> [| <a>source</a>]* [(meta)]
//   summary text on the next line (a literal \n in the rendered HTML)
//
// Reddit items keep the summary inline after the last link: "— <a>Thread</a> — summary".
// This component splits the loose text into title / meta / source chips / summary
// so each part can be styled — the MDX itself stays untouched.
const raw = await Astro.slots.render("default");

// Loose lists (blank lines between items) wrap item content in <p> — unwrap
// and turn inner paragraph boundaries into line breaks so both tight and
// loose digests parse identically.
const inner = raw
  .trim()
  .replace(/<\/p>\s*<p[^>]*>/g, "\n")
  .replace(/^<p[^>]*>/, "")
  .replace(/<\/p>\s*$/, "");

let title = "";
let meta = "";
let sourcesHtml = "";
let summaryHtml = "";

const cleanText = (s: string) =>
  s
    .replace(/<[^>]+>/g, " ")
    .replace(/\|/g, " ")
    .replace(/^[\s—–-]+|[\s—–-]+$/g, "")
    .replace(/\s+/g, " ")
    .trim();

// Head = first line (title + sources), summary = following lines.
const nl = inner.indexOf("\n");
const head = (nl === -1 ? inner : inner.slice(0, nl)).trim();
let summary = (nl === -1 ? "" : inner.slice(nl + 1)).trim();

// Title is the leading <strong>…</strong>. A "*arr"-style literal inside the
// bold breaks it into <em> instead (markdown quirk) — accept a leading <em>
// followed by " — " as the title too.
const titleMatch =
  head.match(/^\s*<strong>([\s\S]*?)<\/strong>/) ??
  head.match(/^\s*\*?\s*<em>([\s\S]*)<\/em>(?=\s*—)/);
if (titleMatch) {
  title = titleMatch[1];
  const rest = head.slice(titleMatch[0].length);

  // Anchors become source chips; surrounding text is meta or an inline summary.
  const anchorRe = /<a\b[^>]*>[\s\S]*?<\/a>/g;
  const anchorMatches = [...rest.matchAll(anchorRe)];
  sourcesHtml = anchorMatches
    .map((m) => m[0].replace(/^<a\b/, '<a class="digest-source-chip"'))
    .join("");

  const metaParts: string[] = [];
  if (anchorMatches.length > 0) {
    const first = anchorMatches[0];
    const last = anchorMatches[anchorMatches.length - 1];
    const leading = cleanText(rest.slice(0, first.index));
    const trailing = cleanText(rest.slice(last.index! + last[0].length));
    if (leading) metaParts.push(leading);
    if (trailing) {
      // "(759 points)" is meta; anything else is an inline summary tail (Reddit style).
      if (/^\([^)]*\)$/.test(trailing)) metaParts.push(trailing);
      else summary = [trailing, summary].filter(Boolean).join(" ");
    }
  } else {
    // No links at all — remaining head text is the summary.
    const leftover = cleanText(rest);
    if (leftover) summary = [leftover, summary].filter(Boolean).join(" ");
  }
  meta = metaParts.join(" · ");

  summary = summary.replace(
    /Why it matters:/,
    '<strong class="digest-wim">$&</strong>'
  );
  summaryHtml = summary;
} else {
  // Non-standard item — keep the raw markup untouched.
  summaryHtml = inner.trim();
}
---

<li class="digest-item">
  <div class="digest-item-body">
    {
      title ? (
        <p class="digest-item-title">
          <strong set:html={title} />
          {meta && <span class="digest-item-meta">{meta}</span>}
        </p>
      ) : null
    }
    {sourcesHtml && <p class="digest-item-sources" set:html={sourcesHtml} />}
    {summaryHtml && <p class="digest-item-summary" set:html={summaryHtml} />}
  </div>
</li>

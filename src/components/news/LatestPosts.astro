---
// "Latest from the blog" strip for news pages — newest EN posts with cover
// images, in the same card language as RelatedPosts.
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { formatDate } from "@utils/date";
import { getEntryHref } from "@utils/content";
import { getRecentPosts } from "@utils/recentPosts";
import { formatTaxonomyLabel } from "@utils/labels";

interface Props {
  limit?: number;
  heading?: string;
}

const { limit = 3, heading = "Latest from the blog" } = Astro.props;
const posts = await getRecentPosts("en", limit);
---

{
  posts.length > 0 && (
    <section class="latest-posts mt-12 border-t border-gray-200 pt-8 dark:border-gray-700">
      <div class="mb-6 flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">{heading}</h2>
        <a
          href="/blog/"
          class="inline-flex shrink-0 items-center gap-1 text-sm font-medium text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
        >
          All guides
          <Icon name="mdi:arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
        {posts.map((post) => {
          const href = getEntryHref(post);
          const category = post.data.categories?.[0];

          return (
            <article class="latest-post-card group">
              <a href={href} class="block">
                {post.data.image && (
                  <div class="mb-3 aspect-video overflow-hidden rounded-lg">
                    <Image
                      src={post.data.image}
                      alt={post.data.title}
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                      width={400}
                      height={225}
                      widths={[320, 400]}
                      loading="lazy"
                    />
                  </div>
                )}

                {category && (
                  <span class="mb-2 inline-block rounded-full bg-blue-100 px-2 py-1 text-xs font-medium text-blue-700 dark:bg-blue-900 dark:text-blue-300">
                    {formatTaxonomyLabel(category)}
                  </span>
                )}

                <h3 class="line-clamp-3 text-lg font-bold text-gray-900 transition-colors group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400">
                  {post.data.title}
                </h3>

                {post.data.date && (
                  <time
                    datetime={post.data.date.toISOString()}
                    class="mt-2 block text-sm text-gray-500 dark:text-gray-400"
                  >
                    {formatDate(post.data.date, "en")}
                  </time>
                )}
              </a>
            </article>
          );
        })}
      </div>
    </section>
  )
}

---
// Overrides the h2 element for news digests. Digest section headings follow the
// fixed pattern "N. Title (Qualifier)" — render the number as a mono chip and
// the qualifier as a neutral badge, per DESIGN.md label/chip specs.
interface Props {
  id?: string;
}

const { id } = Astro.props;
const raw = await Astro.slots.render("default");
// Slot content is HTML — decode entities so "&" doesn't render as "&amp;"
const text = raw
  .replace(/<[^>]+>/g, "")
  .replace(/&amp;/g, "&")
  .replace(/&lt;/g, "<")
  .replace(/&gt;/g, ">")
  .replace(/&quot;/g, '"')
  .replace(/&#39;/g, "'")
  .trim();
const match = text.match(/^(\d+)\.\s*(.+?)(?:\s*\(([^)]+)\))?$/);
const number = match?.[1];
const label = match?.[2] ?? text;
const qualifier = match?.[3];
---

<h2 id={id} class="digest-section-heading">
  {
    number && (
      <span class="digest-section-number" aria-hidden="true">
        {number}
      </span>
    )
  }
  <span class="digest-section-title">{label}</span>
  {qualifier && <span class="digest-section-badge">{qualifier}</span>}
</h2>

<style is:global>
  .digest-section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    scroll-margin-top: 5.5rem;
  }

  .digest-section-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.75rem;
    height: 1.75rem;
    padding: 0 0.375rem;
    border-radius: 9999px;
    background: #dbeafe;
    color: #1d4ed8;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      "Liberation Mono", "Courier New", monospace;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
  }

  .dark .digest-section-number {
    background: rgba(30, 58, 138, 0.45);
    color: #93c5fd;
  }

  .digest-section-title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: #111827;
  }

  .dark .digest-section-title {
    color: #f9fafb;
  }

  .digest-section-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    background: #f3f4f6;
    color: #6b7280;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
    padding: 0.125rem 0.5rem;
  }

  .dark .digest-section-badge {
    background: #374151;
    color: #d1d5db;
  }
</style>

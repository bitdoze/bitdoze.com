---
// Overrides the h2 element for news digests. Digest section headings follow the
// fixed pattern "N. Title (Qualifier)" — render a section icon chip and the
// qualifier as a neutral badge, per DESIGN.md label/chip specs. Icons key off
// the fixed section order in AGENTS.md, with a keyword fallback so renamed
// sections still get a sensible icon.
import { Icon } from "astro-icon/components";

interface Props {
  id?: string;
}

const { id } = Astro.props;
const raw = await Astro.slots.render("default");
// Slot content is HTML — decode entities so "&" doesn't render as "&amp;"
const text = raw
  .replace(/<[^>]+>/g, "")
  .replace(/&amp;/g, "&")
  .replace(/&lt;/g, "<")
  .replace(/&gt;/g, ">")
  .replace(/&quot;/g, '"')
  .replace(/&#39;/g, "'")
  .trim();
const match = text.match(/^(\d+)\.\s*(.+?)(?:\s*\(([^)]+)\))?$/);
const number = match?.[1];
const label = match?.[2] ?? text;
const qualifier = match?.[3];

// Fixed digest order: 1 AI, 2 Dev/DevOps, 3 Self-hosting, 4 GitHub, 5 HN, 6 Reddit
const ICON_BY_NUMBER: Record<string, string> = {
  "1": "mdi:brain",
  "2": "mdi:code-tags",
  "3": "mdi:server-network-outline",
  "4": "mdi:github",
  "5": "mdi:y-combinator",
  "6": "mdi:reddit",
};
const ICON_BY_KEYWORD: [RegExp, string][] = [
  [/\b(ai|llm|models?)\b/i, "mdi:brain"],
  [/dev(ops)?|infra|secur/i, "mdi:code-tags"],
  [/self.?host|homelab|home lab/i, "mdi:server-network-outline"],
  [/github|repositories|trending/i, "mdi:github"],
  [/hacker news|\bhn\b/i, "mdi:y-combinator"],
  [/reddit/i, "mdi:reddit"],
];
const icon =
  (number && ICON_BY_NUMBER[number]) ??
  ICON_BY_KEYWORD.find(([re]) => re.test(label))?.[1];
---

<h2 id={id} class="digest-section-heading">
  {
    icon ? (
      <span class="digest-section-icon" aria-hidden="true">
        <Icon name={icon} class="h-4.5 w-4.5" />
      </span>
    ) : (
      number && (
        <span class="digest-section-number" aria-hidden="true">
          {number}
        </span>
      )
    )
  }
  <span class="digest-section-title">{label}</span>
  {qualifier && <span class="digest-section-badge">{qualifier}</span>}
</h2>

<style is:global>
  .digest-section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    scroll-margin-top: 5.5rem;
  }

  .digest-section-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: 0.5rem;
    background: #dbeafe;
    color: #1d4ed8;
    flex-shrink: 0;
  }

  .digest-section-icon svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .dark .digest-section-icon {
    background: rgba(30, 58, 138, 0.45);
    color: #93c5fd;
  }

  .digest-section-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.75rem;
    height: 1.75rem;
    padding: 0 0.375rem;
    border-radius: 9999px;
    background: #dbeafe;
    color: #1d4ed8;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New",
      monospace;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
  }

  .dark .digest-section-number {
    background: rgba(30, 58, 138, 0.45);
    color: #93c5fd;
  }

  .digest-section-title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: #111827;
  }

  .dark .digest-section-title {
    color: #f9fafb;
  }

  .digest-section-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    background: #f3f4f6;
    color: #6b7280;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
    padding: 0.125rem 0.5rem;
  }

  .dark .digest-section-badge {
    background: #374151;
    color: #d1d5db;
  }
</style>

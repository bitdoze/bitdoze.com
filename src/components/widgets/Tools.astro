---
import { Icon } from "astro-icon/components";
import { getLocaleFromPathname } from "@utils/i18n";

const locale = getLocaleFromPathname(Astro.url.pathname);

const copy = {
  en: {
    heading: "Free AI tools",
    sub: "For creators — titles, thumbnails, scripts, and social posts",
    t1: "Title Generator",
    d1: "Create engaging, platform-specific titles for your content using AI.",
    t2: "Thumbnail Ideas",
    d2: "Generate eye-catching YouTube thumbnail concepts with AI assistance.",
    t3: "YouTube Script Generator",
    d3: "Craft compelling YouTube video scripts with AI-powered suggestions.",
    t4: "Social Media Post Generator",
    d4: "Generate structured Social Media Posts with AI assistance.",
  },
  es: {
    heading: "Herramientas IA gratis",
    sub: "Para creadores: títulos, miniaturas, guiones y publicaciones sociales",
    t1: "Generador de Títulos",
    d1: "Crea títulos atractivos para tu contenido usando IA.",
    t2: "Ideas de Miniaturas",
    d2: "Genera conceptos llamativos de miniaturas para YouTube con IA.",
    t3: "Generador de Guiones",
    d3: "Crea guiones para videos de YouTube con sugerencias de IA.",
    t4: "Generador de Posts",
    d4: "Genera publicaciones estructuradas para redes sociales con IA.",
  },
  de: {
    heading: "Kostenlose KI-Tools",
    sub: "Für Creator — Titel, Thumbnails, Skripte und Social Posts",
    t1: "Titel-Generator",
    d1: "Erstelle ansprechende, plattformspezifische Titel für deinen Content mit KI.",
    t2: "Thumbnail-Ideen",
    d2: "Generiere auffällige YouTube-Thumbnail-Konzepte mit KI-Unterstützung.",
    t3: "YouTube-Skript-Generator",
    d3: "Erstelle überzeugende YouTube-Videoskripte mit KI-Vorschlägen.",
    t4: "Social-Post-Generator",
    d4: "Generiere strukturierte Social-Media-Posts mit KI-Unterstützung.",
  },
}[locale];

const tools = [
  {
    title: copy.t1,
    description: copy.d1,
    url: "https://bitbuddies.me/tools/title-generator",
    icon: "mdi:format-title",
  },
  {
    title: copy.t2,
    description: copy.d2,
    url: "https://bitbuddies.me/tools/youtube-thumbnail-generator",
    icon: "mdi:image-outline",
  },
  {
    title: copy.t3,
    description: copy.d3,
    url: "https://bitbuddies.me/tools/youtube-script-generator",
    icon: "mdi:script-text-outline",
  },
  {
    title: copy.t4,
    description: copy.d4,
    url: "https://bitbuddies.me/tools/social-post-generator",
    icon: "mdi:chart-line",
  },
];
const slugify = (value: string) =>
  value
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)+/g, "");
---

<section class="py-14">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="flex items-end justify-between gap-4 mb-8 border-b border-gray-200 dark:border-gray-700 pb-4">
      <div>
        <h2
          class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-white"
          style="view-transition-name: home-tools-heading"
        >
          {copy.heading}
        </h2>
        <p
          class="mt-1 text-sm text-gray-500 dark:text-gray-400"
          style="view-transition-name: home-tools-description"
        >
          {copy.sub}
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {tools.map((tool) => (
        <a
          href={tool.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative rounded-lg border border-gray-200 bg-white p-4 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md dark:border-gray-700 dark:bg-gray-800"
          style={`view-transition-name: home-tool-card-${slugify(tool.title)}`}
        >
          <div class="flex items-center gap-2.5 mb-2">
            <div class="rounded-md bg-blue-50 p-2 transition-colors duration-200 group-hover:bg-blue-100 dark:bg-blue-900/30 dark:group-hover:bg-blue-800/40">
              <Icon name={tool.icon} class="w-4 h-4 text-blue-600 dark:text-blue-400" />
            </div>
            <h3 class="text-sm font-semibold text-gray-900 dark:text-white">{tool.title}</h3>
            <Icon
              name="mdi:open-in-new"
              class="ml-auto w-3.5 h-3.5 shrink-0 text-gray-300 transition-colors duration-200 group-hover:text-blue-500 dark:text-gray-600 dark:group-hover:text-blue-400"
            />
          </div>
          <p class="text-xs leading-relaxed text-gray-600 dark:text-gray-300 line-clamp-2">
            {tool.description}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>

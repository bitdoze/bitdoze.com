---
import { Icon } from "astro-icon/components";
export interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const isEs = locale === "es";
---

<section class="relative overflow-hidden" style="view-transition-name: home-hero-section">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="py-8 md:py-16 lg:py-20 grid lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] gap-12 lg:gap-10 items-center">
      <!-- Copy -->
      <div class="max-w-xl">
        <h1
          class="text-4xl sm:text-5xl font-bold leading-[1.08] tracking-[-0.02em] text-balance text-gray-900 dark:text-white"
          style="view-transition-name: home-hero-heading"
        >
          {isEs ? (
            <>
              Guías de DevOps que{" "}
              <span class="text-blue-600 dark:text-blue-400">realmente funcionan</span>
            </>
          ) : (
            <>
              DevOps guides that <span class="text-blue-600 dark:text-blue-400">actually work</span>
            </>
          )}
        </h1>

        <p
          class="mt-5 hidden sm:block text-lg sm:text-xl leading-relaxed text-pretty text-gray-600 dark:text-gray-300"
          style="view-transition-name: home-hero-description"
        >
          {isEs
            ? "Tutoriales prácticos sobre Docker, VPS, CI/CD y herramientas autoalojadas: probados de principio a fin, listos para copiar y pegar."
            : "Hands-on tutorials on Docker, VPS, CI/CD, and self-hosted tools — tested end to end, copy-paste ready, written by practitioners for practitioners."}
        </p>

        <!-- Proof row — desktop only; on mobile the first guide cards must peek above the fold -->
        <ul class="mt-6 hidden sm:flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-500 dark:text-gray-400">
          <li class="inline-flex items-center gap-1.5">
            <Icon
              name="mdi:check-circle-outline"
              class="w-4 h-4 text-blue-600 dark:text-blue-400"
            />
            {isEs ? "400+ guías probadas de principio a fin" : "400+ guides tested end to end"}
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Icon name="mdi:update" class="w-4 h-4 text-blue-600 dark:text-blue-400" />
            {isEs ? "Actualizado con las últimas versiones" : "Kept current with new releases"}
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Icon
              name="mdi:account-hard-hat-outline"
              class="w-4 h-4 text-blue-600 dark:text-blue-400"
            />
            {isEs ? "10+ años de experiencia en TI" : "10+ years hands-on in IT"}
          </li>
        </ul>

        <!-- CTAs: one primary (PRODUCT #5 — single next step), secondary demoted to quiet text link -->
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a
            href={isEs ? "/es/blog/" : "/blog/"}
            class="group inline-flex items-center gap-2 rounded-lg bg-blue-600 px-6 py-3 text-base font-semibold text-white shadow-sm transition-colors duration-200 hover:bg-blue-700"
            style="view-transition-name: home-hero-cta"
          >
            {isEs ? "Explorar las guías" : "Browse the guides"}
            <Icon
              name="mdi:arrow-right"
              class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-0.5"
            />
          </a>
          <a
            href={isEs ? "/es/resources/" : "/resources/"}
            class="group inline-flex items-center gap-1.5 text-sm font-medium text-(--color-text-muted) transition-colors duration-200 hover:text-blue-600 dark:hover:text-blue-400"
          >
            {isEs ? "Herramientas y créditos gratis" : "Free tools & credits"}
            <Icon
              name="mdi:arrow-right"
              class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
            />
          </a>
        </div>

        <!-- Mobile search — the hero's job on small screens is routing, not pitching -->
        <form
          action={isEs ? "/es/search/" : "/search/"}
          method="get"
          role="search"
          class="mt-6 sm:hidden"
        >
          <label class="relative block">
            <span class="sr-only">{isEs ? "Buscar guías" : "Search guides"}</span>
            <Icon
              name="mdi:magnify"
              class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400"
            />
            <input
              name="q"
              type="search"
              placeholder={isEs ? "Buscar guías…" : "Search guides…"}
              autocomplete="off"
              class="w-full rounded-lg border border-(--color-border-base) bg-(--color-bg-muted) py-2.5 pl-9 pr-3 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
            />
          </label>
        </form>
      </div>

      <!-- Terminal: the brand promise, visualized — hidden below lg so mobile
           reaches the guide cards on the first screen -->
      <div class="hidden lg:block lg:justify-self-end w-full max-w-lg" aria-hidden="true">
        <div class="rounded-xl border border-[#374151] bg-[#111827] shadow-lg overflow-hidden">
          <!-- Title bar -->
          <div class="flex items-center gap-2 border-b border-[#1f2937] bg-[#0b1220] px-4 py-3">
            <span class="h-3 w-3 rounded-full bg-[#ef4444]/80"></span>
            <span class="h-3 w-3 rounded-full bg-[#eab308]/80"></span>
            <span class="h-3 w-3 rounded-full bg-[#22c55e]/80"></span>
            <span class="ml-3 font-mono text-xs text-[#9ca3af] select-none">dragos@vps: ~</span>
            <span class="ml-auto inline-flex items-center gap-1 rounded-full border border-[#22c55e]/30 bg-[#22c55e]/10 px-2 py-0.5 font-mono text-[10px] font-medium text-[#4ade80]">
              <span class="h-1.5 w-1.5 rounded-full bg-[#22c55e]"></span>
              deployed
            </span>
          </div>
          <!-- Session -->
          <div class="px-4 sm:px-5 py-4 font-mono text-[13px] leading-[1.75] overflow-x-auto">
            <p class="whitespace-pre">
              <span class="text-[#60a5fa]">dragos@vps</span>
              <span class="text-[#9ca3af]">:</span>
              <span class="text-[#93c5fd]">~</span>
              <span class="text-[#9ca3af]">$</span>
              <span class="text-[#f9fafb]">docker compose up -d</span>
            </p>
            <p class="whitespace-pre text-[#d1d5db]">
              <span class="text-[#9ca3af]">[+] Running 3/3</span>
            </p>
            <p class="whitespace-pre text-[#d1d5db]">
              <span class="text-[#22c55e]"> ✔</span> Network{" "}
              <span class="text-[#9ca3af]">bitdoze_default</span>{" "}
              <span class="text-[#22c55e]">Created</span>
            </p>
            <p class="whitespace-pre text-[#d1d5db]">
              <span class="text-[#22c55e]"> ✔</span> Container{" "}
              <span class="text-[#9ca3af]">bitdoze-db-1</span>{" "}
              <span class="text-[#22c55e]">Started</span>
            </p>
            <p class="whitespace-pre text-[#d1d5db]">
              <span class="text-[#22c55e]"> ✔</span> Container{" "}
              <span class="text-[#9ca3af]">bitdoze-web-1</span>{" "}
              <span class="text-[#22c55e]">Started</span>
            </p>
            <p class="whitespace-pre pt-1">
              <span class="text-[#60a5fa]">dragos@vps</span>
              <span class="text-[#9ca3af]">:</span>
              <span class="text-[#93c5fd]">~</span>
              <span class="text-[#9ca3af]">$</span>
              <span class="text-[#f9fafb]">curl -I localhost:3000</span>
            </p>
            <p class="whitespace-pre text-[#d1d5db]">
              HTTP/1.1 <span class="text-[#22c55e] font-semibold">200 OK</span>
            </p>
            <p class="whitespace-pre pt-1">
              <span class="text-[#60a5fa]">dragos@vps</span>
              <span class="text-[#9ca3af]">:</span>
              <span class="text-[#93c5fd]">~</span>
              <span class="text-[#9ca3af]">$</span>
              <span class="hero-caret inline-block h-[1.1em] w-[0.55em] translate-y-[0.2em] bg-[#d1d5db]"></span>
            </p>
          </div>
        </div>
        <p class="mt-3 text-center font-mono text-xs text-gray-500 dark:text-gray-400">
          {isEs ? "cada guía termina aquí: funciona" : "every guide ends here: it runs"}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-caret {
    /* Blink a few times, then rest solid — ambient motion off (DESIGN.md). */
    animation: hero-caret-blink 1.1s step-end 8;
  }
  @keyframes hero-caret-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-caret {
      animation: none;
    }
  }
</style>

---
import { getLocaleFromPathname } from "@utils/i18n";
import { localizeInternalPath } from "@utils/localeRoutes";
import { t } from "@i18n/ui";

export interface Props {
  productName: string;
  productDescription: string;
  productFeatures: string[];
  productLink: string;
  productImage: string;
  productRating: number; // Rating out of 5
  importantConsiderations?: string[];
  pros?: string[];
  cons?: string[];
  recommendedBadge?: string; // Optional badge (e.g., "Best Budget", "Best Overall", "Editor's Choice", "Best for Professionals")
}

const {
  productName,
  productDescription,
  productFeatures,
  productLink,
  productImage,
  productRating,
  importantConsiderations,
  pros,
  cons,
  recommendedBadge,
} = Astro.props;

// Internal redirects (/go/... and go.bitdoze.com/...) already carry the site's
// affiliate tag on their target; only external Amazon links need one appended.
const isInternalLink = (() => {
  if (productLink.startsWith("/")) return true;
  try {
    return new URL(productLink).hostname === "go.bitdoze.com";
  } catch {
    return false;
  }
})();
const affiliateLink = isInternalLink
  ? productLink
  : productLink.includes("?")
    ? `${productLink}&tag=bido08-20`
    : `${productLink}?tag=bido08-20`;

const locale = getLocaleFromPathname(Astro.url.pathname);

// Generate star rating display - simplified
const ratingPercent = (productRating / 5) * 100;
const ratingWord =
  productRating >= 4.5
    ? t(locale, "ratingExcellent")
    : productRating >= 4
      ? t(locale, "ratingVeryGood")
      : productRating >= 3.5
        ? t(locale, "ratingGood")
        : t(locale, "ratingMixed");

// Badge: one blue chip for every recommendation kind (The One Voice Rule).
// Affiliate recommendations are practitioner advice, not confetti.

// Feature/pro/con icons repeat ~14x per card. Emit the <symbol> defs once per
// page (Astro.locals is request-scoped) and reference them with <use>.
const locals = Astro.locals as Record<string, unknown>;
const emitSprite = !locals.__amzSprite;
if (emitSprite) locals.__amzSprite = true;
---

{emitSprite && (
  <svg aria-hidden="true" style="display:none" xmlns="http://www.w3.org/2000/svg">
    <symbol id="ap-check-circle" viewBox="0 0 20 20" fill="currentColor">
      <path
        fill-rule="evenodd"
        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
        clip-rule="evenodd"
      />
    </symbol>
    <symbol id="ap-check" viewBox="0 0 20 20" fill="currentColor">
      <path
        fill-rule="evenodd"
        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
        clip-rule="evenodd"
      />
    </symbol>
    <symbol id="ap-x" viewBox="0 0 20 20" fill="currentColor">
      <path
        fill-rule="evenodd"
        d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
        clip-rule="evenodd"
      />
    </symbol>
  </svg>
)}

<div class="amazon-product-card not-prose w-full my-8 bg-white dark:bg-gray-800 rounded-lg shadow-sm overflow-hidden transition-shadow duration-200 hover:shadow-md">
  <!-- Recommendation as quiet chip — matches tag language, not a full-bleed ad bar (One Voice) -->
  {recommendedBadge && (
    <div class="p-5 sm:p-8 pb-0">
      <span class="inline-flex items-center gap-1.5 bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 rounded-full px-2.5 py-1 text-xs font-semibold uppercase tracking-wide">
        <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        {recommendedBadge}
      </span>
    </div>
  )}

  <!-- Product Header -->
  <div class="p-5 sm:p-8">
    <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
      <!-- Product Image -->
      <div class="lg:w-1/3 shrink-0">
        <a
          href={affiliateLink}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="block"
          aria-label={`${productName} (${t(locale, "opensNewTab")})`}
        >
          <img
            src={productImage}
            alt={productName}
            width="300"
            height="208"
            class="w-full h-40 sm:h-52 object-contain bg-(--color-bg-muted) dark:bg-white dark:p-3 rounded-lg border border-(--color-border-base)"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </a>
      </div>

      <!-- Product Info -->
      <div class="lg:w-2/3 flex flex-col justify-between">
        <div>
          <!-- Product Name -->
          <h3 class="text-xl lg:text-2xl font-bold text-gray-900 dark:text-white mb-2.5">
            <a
              href={affiliateLink}
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="transition-colors duration-200 hover:text-blue-600 dark:hover:text-blue-400"
            >
              {productName}
            </a>
          </h3>

          <!-- Rating - simplified with CSS clip -->
          <div class="flex items-center gap-2 mb-3">
            <div
              class="star-rating"
              style={`--rating: ${ratingPercent}%`}
              role="img"
              aria-label={`${t(locale, "amazonRating")}: ${productRating} ${t(locale, "amazonRatingOf")}`}
            >
              <span class="stars-empty" aria-hidden="true">
                ★★★★★
              </span>
              <span class="stars-filled" aria-hidden="true">
                ★★★★★
              </span>
            </div>
            <span class="text-sm font-semibold text-gray-900 dark:text-white">{productRating}</span>
            <span class="text-sm text-gray-500 dark:text-gray-400">· {ratingWord}</span>
          </div>

          <!-- Product Description -->
          <p class="text-gray-700 dark:text-gray-300 mb-4 leading-relaxed">{productDescription}</p>
        </div>

        <!-- CTA: the single primary next step (image/title are plain links, this is the button) -->
        <div class="mt-4">
          <a
            href={affiliateLink}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="group/cta inline-flex w-full sm:w-auto items-center justify-center gap-2.5 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-md shadow-sm transition-colors duration-200"
          >
            <svg
              class="w-5 h-5 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z" />
            </svg>
            <span>{t(locale, "amazonCheckPrice")}</span>
            <svg
              class="w-4 h-4 shrink-0 opacity-80"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H9M17 7v8" />
            </svg>
          </a>
          <p class="mt-2.5 text-[11px] text-(--color-text-muted)">
            {t(locale, "amazonPriceNote")}{" "}
            <a
              href={localizeInternalPath("/how-i-test/", locale)}
              class="underline decoration-gray-300 underline-offset-2 transition-colors hover:text-blue-600 dark:decoration-gray-600 dark:hover:text-blue-400"
            >
              {t(locale, "howITest")}
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Product Features -->
  {productFeatures && productFeatures.length > 0 && (
    <div class="px-5 sm:px-8 py-6 border-t border-(--color-border-base)">
      <details class="amazon-features" open>
        <summary class="features-summary mb-4 flex cursor-pointer items-center text-lg font-semibold text-gray-900 dark:text-white sm:cursor-default">
          <svg class="w-5 h-5 mr-2 shrink-0 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
              clip-rule="evenodd"
            />
          </svg>
          {t(locale, "amazonKeyFeatures")}
          <svg
            class="features-chevron ml-auto w-5 h-5 text-gray-400 transition-transform sm:hidden"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
          </svg>
        </summary>
        <ul class="features-body grid sm:grid-cols-2 gap-x-8 gap-y-2">
          {productFeatures.map((feature) => (
            <li class="flex items-start">
              <svg
                class="w-5 h-5 text-blue-500 mt-0.5 mr-2 shrink-0"
                viewBox="0 0 20 20"
                aria-hidden="true"
              >
                <use href="#ap-check-circle" />
              </svg>
              <span class="text-sm text-gray-700 dark:text-gray-300">{feature}</span>
            </li>
          ))}
        </ul>
      </details>
    </div>
  )}

  <!-- Pros and Cons -->
  {((pros && pros.length > 0) || (cons && cons.length > 0)) && (
    <div class="px-5 sm:px-8 py-6 border-t border-(--color-border-base)">
      <div class="grid grid-cols-1 lg:grid-cols-2 lg:divide-x lg:divide-gray-200 dark:lg:divide-gray-700">
        <!-- Pros Section -->
        {pros && pros.length > 0 && (
          <div class="lg:pr-8">
            <h4 class="flex items-center gap-2.5 font-semibold text-gray-900 dark:text-white mb-3">
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-green-100 text-green-600 dark:bg-green-900/40 dark:text-green-400">
                <svg
                  class="h-3.5 w-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              {t(locale, "amazonWhatWeLike")}
            </h4>
            <ul class="space-y-2">
              {pros.map((pro) => (
                <li class="flex items-start">
                  <svg
                    class="w-4 h-4 text-green-500 mt-1 mr-2 shrink-0"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <use href="#ap-check" />
                  </svg>
                  <span class="text-gray-700 dark:text-gray-300 text-sm">{pro}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Cons Section -->
        {cons && cons.length > 0 && (
          <div class="mt-6 border-t border-gray-200 pt-6 lg:mt-0 lg:border-t-0 lg:pt-0 lg:pl-8 dark:border-gray-700">
            <h4 class="flex items-center gap-2.5 font-semibold text-gray-900 dark:text-white mb-3">
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-red-100 text-red-600 dark:bg-red-900/40 dark:text-red-400">
                <svg
                  class="h-3.5 w-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </span>
              {t(locale, "amazonWatchOutFor")}
            </h4>
            <ul class="space-y-2">
              {cons.map((con) => (
                <li class="flex items-start">
                  <svg
                    class="w-4 h-4 text-red-500 mt-1 mr-2 shrink-0"
                    viewBox="0 0 20 20"
                    aria-hidden="true"
                  >
                    <use href="#ap-x" />
                  </svg>
                  <span class="text-gray-700 dark:text-gray-300 text-sm">{con}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Important Considerations -->
  {importantConsiderations && importantConsiderations.length > 0 && (
    <div class="px-5 sm:px-8 py-6 border-t border-(--color-border-base)">
      <div class="rounded-lg border border-yellow-200 dark:border-yellow-800 bg-yellow-50 dark:bg-yellow-900/20 p-5">
        <h4 class="text-lg font-semibold text-yellow-800 dark:text-yellow-300 mb-3 flex items-center">
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
              clip-rule="evenodd"
            />
          </svg>
          {t(locale, "amazonImportant")}
        </h4>
        <ul class="space-y-2">
          {importantConsiderations.map((consideration) => (
            <li class="flex items-start">
              <span class="text-yellow-700 dark:text-yellow-300 text-sm mr-2 mt-1">•</span>
              <span class="text-yellow-800 dark:text-yellow-200 text-sm">{consideration}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}

  <!-- Disclaimer -->
  <div class="px-5 sm:px-8 pt-3 pb-3 bg-(--color-bg-muted) border-t border-(--color-border-base)">
    <p class="text-[11px] leading-relaxed text-(--color-text-muted) text-center">
      <strong>{t(locale, "amazonDisclosureLabel")}</strong> {t(locale, "amazonDisclosure")}
    </p>
  </div>
</div>

<script>
  /* <details open> ships open (features always render — no-JS safe). On small
     screens the script collapses it; on sm+ it stays open and summary is
     inert. Closed-details content can't be revealed by CSS alone. */
  const featureMq = window.matchMedia("(min-width: 640px)");
  document.querySelectorAll<HTMLDetailsElement>("details.amazon-features").forEach((details) => {
    let userToggled = false;
    details.querySelector("summary")?.addEventListener("click", () => (userToggled = true));
    const syncFeatures = () => {
      if (featureMq.matches) details.open = true;
      else if (!userToggled) details.open = false;
    };
    featureMq.addEventListener("change", () => {
      userToggled = false;
      syncFeatures();
    });
    syncFeatures();
  });
</script>

<style>
  .amazon-features > summary {
    list-style: none;
  }
  .amazon-features > summary::-webkit-details-marker {
    display: none;
  }
  .amazon-features[open] .features-chevron {
    transform: rotate(180deg);
  }
  @media (min-width: 640px) {
    .amazon-features .features-summary {
      pointer-events: none;
    }
  }

  .star-rating {
    position: relative;
    display: inline-block;
    font-size: 1.25rem;
    line-height: 1;
  }

  .stars-empty {
    color: rgb(209 213 219);
    letter-spacing: 2px;
  }

  :global(.dark) .stars-empty {
    color: rgb(75 85 99);
  }

  .stars-filled {
    position: absolute;
    top: 0;
    left: 0;
    color: rgb(250 204 21);
    overflow: hidden;
    width: var(--rating, 0%);
    letter-spacing: 2px;
  }
</style>

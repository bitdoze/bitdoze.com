---
import { Icon } from "astro-icon/components";
import type { SupportedLocale } from "@utils/i18n";
import { BF_PROMO_END } from "@utils/promo";

export interface Props {
  locale?: SupportedLocale;
}

const { locale = "en" } = Astro.props;

const copy = {
  en: {
    aria: "Black Friday homelab deals",
    eyebrow: "Black Friday · Nov 27–30",
    headline: "Homelab deals, price-verified",
    subline: "82 tracked products (mini PCs, NAS, docks, SSDs, drives, switches, UPS units, racks, KVMs) with real baseline prices, checked against Amazon through Cyber Monday.",
    dealsLabel: "Top cuts right now",
    cta: "See all deals",
    asOf: "Amazon US prices checked Nov 27",
    prime: "Prime",
    ctaAria: "See all tracked Black Friday homelab deals",
  },
  es: {
    aria: "Ofertas de homelab para Black Friday",
    eyebrow: "Black Friday · 27–30 nov",
    headline: "Ofertas de homelab, precios verificados",
    subline: "82 productos monitorizados (mini PCs, NAS, docks, SSD, discos, switches, UPS, racks, KVM) con precios base reales, revisados en Amazon hasta el Cyber Monday.",
    dealsLabel: "Mejores rebajas ahora",
    cta: "Ver todas las ofertas",
    asOf: "Precios de Amazon EE. UU. del 27 nov",
    prime: "Prime",
    ctaAria: "Ver todas las ofertas de homelab monitorizadas para Black Friday",
  },
  de: {
    aria: "Black-Friday-Homelab-Deals",
    eyebrow: "Black Friday · 27.–30. Nov",
    headline: "Homelab-Deals, geprüfte Preise",
    subline: "82 getrackte Produkte (Mini-PCs, NAS, Docks, SSDs, Laufwerke, Switches, USVs, Racks, KVMs) mit echten Referenzpreisen, bis Cyber Monday bei Amazon geprüft.",
    dealsLabel: "Größte Rabatte gerade",
    cta: "Alle Deals ansehen",
    asOf: "Amazon-US-Preise vom 27. Nov.",
    prime: "Prime",
    ctaAria: "Alle getrackten Black-Friday-Homelab-Deals ansehen",
  },
}[locale];

// Verified Nov 27 on Amazon (06:53 UTC, before the midnight Pacific switch): see black-friday-home-server-deals for baselines.
const deals = [
  { name: "WD Elements 20TB drive", price: "$549.99", off: "-38%", prime: false },
  { name: "UGREEN Maxidok TB5 dock", price: "$319.99", off: "-36%", prime: false },
  { name: "UGREEN DXP2800 GT NAS", price: "$349.99", off: "-31%", prime: false },
];

const ARTICLE_URL =
  locale === "de"
    ? "/de/black-friday-homeserver-deals/"
    : locale === "es"
      ? "/es/ofertas-black-friday-servidor-casa/"
      : "/black-friday-home-server-deals/";
---

<aside
  aria-label={copy.aria}
  data-promo-end={BF_PROMO_END.toISOString()}
  class="not-prose my-8 overflow-hidden rounded-xl border border-blue-200 bg-blue-50/60 dark:border-blue-900/60 dark:bg-slate-800/50"
>
  <div class="flex flex-col gap-5 p-5 lg:flex-row lg:items-center lg:justify-between lg:p-6">
    <!-- Left: pitch -->
    <div class="min-w-0 lg:max-w-sm">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-600 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-white">
        <Icon name="mdi:tag" class="h-3 w-3" aria-hidden="true" />
        {copy.eyebrow}
      </span>
      <p class="mt-2.5 text-lg font-bold leading-snug text-slate-900 dark:text-slate-50">
        {copy.headline}
      </p>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        {copy.subline}
      </p>
    </div>

    <!-- Right: top deals + CTA -->
    <div class="shrink-0 lg:w-80">
      <p class="text-[11px] font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">
        {copy.dealsLabel}
      </p>
      <ul class="mt-1.5 divide-y divide-blue-100 dark:divide-slate-700">
        {deals.map((deal) => (
          <li class="flex items-baseline justify-between gap-3 py-1.5">
            <span class="truncate text-sm text-slate-700 dark:text-slate-300">
              {deal.name}
              {deal.prime && <span class="ml-1 text-[11px] font-medium text-slate-500 dark:text-slate-400">({copy.prime})</span>}
            </span>
            <span class="flex shrink-0 items-baseline gap-2">
              <span class="rounded bg-blue-100 px-1.5 py-px text-[11px] font-bold text-blue-700 dark:bg-blue-900 dark:text-blue-300">{deal.off}</span>
              <span class="font-mono text-sm font-bold text-slate-900 dark:text-slate-50">{deal.price}</span>
            </span>
          </li>
        ))}
      </ul>
      <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">{copy.asOf}</p>
      <a
        href={ARTICLE_URL}
        aria-label={copy.ctaAria}
        class="mt-3 inline-flex w-full items-center justify-center gap-1.5 rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-blue-700"
      >
        {copy.cta}
        <Icon name="mdi:arrow-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</aside>

<script>
  // Cached pages stay valid after the sale ends: drop expired promos at runtime.
  document.querySelectorAll("[data-promo-end]").forEach((el) => {
    const end = el.getAttribute("data-promo-end");
    if (end && new Date() >= new Date(end)) el.remove();
  });
</script>

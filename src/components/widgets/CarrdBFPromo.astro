---
import { Icon } from "astro-icon/components";
import type { SupportedLocale } from "@utils/i18n";
import { CARRD_PROMO_END } from "@utils/promo";

export interface Props {
  locale?: SupportedLocale;
}

const { locale = "en" } = Astro.props;

const copy = {
  en: {
    aria: "Carrd Black Friday deal",
    eyebrow: "Black Friday 2026",
    headline: "40% off Carrd Pro",
    subline: "Every Pro plan, code at checkout.",
    codeLabel: "Promo code",
    copyAria: "Copy promo code BF2026",
    copied: "Copied!",
    cta: "Get the deal",
    details: "Deal details",
  },
  es: {
    aria: "Oferta de Carrd Black Friday",
    eyebrow: "Black Friday 2026",
    headline: "40% de descuento en Carrd Pro",
    subline: "En todos los planes Pro, con el código al pagar.",
    codeLabel: "Código promocional",
    copyAria: "Copiar código promocional BF2026",
    copied: "¡Copiado!",
    cta: "Ver la oferta",
    details: "Detalles de la oferta",
  },
  de: {
    aria: "Carrd Black-Friday-Angebot",
    eyebrow: "Black Friday 2026",
    headline: "40% Rabatt auf Carrd Pro",
    subline: "Auf alle Pro-Tarife, Code an der Kasse eingeben.",
    codeLabel: "Gutscheincode",
    copyAria: "Gutscheincode BF2026 kopieren",
    copied: "Kopiert!",
    cta: "Zum Angebot",
    details: "Deal-Details",
  },
}[locale];

const CODE = "BF2026";
// Black Friday sale runs Nov 27–30; the promo stops rendering Dec 2.
// Scope (date + tags/category) is decided by the caller — see utils/promo.ts.
const CARRD_URL = "/go/carrd/";
const ARTICLE_URL =
  locale === "de"
    ? "/de/carrd-black-friday-2026/"
    : locale === "es"
      ? "/es/ofertas-black-friday-carrd-2026/"
      : "/carrd-black-friday-2026/";
---

<aside
  aria-label={copy.aria}
  data-promo-end={CARRD_PROMO_END.toISOString()}
  class="not-prose my-8 overflow-hidden rounded-xl border border-blue-200 bg-blue-50/60 dark:border-blue-900/60 dark:bg-slate-800/50"
>
  <div class="flex flex-col gap-5 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
    <!-- Left: pitch -->
    <div class="min-w-0">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-600 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-white">
        <Icon name="mdi:tag" class="h-3 w-3" aria-hidden="true" />
        {copy.eyebrow}
      </span>
      <p class="mt-2.5 text-lg font-bold leading-snug text-slate-900 dark:text-slate-50">
        {copy.headline}
      </p>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        {copy.subline}
        <a
          href={ARTICLE_URL}
          class="font-medium text-blue-700 underline decoration-blue-300 underline-offset-2 hover:text-blue-800 dark:text-blue-400 dark:decoration-blue-700 dark:hover:text-blue-300"
        >
          {copy.details}
        </a>
      </p>
    </div>

    <!-- Right: code chip + CTA -->
    <div class="flex shrink-0 flex-col items-stretch gap-3 sm:items-end">
      <div class="flex items-center gap-2">
        <span class="text-[11px] font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">
          {copy.codeLabel}
        </span>
        <button
          type="button"
          data-bf-copy={CODE}
          aria-label={copy.copyAria}
          data-copied-label={copy.copied}
          class="group inline-flex cursor-pointer items-center gap-2 rounded-lg border-2 border-dashed border-blue-400 bg-white px-3.5 py-1.5 font-mono text-base font-bold tracking-[0.2em] text-blue-700 transition-colors hover:border-blue-600 hover:bg-blue-50 dark:border-blue-600 dark:bg-slate-900 dark:text-blue-300 dark:hover:border-blue-400"
        >
          <span data-bf-code>{CODE}</span>
          <Icon
            name="mdi:content-copy"
            class="h-4 w-4 text-slate-400 transition-colors group-hover:text-blue-600 dark:group-hover:text-blue-400"
            aria-hidden="true"
          />
        </button>
      </div>
      <a
        href={CARRD_URL}
        rel="sponsored nofollow"
        class="inline-flex items-center justify-center gap-1.5 rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-blue-700"
      >
        {copy.cta}
        <Icon name="mdi:arrow-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</aside>

<script>
  // Cached pages stay valid after the sale ends: drop expired promos at runtime.
  const promoEnd = document.querySelector("[data-promo-end]")?.getAttribute("data-promo-end");
  if (promoEnd && new Date() >= new Date(promoEnd)) {
    document.querySelectorAll("[data-promo-end]").forEach((el) => el.remove());
  }

  // Delegated copy handler — safe when the box renders twice on one page.
  if (!(window as unknown as { __bfPromoBound?: boolean }).__bfPromoBound) {
    (window as unknown as { __bfPromoBound?: boolean }).__bfPromoBound = true;
    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest?.("[data-bf-copy]") as HTMLElement | null;
      if (!btn) return;
      const code = btn.dataset.bfCopy || "";
      const chip = btn.querySelector("[data-bf-code]");
      const label = btn.dataset.copiedLabel || "Copied!";
      navigator.clipboard?.writeText(code).then(() => {
        if (!chip) return;
        const prev = chip.textContent;
        chip.textContent = label;
        setTimeout(() => (chip.textContent = prev), 1600);
      });
    });
  }
</script>

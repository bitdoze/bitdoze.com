---
import type { CollectionEntry } from "astro:content";
import type { SupportedLocale } from "@utils/i18n";
import { getEntryHref } from "@utils/content";
import { getNextStep } from "@utils/nextStep";
import { t, tf } from "@i18n/ui";

interface Props {
  post: CollectionEntry<"posts">;
  locale: SupportedLocale;
  localePosts: CollectionEntry<"posts">[];
}

const { post, locale, localePosts } = Astro.props;
const nextStep = getNextStep(post, localePosts, locale);
---

{nextStep && (
  <aside class="not-prose mt-10 rounded-lg border border-(--color-border-base) bg-(--color-bg-muted) p-5">
    {nextStep.journey?.stageNumber != null && nextStep.journey.stageCount != null && (
      <a
        href={`/self-hosted/#${nextStep.journey.stageId}`}
        class="font-mono text-xs uppercase tracking-wide text-(--color-text-muted) hover:text-blue-600 dark:hover:text-blue-400"
      >
        {tf(locale, "journeyStage", {
          n: nextStep.journey.stageNumber,
          total: nextStep.journey.stageCount,
        })}
      </a>
    )}
    <p class="mt-1 font-mono text-xs font-semibold uppercase tracking-wide text-blue-700 dark:text-blue-300">
      {t(locale, "nextStep")}
    </p>
    <a
      href={getEntryHref(nextStep.post)}
      class="mt-1.5 inline-block font-display text-lg font-bold text-gray-900 transition-colors hover:text-blue-700 dark:text-white dark:hover:text-blue-300"
    >
      {nextStep.post.data.title} <span aria-hidden="true">→</span>
    </a>
    {nextStep.post.data.description && (
      <p class="mt-1 text-sm text-(--color-text-muted) line-clamp-2">
        {nextStep.post.data.description}
      </p>
    )}
  </aside>
)}

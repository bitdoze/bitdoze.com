---
import { Icon } from "astro-icon/components";
import { getLatestDigests } from "@utils/news";
import { getEntrySlug } from "@utils/content";

export interface Props {
  locale?: string;
}

const { locale = "en" } = Astro.props;
const isEs = locale === "es";

const [latestDigest] = await getLatestDigests(1);
const digestHref = latestDigest ? `/news/${getEntrySlug(latestDigest)}/` : "/news/";

const cards = isEs
  ? [
      {
        href: "/es/categories/self-hosting/",
        icon: "mdi:server-network",
        label: "Ruta recomendada",
        title: "Self-hosting, de cero a producción",
        desc: "Docker, proxy inverso, monitorización y apps — el orden en que conviene montarlo.",
      },
      {
        href: "/es/blog/",
        icon: "mdi:book-open-page-variant-outline",
        label: "Archivo",
        title: "Todas las guías",
        desc: "Más de 400 tutoriales probados, ordenados por fecha y tema.",
      },
      {
        href: "/es/resources/",
        icon: "mdi:toolbox-outline",
        label: "Recursos",
        title: "Herramientas y créditos",
        desc: "Lo que uso en el lab: hosting, software y créditos gratis verificados.",
      },
    ]
  : [
      {
        href: "/self-hosted/",
        icon: "mdi:server-network",
        label: "Route map",
        title: "Self-hosting, zero to production",
        desc: "Docker, reverse proxy, monitoring, apps — in the order you should build them.",
      },
      {
        href: "/courses/",
        icon: "mdi:play-circle-outline",
        label: "Video courses",
        title: "Learn by watching",
        desc: "Full courses on the @webdoze channel, with the written guide next to every lesson.",
      },
      {
        href: digestHref,
        icon: "mdi:newspaper-variant-outline",
        label: "Fresh today",
        title: "Today's AI & tech digest",
        desc: "What shipped today in AI, dev tools, and self-hosting — five minutes, no filler.",
      },
    ];
---

<section
  class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8"
  aria-label={isEs ? "Empieza aquí" : "Start here"}
>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    {cards.map((card) => (
      <a
        href={card.href}
        class="group flex flex-col rounded-xl border border-(--color-border-base) bg-(--color-bg-base) p-5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-md dark:hover:border-blue-700"
      >
        <div class="flex items-center gap-2">
          <Icon
            name={card.icon}
            class="h-4 w-4 text-blue-600 dark:text-blue-400"
            aria-hidden="true"
          />
          <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-(--color-text-muted)">
            {card.label}
          </span>
        </div>
        <p class="mt-3 font-display text-base font-bold leading-snug text-gray-900 transition-colors duration-200 group-hover:text-blue-700 dark:text-white dark:group-hover:text-blue-300">
          {card.title}
        </p>
        <p class="mt-1.5 text-sm leading-relaxed text-(--color-text-muted)">{card.desc}</p>
        <span class="mt-auto inline-flex items-center gap-1 pt-3 text-sm font-semibold text-blue-600 transition-transform duration-200 group-hover:translate-x-0.5 dark:text-blue-400">
          <Icon name="mdi:arrow-right" class="h-4 w-4" aria-hidden="true" />
        </span>
      </a>
    ))}
  </div>
</section>

---
import { Icon } from "astro-icon/components";
import { localizeInternalPath } from "@utils/localeRoutes";

export interface Props {
  locale?: "en" | "es";
}

const { locale = "en" } = Astro.props;
const isEs = locale === "es";

const links = [
  {
    href: localizeInternalPath("/rss.xml", locale),
    icon: "mdi:rss",
    label: "RSS",
    desc: isEs ? "Guías nuevas en tu lector" : "New guides in your reader",
    external: false,
  },
  {
    href: "/news/rss.xml",
    icon: "mdi:newspaper-variant-outline",
    label: isEs ? "RSS de noticias" : "News RSS",
    desc: isEs ? "El digest diario" : "The daily digest",
    external: false,
  },
  {
    href: "https://www.youtube.com/@webdoze",
    icon: "mdi:youtube",
    label: "YouTube",
    desc: isEs ? "Las guías en video" : "The guides on video",
    external: true,
  },
];
---

<aside
  class="post-aside-follow not-prose mt-8 rounded-xl border border-blue-200 bg-blue-50 px-5 py-4 dark:border-blue-900 dark:bg-blue-950/40"
  aria-label={isEs ? "Seguir a Bitdoze" : "Follow Bitdoze"}
>
  <p class="text-sm font-semibold text-gray-900 dark:text-white">
    {isEs ? "Guías nuevas cada semana" : "New tested guides every week"}
  </p>
  <p class="mt-1 text-sm text-gray-600 dark:text-(--color-text-muted)">
    {isEs
      ? "Sin spam y sin boletín todavía — sígueme donde ya estás."
      : "No spam, no popups — follow where you already are."}
  </p>
  <div class="mt-3 flex flex-wrap gap-2">
    {links.map((link) => (
      <a
        href={link.href}
        {...(link.external ? { target: "_blank", rel: "noopener" } : {})}
        class="inline-flex items-center gap-2 rounded-lg border border-blue-200 bg-white px-3 py-1.5 text-sm font-medium text-blue-800 transition-colors duration-150 hover:border-blue-400 hover:bg-blue-100 dark:border-blue-800 dark:bg-gray-900 dark:text-blue-200 dark:hover:border-blue-600"
      >
        <Icon name={link.icon} class="h-4 w-4 shrink-0" aria-hidden="true" />
        <span>{link.label}</span>
        <span class="hidden text-xs font-normal text-(--color-text-muted) sm:inline">
          {link.desc}
        </span>
      </a>
    ))}
  </div>
</aside>

---
import { Icon } from "astro-icon/components";
import { localizeInternalPath } from "@utils/localeRoutes";
import { siteConfig } from "@config/site";
import type { SupportedLocale } from "@utils/i18n";

export interface Props {
  locale?: SupportedLocale;
}

const { locale = "en" } = Astro.props;

const copy = {
  en: {
    aria: "Follow Bitdoze",
    headline: "New tested guides every week",
    rssDesc: "New guides in your reader",
    newsLabel: "News RSS",
    newsDesc: "The daily digest",
    ytDesc: "The guides on video",
    subline: "No spam, no popups — follow where you already are.",
    newsletterLine: "One email a week: what I tested, what broke, what changed.",
    newsletterButton: "Subscribe",
    newsletterLabel: "Email address",
  },
  es: {
    aria: "Seguir a Bitdoze",
    headline: "Guías nuevas cada semana",
    rssDesc: "Guías nuevas en tu lector",
    newsLabel: "RSS de noticias",
    newsDesc: "El digest diario",
    ytDesc: "Las guías en video",
    subline: "Sin spam y sin boletín todavía — sígueme donde ya estás.",
    newsletterLine: "Un correo a la semana: qué probé, qué falló y qué cambió.",
    newsletterButton: "Suscribirme",
    newsletterLabel: "Correo electrónico",
  },
  de: {
    aria: "Bitdoze folgen",
    headline: "Jede Woche neue getestete Anleitungen",
    rssDesc: "Neue Anleitungen in deinem Reader",
    newsLabel: "News-RSS",
    newsDesc: "Der tägliche Digest",
    ytDesc: "Die Anleitungen als Video",
    subline: "Kein Spam, keine Pop-ups — folge mir dort, wo du schon bist.",
    newsletterLine:
      "Eine E-Mail pro Woche: was ich getestet habe, was kaputtging, was sich geändert hat.",
    newsletterButton: "Abonnieren",
    newsletterLabel: "E-Mail-Adresse",
  },
}[locale];

const newsletter = siteConfig.newsletter;

const links = [
  {
    href: localizeInternalPath("/rss.xml", locale),
    icon: "mdi:rss",
    label: "RSS",
    desc: copy.rssDesc,
    external: false,
  },
  {
    href: "/news/rss.xml",
    icon: "mdi:newspaper-variant-outline",
    label: copy.newsLabel,
    desc: copy.newsDesc,
    external: false,
  },
  {
    href: "https://www.youtube.com/@webdoze",
    icon: "mdi:youtube",
    label: "YouTube",
    desc: copy.ytDesc,
    external: true,
  },
];
---

<aside
  class="post-aside-follow not-prose mt-8 rounded-xl border border-blue-200 bg-blue-50 px-5 py-3.5 dark:border-blue-900 dark:bg-blue-950/40"
  aria-label={copy.aria}
>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <p class="text-sm font-semibold text-gray-900 dark:text-white">{copy.headline}</p>
    <div class="flex flex-wrap gap-2">
      {links.map((link) => (
        <a
          href={link.href}
          title={link.desc}
          {...(link.external ? { target: "_blank", rel: "noopener" } : {})}
          class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-lg border border-blue-200 bg-white px-3 py-1.5 text-sm font-medium text-blue-800 transition-colors duration-150 hover:border-blue-400 hover:bg-blue-100 dark:border-blue-800 dark:bg-gray-900 dark:text-blue-200 dark:hover:border-blue-600"
        >
          <Icon name={link.icon} class="h-4 w-4 shrink-0" aria-hidden="true" />
          <span>{link.label}</span>
        </a>
      ))}
    </div>
  </div>
  <p class="mt-1 text-sm text-gray-600 dark:text-(--color-text-muted)">{copy.subline}</p>
  {newsletter.action && (
    <form
      class="mt-3 flex flex-wrap items-center gap-2 border-t border-blue-200 pt-3 dark:border-blue-900"
      method="post"
      action={newsletter.action}
      target="_blank"
      data-newsletter-form
    >
      <p class="w-full text-sm text-gray-600 dark:text-(--color-text-muted)">
        {copy.newsletterLine}
      </p>
      <label class="sr-only" for={`follow-email-${locale}`}>
        {copy.newsletterLabel}
      </label>
      <input
        id={`follow-email-${locale}`}
        type="email"
        name={newsletter.emailField}
        required
        autocomplete="email"
        class="min-w-0 flex-1 rounded-lg border border-blue-200 bg-white px-3 py-1.5 text-sm text-gray-900 placeholder-(--color-text-subtle) focus:outline-none focus:ring-2 focus:ring-blue-600 dark:border-blue-800 dark:bg-gray-900 dark:text-white"
      />
      {Object.entries(newsletter.hiddenFields).map(([name, value]) => (
        <input type="hidden" name={name} value={value} />
      ))}
      <button
        type="submit"
        class="inline-flex shrink-0 items-center rounded-lg bg-blue-600 px-4 py-1.5 text-sm font-semibold text-white transition-colors duration-150 hover:bg-blue-700"
      >
        {copy.newsletterButton}
      </button>
    </form>
  )}
</aside>

<script>
  document.querySelectorAll("[data-newsletter-form]").forEach((form) => {
    form.addEventListener("submit", () => {
      try {
        (window as any).plausible?.("subscribe_submit", {
          props: { path: location.pathname },
        });
      } catch {
        /* analytics blocked */
      }
    });
  });
</script>

---
import { Icon } from "astro-icon/components";
import { localizeInternalPath } from "@utils/localeRoutes";
import type { SupportedLocale } from "@utils/i18n";

export interface Props {
  locale?: SupportedLocale;
}

const { locale = "en" } = Astro.props;

const copy = {
  en: {
    aria: "Follow Bitdoze",
    headline: "New tested guides every week",
    rssDesc: "New guides in your reader",
    newsLabel: "News RSS",
    newsDesc: "The daily digest",
    ytDesc: "The guides on video",
    subline: "No spam, no popups — follow where you already are.",
  },
  es: {
    aria: "Seguir a Bitdoze",
    headline: "Guías nuevas cada semana",
    rssDesc: "Guías nuevas en tu lector",
    newsLabel: "RSS de noticias",
    newsDesc: "El digest diario",
    ytDesc: "Las guías en video",
    subline: "Sin spam y sin boletín todavía — sígueme donde ya estás.",
  },
  de: {
    aria: "Bitdoze folgen",
    headline: "Jede Woche neue getestete Anleitungen",
    rssDesc: "Neue Anleitungen in deinem Reader",
    newsLabel: "News-RSS",
    newsDesc: "Der tägliche Digest",
    ytDesc: "Die Anleitungen als Video",
    subline: "Kein Spam, keine Pop-ups — folge mir dort, wo du schon bist.",
  },
}[locale];

const links = [
  {
    href: localizeInternalPath("/rss.xml", locale),
    icon: "mdi:rss",
    label: "RSS",
    desc: copy.rssDesc,
    external: false,
  },
  {
    href: "/news/rss.xml",
    icon: "mdi:newspaper-variant-outline",
    label: copy.newsLabel,
    desc: copy.newsDesc,
    external: false,
  },
  {
    href: "https://www.youtube.com/@webdoze",
    icon: "mdi:youtube",
    label: "YouTube",
    desc: copy.ytDesc,
    external: true,
  },
];
---

<aside
  class="post-aside-follow not-prose mt-8 rounded-xl border border-blue-200 bg-blue-50 px-5 py-3.5 dark:border-blue-900 dark:bg-blue-950/40"
  aria-label={copy.aria}
>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <p class="text-sm font-semibold text-gray-900 dark:text-white">
      {copy.headline}
    </p>
    <div class="flex flex-wrap gap-2">
      {links.map((link) => (
        <a
          href={link.href}
          title={link.desc}
          {...(link.external ? { target: "_blank", rel: "noopener" } : {})}
          class="inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-lg border border-blue-200 bg-white px-3 py-1.5 text-sm font-medium text-blue-800 transition-colors duration-150 hover:border-blue-400 hover:bg-blue-100 dark:border-blue-800 dark:bg-gray-900 dark:text-blue-200 dark:hover:border-blue-600"
        >
          <Icon name={link.icon} class="h-4 w-4 shrink-0" aria-hidden="true" />
          <span>{link.label}</span>
        </a>
      ))}
    </div>
  </div>
  <p class="mt-1 text-sm text-gray-600 dark:text-(--color-text-muted)">
    {copy.subline}
  </p>
</aside>

---
import { Image } from "astro:assets";
import { formatDateShort } from "@utils/date";
import SeriesBadge from "./SeriesBadge.astro";
import { getEntryHref, getEntrySlug } from "@utils/content";
import { getPostLocale } from "@utils/i18n";
import { buildArchivePath, toTaxonomySlug, toTransitionName } from "@utils/slugs";
import { getReadingTime } from "@utils/readingTime";
import { t } from "@i18n/ui";
import type { CollectionEntry } from "astro:content";
import { formatTaxonomyLabel } from "@utils/labels";

interface Props {
  post: CollectionEntry<"posts">;
  priority?: boolean;
  /** h3 under a section h2 (homepage, related); h2 on archive views whose only heading is the page h1 */
  headingLevel?: 2 | 3;
  /** Full-width horizontal lead card (archive page 1) */
  featured?: boolean;
}

const { post, priority = false, headingLevel = 3, featured = false } = Astro.props;
const { title, description, image, date, categories, series } = post.data;
const TitleTag = `h${headingLevel}` as "h2" | "h3";

const slug = getEntrySlug(post);
const href = getEntryHref(post);
const locale = getPostLocale(post);
const readingTime = getReadingTime(post.body || "");
// Check if post is part of a series
const isPartOfSeries = series && Array.isArray(series) && series.length === 2;
---

<article
  class:list={[
    "group/card flex h-full flex-col rounded-lg border border-gray-200 bg-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md dark:border-gray-700 dark:bg-gray-800 overflow-hidden",
    featured && "md:flex-row",
  ]}
>
  <!-- Post Image. Decorative duplicate of the title link below — hidden from
       the a11y tree and tab order so screen readers get one link per post. -->
  {image && (
    <a
      href={href}
      class:list={[
        "block overflow-hidden aspect-video",
        featured && "md:relative md:w-[45%] md:aspect-auto md:shrink-0",
      ]}
      aria-hidden="true"
      tabindex="-1"
    >
      <Image
        src={image}
        alt=""
        class:list={[
          "w-full h-full object-cover",
          featured && "md:absolute md:inset-0",
          priority || featured
            ? "transition-transform duration-300 group-hover/card:scale-[1.03]"
            : "",
        ]}
        width={640}
        height={360}
        widths={featured ? [640, 960, 1280] : [320, 480, 640]}
        loading={priority || featured ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={priority || featured ? "high" : "auto"}
        sizes={
          featured
            ? "(max-width: 768px) 100vw, 45vw"
            : "(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 320px"
        }
        style={`view-transition-name: ${toTransitionName("post-image", slug)}`}
      />
    </a>
  )}

  <div class:list={["flex flex-1 flex-col p-5", featured && "md:justify-center md:p-7"]}>
    <div class="flex flex-wrap gap-2 mb-3 items-center justify-between">
      <!-- Categories -->
      {categories && categories.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {categories.map((category: string) => (
            <a
              href={buildArchivePath("categories", toTaxonomySlug(category), locale)}
              class="font-mono uppercase tracking-wide text-[10px] leading-none px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 rounded-full hover:bg-blue-200 dark:hover:bg-blue-800 transition-colors"
            >
              {formatTaxonomyLabel(category)}
            </a>
          ))}
        </div>
      )}

      <!-- Series Badge (if part of a series) -->
      {isPartOfSeries && (
        <SeriesBadge seriesName={series[0]} seriesPosition={series[1]} size="sm" locale={locale} />
      )}
    </div>

    <!-- Title: h2 on archive views, h3 under a section heading elsewhere -->
    <TitleTag
      class:list={[
        "font-bold tracking-[-0.02em] mb-2 text-gray-900 dark:text-white",
        featured ? "text-2xl md:text-3xl line-clamp-3" : "text-xl line-clamp-2",
      ]}
      style={`view-transition-name: ${toTransitionName("post-title", slug)}`}
    >
      <a
        href={href}
        class="rounded hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
      >
        {title}
      </a>
    </TitleTag>

    <!-- Description -->
    {description && (
      <p
        class:list={[
          "leading-relaxed text-gray-600 dark:text-gray-300 mb-4",
          featured ? "text-base line-clamp-4" : "text-sm line-clamp-3",
        ]}
      >
        {description}
      </p>
    )}

    <div class="mt-auto flex items-center gap-2 whitespace-nowrap border-t border-(--color-border-base) pt-3 font-mono uppercase tracking-wide text-[11px] text-(--color-text-muted)">
      {date && <time datetime={date.toISOString()}>{formatDateShort(date, locale)}</time>}
      {date && readingTime.minutes > 0 && <span aria-hidden="true">·</span>}
      {readingTime.minutes > 0 && (
        <span>
          {readingTime.minutes} {t(locale, "minRead")}
        </span>
      )}
    </div>
  </div>
</article>

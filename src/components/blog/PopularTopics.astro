---
import { Image } from "astro:assets";
import { getEntryHref } from "@utils/content";
import { getLocaleFromPathname } from "@utils/i18n";
import { getPostsByLocale } from "@utils/postsCache";
import { buildArchivePath, toTaxonomySlug } from "@utils/slugs";
import { formatDate } from "@utils/date";
import { formatTaxonomyLabel } from "@utils/labels";
import { t } from "@i18n/ui";

export interface Props {
  tags?: string[];
  postsPerTag?: number;
}

const { tags, postsPerTag = 5 } = Astro.props;

// Get all posts
const locale = getLocaleFromPathname(Astro.url.pathname);
const popularTopicsLabel = t(locale, "popularTopics");
const allPosts = await getPostsByLocale(locale);

// Sort posts by date (most recent first)
const sortedPosts = allPosts.sort((a, b) => {
  const dateA = new Date(a.data.date || "");
  const dateB = new Date(b.data.date || "");
  return dateB.getTime() - dateA.getTime();
});

// Derive topics from taxonomy frequency when tags prop omitted — avoids hardcoded drift.
// Falls back to explicit tags when passed (e.g. from index.astro older call sites).
const derivedTags = (() => {
  if (tags && tags.length > 0) return tags;
  const counts = new Map<string, number>();
  for (const p of sortedPosts) {
    for (const raw of p.data.tags || []) {
      const slug = toTaxonomySlug(raw);
      if (!slug) continue;
      counts.set(slug, (counts.get(slug) || 0) + 1);
    }
  }
  return [...counts.entries()]
    .sort((a, b) => b[1] - a[1])
    .slice(0, 3)
    .map(([slug]) => slug);
})();

// Get posts for each tag — drop topics with no posts in this locale, since the
// "view all" link would 404 (e.g. an EN-only tag has no /es/tags/<slug>/ page).
const tagPosts = derivedTags
  .map((tag) => ({
    tag,
    posts: sortedPosts
      .filter((post) =>
        post.data.tags?.map((t: string) => toTaxonomySlug(t)).includes(toTaxonomySlug(tag))
      )
      .slice(0, postsPerTag),
  }))
  .filter(({ posts }) => posts.length > 0)
  .slice(0, 3);
---

<section class="mt-16 border-y border-(--color-border-base) bg-(--color-bg-muted) py-14">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-10 flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
          {popularTopicsLabel}
        </h2>
        <p class="mt-1 text-sm text-(--color-text-muted)">{t(locale, "popularTopicsSub")}</p>
      </div>
    </div>
    <div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8 lg:gap-12">
      {tagPosts.map(({ tag, posts }) => (
        <div>
          <div class="flex items-center gap-2 border-b border-(--color-border-base) pb-3">
            <h3 class="text-sm font-bold uppercase tracking-wide text-gray-900 dark:text-white">
              {formatTaxonomyLabel(tag)}
            </h3>
            <span class="rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700 dark:bg-blue-900/40 dark:text-blue-300">
              {posts.length}
            </span>
          </div>
          <div class="divide-y divide-gray-200 dark:divide-gray-700">
            {posts.map((post) => {
              const href = getEntryHref(post);

              return (
                <a href={href} class="group flex items-center gap-3 py-3">
                  <div class="relative w-16 shrink-0 overflow-hidden rounded-md border border-(--color-border-base)">
                    <div class="aspect-video">
                      {post.data.image && (
                        <Image
                          src={post.data.image}
                          alt=""
                          width={64}
                          height={36}
                          loading="lazy"
                          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                        />
                      )}
                    </div>
                  </div>
                  <div class="min-w-0 grow">
                    <h4 class="line-clamp-2 text-sm font-medium leading-snug text-gray-800 transition-colors duration-200 group-hover:text-blue-600 dark:text-gray-200 dark:group-hover:text-blue-400">
                      {post.data.title}
                    </h4>
                    {post.data.date && (
                      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                        {formatDate(new Date(post.data.date), locale)}
                      </p>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
          <div class="pt-3">
            <a
              href={buildArchivePath("tags", toTaxonomySlug(tag), locale)}
              class="group inline-flex items-center text-sm font-semibold text-blue-600 transition-colors duration-200 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
            >
              <span>{t(locale, "viewAllTagPosts").replace("{tag}", formatTaxonomyLabel(tag))}</span>
              <svg
                class="ml-1 h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14" />
                <path d="M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
import { Icon } from "astro-icon/components";
import { localizeInternalPath } from "@utils/localeRoutes";
import type { SupportedLocale } from "@utils/i18n";

export interface Props {
  slug: string;
  locale?: SupportedLocale;
}

const { slug, locale = "en" } = Astro.props;
const copy = {
  en: {
    question: "Did this guide work for you?",
    yes: "Yes",
    no: "No",
    thanks: "Thanks. Glad it worked.",
    whatWrong: "What went wrong?",
    reasons: [
      { id: "command", label: "A command failed" },
      { id: "version", label: "The UI or version changed" },
      { id: "missing", label: "A step is missing" },
      { id: "other", label: "Something else" },
    ],
    thanksFail: "Thanks. Failed guides go to the top of my update queue.",
    sendDetails: "Send me the details",
  },
  es: {
    question: "¿Te funcionó esta guía?",
    yes: "Sí",
    no: "No",
    thanks: "Gracias. Me alegra que funcionara.",
    whatWrong: "¿Qué falló?",
    reasons: [
      { id: "command", label: "Falló un comando" },
      { id: "version", label: "Cambió la interfaz o la versión" },
      { id: "missing", label: "Falta un paso" },
      { id: "other", label: "Otra cosa" },
    ],
    thanksFail: "Gracias. Las guías que fallan pasan al principio de mi lista de actualizaciones.",
    sendDetails: "Envíame los detalles",
  },
  de: {
    question: "Hat diese Anleitung bei dir funktioniert?",
    yes: "Ja",
    no: "Nein",
    thanks: "Danke. Schön, dass es geklappt hat.",
    whatWrong: "Was ist schiefgelaufen?",
    reasons: [
      { id: "command", label: "Ein Befehl ist fehlgeschlagen" },
      { id: "version", label: "Oberfläche oder Version hat sich geändert" },
      { id: "missing", label: "Ein Schritt fehlt" },
      { id: "other", label: "Etwas anderes" },
    ],
    thanksFail: "Danke. Fehlgeschlagene Anleitungen kommen ganz oben auf meine Update-Liste.",
    sendDetails: "Schick mir die Details",
  },
}[locale];

const contactHref = `${localizeInternalPath("/contact/", locale)}?guide=${slug}`;
---

<div
  class="not-prose mt-8 rounded-lg border border-(--color-border-base) bg-(--color-bg-muted) px-5 py-4"
  data-guide-feedback
  data-slug={slug}
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm font-semibold text-gray-900 dark:text-white">{copy.question}</p>
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-vote="yes"
        class="inline-flex items-center gap-1.5 rounded-lg border border-(--color-border-base) bg-(--color-bg-base) px-3.5 py-1.5 text-sm font-medium text-gray-700 transition-colors duration-150 hover:border-green-400 hover:text-green-700 dark:text-gray-300 dark:hover:border-green-600 dark:hover:text-green-400"
      >
        <Icon name="mdi:thumb-up-outline" class="h-4 w-4" aria-hidden="true" />
        {copy.yes}
      </button>
      <button
        type="button"
        data-vote="no"
        class="inline-flex items-center gap-1.5 rounded-lg border border-(--color-border-base) bg-(--color-bg-base) px-3.5 py-1.5 text-sm font-medium text-gray-700 transition-colors duration-150 hover:border-red-400 hover:text-red-700 dark:text-gray-300 dark:hover:border-red-600 dark:hover:text-red-400"
      >
        <Icon name="mdi:thumb-down-outline" class="h-4 w-4" aria-hidden="true" />
        {copy.no}
      </button>
    </div>
  </div>
  <p class="mt-2 hidden text-sm text-(--color-text-muted)" data-thanks>
    {copy.thanks}
  </p>
  <div class="mt-3 hidden" data-reasons>
    <p class="text-sm font-semibold text-gray-900 dark:text-white">{copy.whatWrong}</p>
    <div class="mt-2 flex flex-wrap gap-2">
      {copy.reasons.map((reason) => (
        <button
          type="button"
          data-reason={reason.id}
          class="inline-flex min-h-9 items-center rounded-lg border border-(--color-border-base) bg-(--color-bg-base) px-3 py-1.5 text-sm font-medium text-gray-700 transition-colors duration-150 hover:border-blue-400 hover:text-blue-700 dark:text-gray-300 dark:hover:border-blue-500 dark:hover:text-blue-400"
        >
          {reason.label}
        </button>
      ))}
    </div>
  </div>
  <p class="mt-2 hidden text-sm text-(--color-text-muted)" data-thanks-fail>
    {copy.thanksFail}{" "}
    <a
      href={contactHref}
      class="font-medium text-blue-600 underline decoration-blue-300 underline-offset-2 hover:text-blue-700 dark:text-blue-400 dark:decoration-blue-700 dark:hover:text-blue-300"
    >
      {copy.sendDetails}
    </a>
  </p>
</div>

<script>
  document.querySelectorAll("[data-guide-feedback]").forEach((box) => {
    box.addEventListener("click", (e) => {
      const reasonBtn = (e.target as HTMLElement).closest("[data-reason]");
      if (reasonBtn && box.hasAttribute("data-voted-no")) {
        const slug = box.getAttribute("data-slug") || "";
        const reason = reasonBtn.getAttribute("data-reason") || "";
        try {
          (window as any).plausible?.("guide_feedback_reason", { props: { slug, reason } });
        } catch {
          /* analytics blocked — the UI still acknowledges the answer */
        }
        box.querySelector("[data-reasons]")?.classList.add("hidden");
        box.querySelector("[data-thanks-fail]")?.classList.remove("hidden");
        return;
      }

      const btn = (e.target as HTMLElement).closest("[data-vote]");
      if (!btn || box.hasAttribute("data-voted")) return;
      box.setAttribute("data-voted", "true");
      const slug = box.getAttribute("data-slug") || "";
      const vote = btn.getAttribute("data-vote");
      try {
        (window as any).plausible?.("guide_feedback", { props: { slug, vote } });
      } catch {
        /* analytics blocked — the UI still acknowledges the vote */
      }
      if (vote === "no") {
        box.setAttribute("data-voted-no", "true");
        box.querySelector("[data-reasons]")?.classList.remove("hidden");
      } else {
        box.querySelector("[data-thanks]")?.classList.remove("hidden");
      }
      box.querySelectorAll("[data-vote]").forEach((b) => b.setAttribute("disabled", "true"));
      btn.classList.add(
        ...(vote === "yes"
          ? "border-green-400! text-green-700! dark:border-green-600! dark:text-green-400!"
          : "border-red-400! text-red-700! dark:border-red-600! dark:text-red-400!"
        ).split(" ")
      );
    });
  });
</script>

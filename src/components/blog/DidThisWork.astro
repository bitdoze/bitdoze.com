---
import { Icon } from "astro-icon/components";

export interface Props {
  slug: string;
  locale?: string;
}

const { slug, locale = "en" } = Astro.props;
const isEs = locale === "es";
---

<div
  class="not-prose mt-8 rounded-lg border border-(--color-border-base) bg-(--color-bg-muted) px-5 py-4"
  data-guide-feedback
  data-slug={slug}
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm font-semibold text-gray-900 dark:text-white">
      {isEs ? "¿Te funcionó esta guía?" : "Did this guide work for you?"}
    </p>
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-vote="yes"
        class="inline-flex items-center gap-1.5 rounded-lg border border-(--color-border-base) bg-(--color-bg-base) px-3.5 py-1.5 text-sm font-medium text-gray-700 transition-colors duration-150 hover:border-green-400 hover:text-green-700 dark:text-gray-300 dark:hover:border-green-600 dark:hover:text-green-400"
      >
        <Icon name="mdi:thumb-up-outline" class="h-4 w-4" aria-hidden="true" />
        {isEs ? "Sí" : "Yes"}
      </button>
      <button
        type="button"
        data-vote="no"
        class="inline-flex items-center gap-1.5 rounded-lg border border-(--color-border-base) bg-(--color-bg-base) px-3.5 py-1.5 text-sm font-medium text-gray-700 transition-colors duration-150 hover:border-red-400 hover:text-red-700 dark:text-gray-300 dark:hover:border-red-600 dark:hover:text-red-400"
      >
        <Icon name="mdi:thumb-down-outline" class="h-4 w-4" aria-hidden="true" />
        {isEs ? "No" : "No"}
      </button>
    </div>
  </div>
  <p class="mt-2 hidden text-sm text-(--color-text-muted)" data-thanks>
    {isEs
      ? "Gracias — esto me dice qué guías necesitan actualización."
      : "Thanks — this tells me which guides need a refresh."}
  </p>
</div>

<script>
  document.querySelectorAll("[data-guide-feedback]").forEach((box) => {
    box.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("[data-vote]");
      if (!btn || box.hasAttribute("data-voted")) return;
      box.setAttribute("data-voted", "true");
      const slug = box.getAttribute("data-slug") || "";
      const vote = btn.getAttribute("data-vote");
      try {
        (window as any).plausible?.("guide_feedback", { props: { slug, vote } });
      } catch {
        /* analytics blocked — the UI still acknowledges the vote */
      }
      box.querySelector("[data-thanks]")?.classList.remove("hidden");
      box.querySelectorAll("[data-vote]").forEach((b) => b.setAttribute("disabled", "true"));
      btn.classList.add(
        vote === "yes"
          ? "border-green-400! text-green-700! dark:border-green-600! dark:text-green-400!"
          : "border-red-400! text-red-700! dark:border-red-600! dark:text-red-400!"
      );
    });
  });
</script>

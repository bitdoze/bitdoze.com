    mostPopular: "Most Popular",
    packages: [
      {
        name: "Premium Banner",
        description: "Stay on top of every page with maximum visibility",
        price: 300,
        period: "monthly",
        featured: true,
        features: [
          "Featured on top of every page",
          "Access to 55K+ monthly developers",
          "First-party placement, no ad scripts",
          'Link marked rel="sponsored"',
          "Live within 24 hours",
        ],
        cta: "Get Started",
      },
      {
        name: "Sidebar Placement",
        description: "Be visible in the sidebar on every article",
        price: 200,
        period: "monthly",
        featured: false,
        features: [
          "Visibility in sidebar on every article",
          "First-party placement, no ad scripts",
          "Access to 55K+ monthly developers",
          'Link marked rel="sponsored"',
          "Live within 24 hours",
        ],
        cta: "Get Started",
      },
      {

    h1Highlight: "55,000+ Developers",
    heroSub:
      "Reach 55,000+ developers and self-hosters a month with clearly labelled, first-party placements.",
    viewPackages: "View Packages",
    viewAnalytics: "View Analytics",
    stats: [
      { value: "55K+", label: "Unique visitors a month", icon: "mdi:account-group" },
      { value: "70K+", label: "Page views a month", icon: "mdi:eye" },
      { value: "930+", label: "Guides", icon: "mdi:file-document-outline" },
      { value: "3", label: "Languages", icon: "mdi:translate" },

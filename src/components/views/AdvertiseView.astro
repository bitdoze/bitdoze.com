      },
      {
        name: "Artículo Patrocinado",
        description: "Publicación permanente con un artículo dedicado",
        price: 250,
        period: "pago único",
        featured: false,
        features: [
          "Destacado durante 1 semana en portada",
          "Acceso a +55K desarrolladores mensuales",
          'Enlace marcado rel="sponsored"',
          "Publicación permanente en el sitio",
          "Etiquetado como patrocinado, revisado por Bitdoze antes de publicar",
        ],
        cta: "Comenzar",
      },
    ],
    faqHeading: "Preguntas Frecuentes",
    faqSub: "Todo lo que necesitas saber antes de comenzar",
    faqs: [
      {
        question: "¿Cuándo estará activo mi anuncio?",
        answer:
          "Una vez recibido el pago y los materiales, tu anuncio estará activo en menos de 24 horas.",
      },
      {
        question: "¿Qué información necesitan?",
        answer:
          "Necesitamos el logo de tu empresa, una breve descripción y el enlace de destino. Para artículos patrocinados, el contenido completo.",
      },
      {
        question: "¿Puedo ver las analíticas de mi anuncio?",
        answer:
          "¡Sí! Nuestro panel de analíticas es público y puedes consultar el tráfico y métricas en cualquier momento.",
      },
      {
        question: "¿Los enlaces patrocinados transmiten valor SEO?",
        answer:
          'No. Todos los enlaces de pago usan rel="sponsored". Compras alcance y clics de una audiencia técnica, no link equity.',
      },
    ],
    contactHref: "/es/contact/",
  },
  de: {
    title: "Werbung auf Bitdoze",
    description:
      "Erreiche über 55.000 Entwickler und Self-Hoster pro Monat mit klar gekennzeichneten First-Party-Platzierungen.",
    h1Prefix: "Zeig dein Business über",
    h1Highlight: "55.000+ Entwicklern",
    heroSub:
      "Erreiche über 55.000 Entwickler und Self-Hoster pro Monat mit klar gekennzeichneten First-Party-Platzierungen.",
    viewPackages: "Pakete ansehen",
    viewAnalytics: "Analytics ansehen",
    stats: [
      { value: "55K+", label: "Eindeutige Besucher pro Monat", icon: "mdi:account-group" },
      { value: "70K+", label: "Seitenaufrufe pro Monat", icon: "mdi:eye" },
      { value: "930+", label: "Anleitungen", icon: "mdi:file-document-outline" },
      { value: "3", label: "Sprachen", icon: "mdi:translate" },
    ],
    benefitsHeading: "Warum bei uns werben?",
    benefitsSub:
      "Bringe dein Produkt oder deinen Service vor Entwickler, die aktiv nach Lösungen suchen.",
    benefits: [
      {
        icon: "mdi:shield-check",
        title: "First-Party-Platzierung",
        description:
          "Platzierungen sind Teil der Seite und werden von bitdoze.com ausgeliefert. Keine Ad-Skripte, keine Tracker.",
      },
      {
        icon: "mdi:target",
        title: "Zielgenaues Publikum",
        description:
          "Erreiche Entwickler und Tech-Enthusiasten, die aktiv nach Lösungen wie deiner suchen.",
      },
      {
        icon: "mdi:link-variant",
        title: "Klar gekennzeichnet",
        description:
          'Jede Platzierung ist als Sponsored markiert und ihre Links verwenden rel="sponsored", wie von Google gefordert.',
      },
      {
        icon: "mdi:chart-areaspline",
        title: "Transparente Analytics",
        description:
          "Voller Zugriff auf unser öffentliches Analytics-Dashboard zur Erfolgsmessung.",
      },
    ],
    packagesHeading: "Werbepakete",
    packagesSub: "Wähl die Option, die am besten zu deinen Marketingzielen passt.",
    mostPopular: "Am beliebtesten",
    packages: [
      {
        name: "Header-Banner",
        description: "Prominente Sichtbarkeit oben auf jeder Seite",
        price: 300,
        period: "monatlich",
        featured: true,
        features: [
          "Featured im Header jeder Seite",
          "Zugang zu 55K+ Entwicklern monatlich",

        title: "Ubicación first-party",
        description:
          "Las ubicaciones forman parte de la página y se sirven desde bitdoze.com. Sin scripts de anuncios ni rastreadores.",
      },
      {
        icon: "mdi:target",
        title: "Audiencia especializada",
        description:
          "Conecta con ingenieros DevOps y desarrolladores que buscan herramientas reales.",
      },
      {
        icon: "mdi:link-variant",
        title: "Claramente etiquetado",

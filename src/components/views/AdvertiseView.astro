          'Link mit rel="sponsored" markiert',
          "Live in unter 24 Stunden",
        ],
        cta: "Loslegen",
      },
      {
        name: "Sidebar-Platz",
        description: "Sichtbar in der Seitenleiste aller Artikel",
        price: 200,
        period: "monatlich",

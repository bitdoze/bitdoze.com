    h1Prefix: "Promociona tu empresa ante más de",
    h1Highlight: "55.000 Desarrolladores",
    heroSub:
      "Llega a más de 55.000 desarrolladores y aficionados al self-hosting al mes con ubicaciones propias claramente etiquetadas.",
    viewPackages: "Ver Planes",
    viewAnalytics: "Ver Analíticas",
    stats: [
      { value: "55K+", label: "Visitantes únicos al mes", icon: "mdi:account-group" },

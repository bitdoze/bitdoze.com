---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import PostCard from "@components/blog/PostCard.astro";
import Pagination from "@components/common/Pagination.astro";
import AuthorBioCard from "@components/views/AuthorBioCard.astro";
import type { SupportedLocale } from "@utils/i18n";
import { serializeJsonLd } from "@utils/slugs";
import { getEntryHref } from "@utils/content";

interface Props {
  locale: SupportedLocale;
  title: string;
  metaTitle?: string;
  description: string;
  noindex?: boolean;
  hreflangs?: Array<{ lang: string; href: string }>;
  heading: string;
  /** Optional intro paragraph rendered between the heading and the count line */
  intro?: string;
  /** Count/paging line under the heading */
  subText?: string;
  emptyText: string;
  /** Posts for the current page (already paginated) */
  posts: CollectionEntry<"posts">[];
  currentPage: number;
  totalPages: number;
  prevUrl: string | null;
  nextUrl: string | null;
  basePath: string;
  /** view-transition-name applied to the h1 (e.g. "home-latest-heading") */
  viewTransitionName?: string;
  /** Optional JSON-LD object, serialized safely */
  jsonLd?: Record<string, unknown>;
  /** Optional author bio card (author archive page 1) */
  authorDetails?: CollectionEntry<"authors"> | null;
  /** Lead with a full-width featured card on page 1 */
  featured?: boolean;
  /** Hand-picked pillar posts shown as a "Start here" strip on page 1 */
  startHerePosts?: CollectionEntry<"posts">[];
}

const {
  locale,
  title,
  metaTitle,
  description,
  noindex = false,
  hreflangs,
  heading,
  intro,
  subText,
  emptyText,
  posts,
  currentPage,
  totalPages,
  prevUrl,
  nextUrl,
  basePath,
  viewTransitionName,
  jsonLd,
  authorDetails,
  featured = false,
  startHerePosts = [],
} = Astro.props;

const showFeatured = featured && currentPage === 1 && posts.length > 0;
const gridPosts = showFeatured ? posts.slice(1) : posts;
const showStartHere = startHerePosts.length > 0 && currentPage === 1;
---

<Layout
  title={title}
  metaTitle={metaTitle}
  description={description}
  noindex={noindex}
  lang={locale}
  hreflangs={hreflangs}
  preloadMono={true}
>
  {jsonLd && (
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)}></script>
  )}
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="mb-10 pb-4 border-b border-gray-200 dark:border-gray-700">
      <h1
        class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-2"
        style={viewTransitionName ? `view-transition-name: ${viewTransitionName}` : undefined}
      >
        {heading}
      </h1>
      {intro && <p class="text-base text-gray-700 dark:text-gray-300 mb-3 max-w-3xl">{intro}</p>}
      {subText && (
        <p class:list={[intro ? "text-sm" : "text-base", "text-gray-600 dark:text-gray-400"]}>
          {subText}
        </p>
      )}
    </header>

    {authorDetails && <AuthorBioCard author={authorDetails} />}

    {showStartHere && (
      <nav
        aria-label={locale === "es" ? "Empieza aquí" : "Start here"}
        class="mb-8 flex flex-wrap items-center gap-x-2 gap-y-2 rounded-lg border border-(--color-border-base) bg-(--color-bg-muted) px-4 py-3"
      >
        <span class="mr-1 font-mono text-[11px] font-semibold uppercase tracking-wider text-(--color-text-muted)">
          {locale === "es" ? "Empieza aquí:" : "Start here:"}
        </span>
        {startHerePosts.map((post, i) => (
          <>
            {i > 0 && (
              <span aria-hidden="true" class="text-(--color-border-base)">
                ·
              </span>
            )}
            <a
              href={getEntryHref(post)}
              class="text-sm font-medium text-blue-700 underline-offset-2 transition-colors hover:text-blue-800 hover:underline dark:text-blue-300 dark:hover:text-blue-200"
            >
              {post.data.title}
            </a>
          </>
        ))}
      </nav>
    )}

    {posts.length > 0 ? (
      <>
        {showFeatured && (
          <div class="mb-6">
            <PostCard post={posts[0]} featured priority headingLevel={2} />
          </div>
        )}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {gridPosts.map((post, index) => (
            <PostCard
              post={post}
              priority={currentPage === 1 && index === 0 && !showFeatured}
              headingLevel={2}
            />
          ))}
        </div>
      </>
    ) : (
      <div class="text-center py-12">
        <p class="text-gray-600 dark:text-gray-400">{emptyText}</p>
      </div>
    )}

    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
      basePath={basePath}
    />
  </div>
</Layout>

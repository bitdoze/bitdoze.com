---
import Layout from "@layouts/Layout.astro";
import { siteConfig } from "@config/site";
import { absoluteUrl } from "@utils/slugs";

interface Props {
  locale: "en" | "es";
}

const { locale } = Astro.props;

const copy = {
  en: {
    title: `Search - ${siteConfig.name}`,
    description: "Search for articles and tutorials on Bitdoze",
    heading: "Search Bitdoze",
    sub: "Find tutorials, guides, and tools across all topics",
    inputLabel: "Search articles",
    loading: "Search index is being built. Please try again later.",
    zeroResults: null,
  },
  es: {
    title: `Buscar - ${siteConfig.name}`,
    description: "Busca artículos y tutoriales en Bitdoze",
    heading: "Buscar en Bitdoze",
    sub: "Encuentra tutoriales, guías y herramientas sobre cualquier tema",
    inputLabel: "Buscar artículos",
    loading: "El índice de búsqueda se está construyendo. Intenta más tarde.",
    zeroResults: "No se encontraron resultados. Prueba otro término.",
  },
}[locale];
---

<Layout
  title={copy.title}
  description={copy.description}
  noindex={true}
  lang={locale === "es" ? "es" : undefined}
  hreflangs={[
    { lang: "en", href: absoluteUrl("/search/", Astro.site || siteConfig.url) },
    { lang: "es", href: absoluteUrl("/es/search/", Astro.site || siteConfig.url) },
    { lang: "x-default", href: absoluteUrl("/search/", Astro.site || siteConfig.url) },
  ]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="mb-8 pb-4 border-b border-gray-200 dark:border-gray-700">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-2">
        {copy.heading}
      </h1>
      <p class="text-base text-gray-600 dark:text-gray-400">{copy.sub}</p>
    </header>
    <div
      id="search"
      data-pagefind-locale={locale}
      data-search-label={copy.inputLabel}
      data-search-loading={copy.loading}
      data-search-zero={copy.zeroResults ?? ""}
      class="min-h-[320px]"
    ></div>
  </div>
</Layout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<style is:global>
  /* Theme the Pagefind UI to the site palette instead of the default purple.
     Vars must hang on .pagefind-ui itself: pagefind-ui.css re-declares them
     there, so :root-level values lose and dark mode ends up near-black on
     near-black. These rules load after the stylesheet link, so they win. */
  .pagefind-ui {
    --pagefind-ui-primary: #2563eb;
    --pagefind-ui-text: #111827;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e5e7eb;
    --pagefind-ui-tag: #f3f4f6;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.5rem;
    --pagefind-ui-font: var(--font-sans);
  }
  .dark .pagefind-ui {
    --pagefind-ui-primary: #60a5fa;
    --pagefind-ui-text: #f9fafb;
    --pagefind-ui-background: #111827;
    --pagefind-ui-border: #374151;
    --pagefind-ui-tag: #1f2937;
  }
  /* The locale filter is fixed per-page — the facet block is UI noise */
  .pagefind-ui__filter-panel {
    display: none;
  }
  .pagefind-ui__search-input {
    font-family: var(--font-sans);
  }
  .pagefind-ui__result mark,
  .pagefind-ui__result-excerpt mark {
    background-color: #dbeafe;
    color: inherit;
    padding: 0 0.1em;
    border-radius: 0.2em;
  }
  .dark .pagefind-ui__result mark,
  .dark .pagefind-ui__result-excerpt mark {
    background-color: rgba(96, 165, 250, 0.35);
  }
</style>
<script is:inline>
  (function () {
    function initPagefind() {
      var el = document.getElementById("search");
      if (!el || el.dataset.pagefindInit === "true") return;
      el.dataset.pagefindInit = "true";

      var locale = el.dataset.pagefindLocale || "en";
      var inputLabel = el.dataset.searchLabel || "Search articles";
      var script = document.createElement("script");
      script.src = "/pagefind/pagefind-ui.js";
      script.onerror = function () {
        el.innerHTML =
          '<p class="text-center text-(--color-text-muted)">' + el.dataset.searchLoading + "</p>";
      };
      script.onload = function () {
        if (typeof PagefindUI !== "undefined") {
          var translations = { placeholder: inputLabel + "…" };
          if (el.dataset.searchZero) {
            translations.zero_results = el.dataset.searchZero;
          }
          var ui = new PagefindUI({
            element: "#search",
            showSubResults: true,
            showImages: true,
            showEmptyFilters: false,
            translations: translations,
            filters: { locale: [locale] },
          });
          // Pagefind renders its own unlabeled input — give it an accessible name
          var input = el.querySelector("input.pagefind-ui__search-input");
          if (input) input.setAttribute("aria-label", inputLabel);
          // Honor ?q= (linked from the WebSite SearchAction JSON-LD)
          var q = new URLSearchParams(window.location.search).get("q");
          if (q && ui.triggerSearch) ui.triggerSearch(q);
        }
      };
      document.head.appendChild(script);
    }

    initPagefind();
  })();
</script>

---
import { Icon } from "astro-icon/components";
import Layout from "@layouts/Layout.astro";
import { siteConfig } from "@config/site";
import { t, tf } from "@i18n/ui";
import type { SupportedLocale } from "@utils/i18n";
import { formatTaxonomyLabel } from "@utils/labels";
import { formatAuthorName, taxonomyCounts, type TaxonomyField } from "@utils/archivePaths";
import { absoluteUrl, buildArchivePath } from "@utils/slugs";
import { getPostsByLocale } from "@utils/postsCache";

interface Props {
  locale: SupportedLocale;
  kind: TaxonomyField;
}

const { locale, kind } = Astro.props;

const posts = await getPostsByLocale(locale);
const items = taxonomyCounts(posts, kind).map((item) => ({
  ...item,
  display: kind === "authors" ? formatAuthorName(item.name) : formatTaxonomyLabel(item.name),
}));

const copy = {
  tags: {
    title: "tagsIndexTitle",
    description: "tagsIndexDesc",
    heading: "tags",
    sub: "tagsIndexSub",
    empty: "emptyTags",
    icon: "mdi:tag-outline",
    pill: true,
  },
  categories: {
    title: "categoriesIndexTitle",
    description: "categoriesIndexDesc",
    heading: "categories",
    sub: "categoriesIndexSub",
    empty: "emptyCategories",
    icon: "mdi:folder-outline",
    pill: false,
  },
  authors: {
    title: "authorsIndexTitle",
    description: "authorsIndexDesc",
    heading: "authors",
    sub: "authorsIndexSub",
    empty: "emptyAuthors",
    icon: "mdi:account-outline",
    pill: false,
  },
} as const;

const strings = copy[kind];
const enUrl = absoluteUrl(`/${kind}/`, Astro.site || siteConfig.url);
const esUrl = absoluteUrl(`/es/${kind}/`, Astro.site || siteConfig.url);
const hreflangs = [
  { lang: "en", href: enUrl },
  { lang: "es", href: esUrl },
  { lang: "x-default", href: enUrl },
];
---

<Layout
  title={tf(locale, strings.title, { site: siteConfig.name })}
  description={t(locale, strings.description)}
  lang={locale}
  hreflangs={hreflangs}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header
      class="mb-10 pb-4 border-b border-gray-200 dark:border-gray-700"
      style={`view-transition-name: home-explore-${kind}`}
    >
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-2">
        {t(locale, strings.heading)}
      </h1>
      <p class="text-base text-gray-600 dark:text-gray-400">{t(locale, strings.sub)}</p>
    </header>

    {strings.pill ? (
      <div class="flex flex-wrap gap-2.5">
        {items.map(({ display, count, slug }) => (
          <a
            href={buildArchivePath(kind, slug, locale)}
            class="group inline-flex items-center gap-2 px-3.5 py-2 bg-white dark:bg-gray-800 rounded-full border border-gray-200 dark:border-gray-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-blue-300 dark:hover:border-blue-700"
          >
            <span class="font-medium text-sm text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              #{display}
            </span>
            <span class="bg-blue-50 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-xs font-semibold px-2 py-0.5 rounded-full">
              {count}
            </span>
          </a>
        ))}
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {items.map(({ display, count, slug }) => (
          <a
            href={buildArchivePath(kind, slug, locale)}
            class="group flex items-center justify-between p-5 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:border-blue-300 dark:hover:border-blue-700"
          >
            <div class="flex items-center">
              <Icon
                name={strings.icon}
                class="w-5 h-5 text-blue-600 dark:text-blue-400 mr-3 shrink-0 transition-transform duration-200 group-hover:scale-110"
              />
              <span class="font-medium text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {display}
              </span>
            </div>
            <span class="bg-blue-50 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-xs font-semibold px-2.5 py-0.5 rounded-full">
              {count} {count === 1 ? t(locale, "countPostOne") : t(locale, "countPostMany")}
            </span>
          </a>
        ))}
      </div>
    )}

    {items.length === 0 && (
      <div class="text-center py-12">
        <p class="text-gray-600 dark:text-gray-400">{t(locale, strings.empty)}</p>
      </div>
    )}
  </div>
</Layout>

---
import Layout from "@layouts/Layout.astro";
import ResourceCard from "@components/widgets/ResourceCard.astro";
import resourcesData from "@config/resources.json";
import { siteConfig } from "@config/site";
import { absoluteUrl } from "@utils/slugs";

interface Props {
  locale: "en" | "es";
}

const { locale } = Astro.props;
const { resources } = resourcesData;

const groupedResources = resources.reduce(
  (acc, resource) => {
    const category = resource.category;
    if (!acc[category]) {
      acc[category] = [];
    }
    acc[category].push(resource);
    return acc;
  },
  {} as Record<string, typeof resources>
);

const sortedCategories = Object.keys(groupedResources).sort();

const copy = {
  en: {
    title: "Recommended Resources & Tools",
    pageTitle: "Recommended Resources & Tools",
    description:
      "Discover hand-picked tools and services that power our work. Get exclusive deals and free credits on the best cloud hosting, development tools, email marketing platforms, and more.",
    tool: "tool",
    tools: "tools",
    ctaHeading: "Have a Tool to Recommend?",
    ctaText: "Know a great tool or service that should be on this list? Let us know!",
    ctaLabel: "Get in Touch",
    contactHref: "/contact/",
  },
  es: {
    title: "Recursos y herramientas recomendadas",
    pageTitle: `Recursos y herramientas recomendadas - ${siteConfig.name}`,
    description:
      "Descubre herramientas seleccionadas para hosting, desarrollo, email marketing y productividad.",
    tool: "herramienta",
    tools: "herramientas",
    ctaHeading: "¿Quieres recomendar una herramienta?",
    ctaText: "Si conoces una opción genial que deba estar aquí, ¡envíanos un mensaje!",
    ctaLabel: "Contactar",
    contactHref: "/es/contact/",
  },
}[locale];
---

<Layout
  title={copy.pageTitle}
  description={copy.description}
  lang={locale === "es" ? "es" : undefined}
  hreflangs={[
    { lang: "en", href: absoluteUrl("/resources/", Astro.site || siteConfig.url) },
    { lang: "es", href: absoluteUrl("/es/resources/", Astro.site || siteConfig.url) },
    { lang: "x-default", href: absoluteUrl("/resources/", Astro.site || siteConfig.url) },
  ]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="mb-10 pb-4 border-b border-gray-200 dark:border-gray-700">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-2">
        {copy.title}
      </h1>
      <p class="text-base text-gray-600 dark:text-gray-400">{copy.description}</p>
    </header>

    <!-- Resources Section -->
    <section class="space-y-12">
      {sortedCategories.map((category) => (
        <div>
          <!-- Category Header -->
          <div class="mb-6 flex items-center justify-between border-b-2 border-blue-600 dark:border-blue-400 pb-2">
            <h2 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-white">{category}</h2>
            <span class="text-xs font-semibold text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-900/40 px-2.5 py-0.5 rounded-full">
              {groupedResources[category].length}{" "}
              {groupedResources[category].length === 1 ? copy.tool : copy.tools}
            </span>
          </div>

          <!-- Resources Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {groupedResources[category].map((resource) => (
              <div class="h-full">
                <ResourceCard resource={resource} />
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- CTA Section -->
    <section class="mt-14 pt-10 border-t border-gray-200 dark:border-gray-700 text-center">
      <h2 class="text-xl md:text-2xl font-bold tracking-tight text-gray-900 dark:text-white mb-2">
        {copy.ctaHeading}
      </h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">{copy.ctaText}</p>
      <a
        href={copy.contactHref}
        class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-all duration-200 shadow-md hover:shadow-lg hover:-translate-y-px"
      >
        {copy.ctaLabel}
      </a>
    </section>
  </div>
</Layout>



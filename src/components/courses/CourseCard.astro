---
import { Icon } from "astro-icon/components";
import { courseHref, lessonThumbnail, type Course } from "@utils/courses";

interface Props {
  course: Course;
}

const { course } = Astro.props;
const cover = course.lessons[0];
---

<a
  href={courseHref(course)}
  class="group flex h-full flex-col overflow-hidden rounded-lg bg-white shadow-[0_4px_6px_rgba(0,0,0,0.07)] transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_10px_15px_rgba(0,0,0,0.08)] dark:bg-gray-800 dark:shadow-[0_4px_6px_rgba(0,0,0,0.15)] dark:hover:shadow-[0_10px_15px_rgba(0,0,0,0.2)]"
>
  <div class="relative aspect-video overflow-hidden bg-gray-900">
    <img
      src={cover ? lessonThumbnail(cover) : "/images/youtube-placeholder.jpg"}
      alt={course.title}
      width="320"
      height="180"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <span
      class="absolute inset-0 flex items-center justify-center bg-gray-950/20 transition-colors duration-300 group-hover:bg-gray-950/30"
    >
      <Icon
        name="mdi:play-circle"
        class="h-14 w-14 text-white drop-shadow-md transition-transform duration-200 group-hover:scale-110"
      />
    </span>
    {course.badge && (
      <span class="absolute left-3 top-3 rounded-full bg-blue-600 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-white shadow-sm">
        {course.badge}
      </span>
    )}
    <span class="absolute bottom-3 right-3 inline-flex items-center gap-1 rounded-md bg-gray-950/75 px-2 py-1 font-mono text-xs font-medium text-white">
      <Icon name="mdi:playlist-play" class="h-3.5 w-3.5" />
      {course.lessons.length} lessons
    </span>
  </div>

  <div class="flex grow flex-col p-5">
    <h2 class="text-lg font-bold leading-snug tracking-tight text-gray-900 group-hover:text-blue-700 dark:text-white dark:group-hover:text-blue-400">
      {course.title}
    </h2>
    <p class="mt-2 grow text-sm leading-relaxed text-gray-600 line-clamp-3 dark:text-gray-300">
      {course.description}
    </p>
    <div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-4 dark:border-gray-700">
      {course.level && (
        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 dark:text-gray-400">
          <Icon name="mdi:signal-cellular-2" class="h-4 w-4 text-blue-600 dark:text-blue-400" />
          {course.level}
        </span>
      )}
      <span class="inline-flex items-center gap-1 text-sm font-semibold text-blue-600 dark:text-blue-400">
        Start course
        <Icon
          name="mdi:arrow-right"
          class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
        />
      </span>
    </div>
  </div>
</a>

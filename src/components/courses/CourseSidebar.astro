---
import { Icon } from "astro-icon/components";
import { courseHref, lessonHref, lessonSlug, type Course } from "@utils/courses";

interface Props {
  course: Course;
  currentSlug: string;
}

const { course, currentSlug } = Astro.props;
const total = course.lessons.length;
---

{/*
  One <aside> serving both layouts:
  - < lg: fixed right-edge drawer, translated off-canvas until [data-open]
  - lg+: sticky column inside the page grid
  `invisible` keeps it out of the tab order while closed on mobile.
*/}
<aside
  id="course-chapters"
  data-chapters-panel
  data-course-progress
  data-total={total}
  aria-label="Course chapters"
  class="invisible fixed inset-y-0 right-0 z-50 flex w-[86vw] max-w-sm translate-x-full flex-col bg-white shadow-2xl transition-[transform,visibility] duration-300 ease-out data-[open=true]:visible data-[open=true]:translate-x-0 dark:bg-gray-900 lg:visible lg:sticky lg:top-20 lg:z-auto lg:w-auto lg:max-w-none lg:translate-x-0 lg:rounded-xl lg:bg-gray-50 lg:shadow-none lg:dark:bg-gray-800/50 lg:max-h-[calc(100dvh-6rem)]"
>
  <div class="flex items-start justify-between gap-3 border-b border-gray-200 px-4 py-4 dark:border-gray-700">
    <div class="min-w-0">
      <p class="text-xs font-semibold uppercase tracking-wide text-blue-700 dark:text-blue-300">
        Course
      </p>
      <a
        href={courseHref(course)}
        class="mt-0.5 block text-sm font-bold leading-snug text-gray-900 transition-colors hover:text-blue-700 dark:text-white dark:hover:text-blue-400"
      >
        {course.title}
      </a>
      <div class="mt-2.5 flex items-center gap-2">
        <div
          class="h-1.5 w-24 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700"
          role="progressbar"
          aria-label="Course progress"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          data-progress-track
        >
          <div
            data-progress-fill
            class="h-full rounded-full bg-blue-600 transition-[width] duration-500"
            style="width: 0%"
          ></div>
        </div>
        <span data-progress-label class="text-xs text-gray-500 dark:text-gray-400">
          0/{total} watched
        </span>
      </div>
    </div>
    <button
      type="button"
      data-chapters-close
      aria-label="Close chapter list"
      class="-mr-1 -mt-1 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white lg:hidden"
    >
      <Icon name="mdi:close" class="h-5 w-5" />
    </button>
  </div>

  <ol class="min-h-0 flex-1 space-y-0.5 overflow-y-auto px-3 py-3">
    {course.lessons.map((lesson, index) => {
      const slug = lessonSlug(lesson);
      const isCurrent = slug === currentSlug;
      return (
        <li>
          <a
            href={lessonHref(course, lesson)}
            data-lesson-item
            data-slug={slug}
            data-current={isCurrent || undefined}
            aria-current={isCurrent ? "page" : undefined}
            class:list={[
              "group flex items-start gap-3 rounded-md px-3 py-2.5 transition-colors duration-200",
              isCurrent
                ? "bg-blue-50 dark:bg-blue-950/40"
                : "hover:bg-gray-100 dark:hover:bg-gray-800",
            ]}
          >
            <span
              class:list={[
                "lesson-badge mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full font-mono text-xs font-semibold",
                isCurrent
                  ? "bg-blue-600 text-white"
                  : "bg-gray-200 text-gray-600 dark:bg-gray-700 dark:text-gray-300",
              ]}
            >
              {isCurrent ? (
                <Icon name="mdi:play" class="h-3.5 w-3.5" />
              ) : (
                <>
                  <span data-num>{index + 1}</span>
                  <Icon data-check name="mdi:check" class="hidden h-3.5 w-3.5" />
                </>
              )}
            </span>
            <span class="min-w-0 grow">
              <span
                class:list={[
                  "block text-sm font-medium leading-snug line-clamp-2",
                  isCurrent
                    ? "text-blue-700 dark:text-blue-300"
                    : "text-gray-700 group-hover:text-blue-700 dark:text-gray-300 dark:group-hover:text-blue-400",
                ]}
              >
                {lesson.title}
              </span>
              {lesson.duration && (
                <span class="mt-0.5 block font-mono text-xs text-gray-400 dark:text-gray-500">
                  {lesson.duration}
                </span>
              )}
            </span>
          </a>
        </li>
      );
    })}
  </ol>

  {course.playlist && (
    <div class="border-t border-gray-200 px-4 py-3 dark:border-gray-700">
      <a
        href={course.playlist}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-xs font-semibold text-gray-600 transition-colors hover:text-blue-700 dark:text-gray-400 dark:hover:text-blue-400"
      >
        <Icon name="mdi:youtube" class="h-4 w-4 text-red-600" />
        Open playlist on YouTube
      </a>
    </div>
  )}
</aside>

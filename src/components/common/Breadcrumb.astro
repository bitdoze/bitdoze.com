---
import { Icon } from 'astro-icon/components';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
  className?: string;
  /** Hide the last (current page) item, e.g. when the page title sits right below. */
  showCurrent?: boolean;
}

const { items, className = "", showCurrent = true } = Astro.props;
const visibleItems = showCurrent ? items : items.slice(0, -1);
---

<nav aria-label="Breadcrumb" class={`breadcrumb ${className}`}>
  <ol class="breadcrumb-list">
    {visibleItems.map((item, index) => {
      const isLast = index === visibleItems.length - 1;
      return (
        <li class="breadcrumb-item">
          {index > 0 && (
            <Icon name="mdi:chevron-right" class="breadcrumb-separator" aria-hidden="true" />
          )}
          {isLast && showCurrent ? (
            <span class="breadcrumb-current" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a
              href={item.url}
              class:list={["breadcrumb-link", isLast && "breadcrumb-link--section"]}
            >
              {index === 0 && (
                <Icon name="mdi:home" class="breadcrumb-home-icon" aria-hidden="true" />
              )}
              <span class:list={[index === 0 && "sr-only sm:not-sr-only"]}>{item.name}</span>
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumb {
    margin-bottom: 1.5rem;
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.125rem;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    list-style: none;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .breadcrumb-list::-webkit-scrollbar {
    display: none;
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .breadcrumb-separator {
    width: 1rem;
    height: 1rem;
    margin: 0 0.125rem;
    color: var(--color-text-subtle);
    flex-shrink: 0;
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.125rem 0.25rem;
    color: var(--color-text-muted);
    font-weight: 500;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .breadcrumb-link:hover {
    color: var(--color-primary-600);
  }

  .breadcrumb-link--section {
    color: var(--color-primary-700);
    font-weight: 600;
  }

  :global(.dark) .breadcrumb-link:hover,
  :global(.dark) .breadcrumb-link--section {
    color: var(--color-primary-400);
  }

  .breadcrumb-home-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .breadcrumb-current {
    display: block;
    padding: 0.125rem 0.25rem;
    color: var(--color-text-muted);
    font-weight: 400;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

---
import ThemeToggle from "./ThemeToggle.astro";
import { Icon } from "astro-icon/components";
import menu from "@config/menu.json";
import logoSVG from "@assets/favicons/bitdoze_logo_better.svg";
import { t, translateMenuLabel } from "@i18n/ui";
import { getLocaleFromPathname } from "@utils/i18n";
import { isExternalUrl, localizeInternalPath } from "@utils/localeRoutes";
import { resolveLanguageSwitchPath } from "@utils/translationMap";

// Extract main menu items
const currentPath = Astro.url.pathname;
const locale = getLocaleFromPathname(currentPath);
const targetLocale = locale === "en" ? "es" : "en";

const ui = {
  search: t(locale, "search"),
  searchAria: t(locale, "searchAria"),
  openMenu: t(locale, "openMenu"),
  closeMenu: t(locale, "closeMenu"),
  switchLang: t(locale, "switchLang"),
  switchToLang: t(locale, "switchToLang"),
  noEsTranslation: t(locale, "noEsTranslation"),
  noEnTranslation: t(locale, "noEnTranslation"),
  logoAlt: t(locale, "logoAlt"),
};

const localizeUrl = (url: string): string =>
  !url || isExternalUrl(url) ? url : localizeInternalPath(url, locale);

// `locales` on a menu item restricts it to those locales (e.g. Self-Hosted
// has no ES route, so it stays out of the ES header entirely).
const localeAllowed = (item: unknown) => {
  const locales = (item as { locales?: string[] }).locales;
  return !locales || locales.includes(locale);
};

const mainMenu = menu.main.filter(localeAllowed).map((item) => ({
  ...item,
  name: translateMenuLabel(locale, item.name),
  url: localizeUrl(item.url),
  children: item.children?.filter(localeAllowed).map((child) => ({
    ...child,
    name: translateMenuLabel(locale, child.name),
    url: localizeUrl(child.url),
  })),
}));

// Lightweight translation index (cached for the build) instead of full collection scan
const langSwitch = await resolveLanguageSwitchPath(currentPath, targetLocale);
const languageSwitchPath = langSwitch.path || localizeInternalPath(currentPath, targetLocale);
const languageSwitchTitle = langSwitch.hasTranslation
  ? ui.switchToLang
  : locale === "en"
    ? ui.noEsTranslation
    : ui.noEnTranslation;
---

<header class="header-nav sticky top-0 z-40 w-full backdrop-blur-lg">
  <div class="container mx-auto flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <div class="flex shrink-0 items-center">
      <a href={locale === "es" ? "/es/" : "/"} class="logo-link flex items-center gap-2 group">
        <img
          src={logoSVG.src}
          alt={ui.logoAlt}
          width="140"
          height="35"
          class="h-8 w-auto transition-transform duration-300 group-hover:scale-105"
          loading="eager"
          decoding="async"
        />
      </a>
    </div>

    <!-- Navigation (desktop bar only at xl+; below that the hamburger owns nav) -->
    <nav class="hidden xl:flex items-center space-x-2">
      {mainMenu.map((item, index) => {
        const submenuId = `desktop-submenu-${index}`;
        if (item.hasChildren) {
          return (
            <div class="relative dropdown">
              <button
                class="nav-item flex items-center relative px-4 py-2 text-sm font-medium rounded-lg transition-all duration-300 ease-in-out group dropdown-toggle text-(--color-text-muted) hover:text-blue-600 dark:hover:text-blue-400"
                aria-expanded="false"
                aria-controls={submenuId}
              >
                <span class="relative z-10">{item.name}</span>
                <Icon
                  name="mdi:chevron-down"
                  class="ml-1 h-4 w-4 transition-transform duration-200 dropdown-icon"
                />
                <div class="nav-bg absolute inset-0 rounded-lg opacity-0 transition-all duration-300 ease-in-out group-hover:opacity-100 bg-blue-500/10" />
              </button>
              <div
                id={submenuId}
                class="absolute left-0 mt-2 w-48 rounded-md shadow-lg bg-white dark:bg-gray-800 border border-(--color-border-base) dark:border-gray-700 hidden dropdown-menu transition-all duration-300 opacity-0 z-10"
              >
                <div class="py-1 rounded-md">
                  {item.children?.map((child) => (
                    <a
                      href={child.url}
                      class="block px-4 py-2 text-sm text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition-all duration-200"
                    >
                      {child.name}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
        } else if (item.highlight) {
          // Special highlighted link (Advertise) - matches hero CTA style
          return (
            <a
              href={item.url}
              class="nav-item-highlight relative px-4 py-2 text-sm font-semibold rounded-lg transition-colors duration-200 text-blue-700 ring-1 ring-inset ring-blue-200 hover:bg-blue-50 hover:ring-blue-300 dark:text-blue-300 dark:ring-blue-800 dark:hover:bg-blue-950/40"
            >
              <span class="relative z-10 flex items-center gap-1.5">
                <Icon name="mdi:star" class="w-4 h-4" />
                {item.name}
              </span>
            </a>
          );
        } else {
          const isActive =
            currentPath === item.url ||
            (item.url !== "/" && currentPath.startsWith(item.url + "/")) ||
            (item.url !== "/" && currentPath === item.url);
          return (
            <a
              href={item.url}
              class={`nav-item relative px-4 py-2 text-sm font-medium rounded-lg transition-all duration-300 ease-in-out group ${
                isActive
                  ? "text-blue-700 dark:text-blue-400"
                  : "text-(--color-text-muted) hover:text-blue-600 dark:hover:text-blue-400"
              }`}
              aria-current={isActive ? "page" : undefined}
              data-active={isActive ? "true" : "false"}
            >
              <span class="relative z-10">{item.name}</span>
              <div class="nav-bg absolute inset-0 rounded-lg opacity-0 transition-all duration-300 ease-in-out group-hover:opacity-100 bg-blue-500/10" />
              <div class="nav-indicator absolute bottom-0 left-1/2 h-0.5 w-0 rounded-full transition-all duration-300 ease-in-out group-hover:w-3/4 group-hover:-translate-x-1/2 bg-blue-600" />
            </a>
          );
        }
      })}
      <!-- Search Icon -->
      <a
        href={localizeInternalPath("/search/", locale)}
        class="nav-item relative p-2 rounded-lg transition-all duration-300 ease-in-out group text-(--color-text-muted) hover:text-blue-600 dark:hover:text-blue-400"
        aria-label={ui.searchAria}
      >
        <Icon name="mdi:magnify" class="h-5 w-5 relative z-10" />
        <div class="nav-bg absolute inset-0 rounded-lg opacity-0 transition-all duration-300 ease-in-out group-hover:opacity-100 bg-blue-500/10" />
      </a>
      <a
        href={languageSwitchPath}
        class="nav-item relative px-3 py-2 text-xs font-semibold rounded-lg transition-all duration-300 ease-in-out group border border-(--color-border-base) dark:border-gray-700 text-(--color-text-muted) hover:text-blue-600 dark:hover:text-blue-400"
        aria-label={ui.switchToLang}
        title={languageSwitchTitle}
      >
        <span class="relative z-10">{targetLocale.toUpperCase()}</span>
      </a>
      <ThemeToggle id="themeToggle-desktop" locale={locale} />
    </nav>

    <!-- Mobile menu button -->
    <div class="flex xl:hidden items-center gap-2">
      <ThemeToggle id="themeToggle-mobile-header" locale={locale} />
      <button
        type="button"
        id="mobile-menu-button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="mobile-menu-btn inline-flex items-center justify-center p-3 rounded-lg min-h-12 min-w-12 transition-all duration-300 ease-in-out hover:scale-105 active:scale-95 focus:outline-none bg-black/5 dark:bg-white/5"
        data-label-open={ui.openMenu}
        data-label-close={ui.closeMenu}
      >
        <span class="sr-only" data-menu-label>
          {ui.openMenu}
        </span>
        <div class="hamburger relative w-6 h-6 flex flex-col justify-center items-center">
          <span
            class="hamburger-line w-5 h-0.5 rounded-full transition-all duration-300 bg-gray-600 dark:bg-gray-300"
            style="transform: translateY(-2px);"
          ></span>
          <span class="hamburger-line w-5 h-0.5 rounded-full transition-all duration-300 mt-1 bg-gray-600 dark:bg-gray-300"></span>
          <span
            class="hamburger-line w-5 h-0.5 rounded-full transition-all duration-300 mt-1 bg-gray-600 dark:bg-gray-300"
            style="transform: translateY(2px);"
          ></span>
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="mobile-menu fixed top-16 left-0 right-0 hidden xl:hidden transition-all duration-500 ease-in-out transform -translate-y-2 opacity-0 z-50 bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700 shadow-lg"
    style="display: none;"
    inert
  >
    <div class="space-y-1 p-6">
      {mainMenu.map((item, index) => {
        const submenuId = `mobile-submenu-${index}`;
        if (item.hasChildren) {
          return (
            <div class="mobile-dropdown">
              <button
                class="mobile-dropdown-button group flex w-full px-4 py-4 text-base font-medium rounded-xl transition-all duration-300 min-h-12 items-center justify-between relative overflow-hidden"
                style={`animation-delay: ${index * 50}ms;`}
                aria-expanded="false"
                aria-controls={submenuId}
              >
                <span class="relative z-10 transition-transform duration-300 group-hover:translate-x-1">
                  {item.name}
                </span>
                <Icon
                  name="mdi:chevron-down"
                  class="mobile-dropdown-icon w-5 h-5 transition-all duration-300 text-blue-500"
                />
                <div class="absolute inset-0 opacity-0 transition-all duration-300 rounded-xl group-hover:opacity-100 bg-blue-500/10" />
              </button>
              <div id={submenuId} class="mobile-dropdown-content hidden pl-4 py-2 space-y-1">
                {item.children?.map((child) => (
                  <a
                    href={child.url}
                    class="mobile-menu-item group flex px-4 py-3 text-base font-medium rounded-xl transition-all duration-300 min-h-12 items-center justify-between relative overflow-hidden"
                  >
                    <span class="relative z-10 transition-transform duration-300 group-hover:translate-x-1">
                      {child.name}
                    </span>
                    <Icon
                      name="mdi:chevron-right"
                      class="w-5 h-5 opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-1 text-blue-500"
                    />
                    <div class="absolute inset-0 opacity-0 transition-all duration-300 rounded-xl group-hover:opacity-100 bg-blue-500/10" />
                  </a>
                ))}
              </div>
            </div>
          );
        } else if (item.highlight) {
          // Special highlighted link (Advertise) for mobile - matches hero CTA style
          return (
            <a
              href={item.url}
              class="mobile-menu-item-highlight group flex px-4 py-4 text-base font-semibold rounded-xl transition-colors duration-200 min-h-12 items-center justify-between text-blue-700 ring-1 ring-inset ring-blue-200 hover:bg-blue-50 dark:text-blue-300 dark:ring-blue-800 dark:hover:bg-blue-950/40"
              style={`animation-delay: ${index * 50}ms;`}
            >
              <span class="relative z-10 transition-transform duration-300 group-hover:translate-x-1 flex items-center gap-2">
                <Icon name="mdi:star" class="w-5 h-5" />
                {item.name}
              </span>
              <Icon
                name="mdi:chevron-right"
                class="w-5 h-5 opacity-70 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-1"
              />
            </a>
          );
        } else {
          const isActive =
            currentPath === item.url ||
            (item.url !== "/" && currentPath.startsWith(item.url + "/")) ||
            (item.url !== "/" && currentPath === item.url);
          return (
            <a
              href={item.url}
              class="mobile-menu-item group flex px-4 py-4 text-base font-medium rounded-xl transition-all duration-300 min-h-12 items-center justify-between relative overflow-hidden"
              style={`animation-delay: ${index * 50}ms;`}
              aria-current={isActive ? "page" : undefined}
              data-active={isActive ? "true" : "false"}
            >
              <span class="relative z-10 transition-transform duration-300 group-hover:translate-x-1">
                {item.name}
              </span>
              <Icon
                name="mdi:chevron-right"
                class="w-5 h-5 opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-1 text-blue-500"
              />
              <div class="absolute inset-0 opacity-0 transition-all duration-300 rounded-xl group-hover:opacity-100 bg-blue-500/10" />
            </a>
          );
        }
      })}
      <a
        href={localizeInternalPath("/search/", locale)}
        class="mobile-menu-item group flex px-4 py-4 text-base font-medium rounded-xl transition-all duration-300 min-h-12 items-center justify-between relative overflow-hidden"
      >
        <span class="relative z-10 transition-transform duration-300 group-hover:translate-x-1 flex items-center gap-2">
          <Icon name="mdi:magnify" class="h-5 w-5" />
          {ui.search}
        </span>
        <Icon
          name="mdi:chevron-right"
          class="w-5 h-5 opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-1 text-blue-500"
        />
        <div class="absolute inset-0 opacity-0 transition-all duration-300 rounded-xl group-hover:opacity-100 bg-blue-500/10" />
      </a>
      <a
        href={languageSwitchPath}
        class="mobile-menu-item group flex px-4 py-4 text-base font-medium rounded-xl transition-all duration-300 min-h-12 items-center justify-between relative overflow-hidden"
        title={languageSwitchTitle}
      >
        <span class="relative z-10 transition-transform duration-300 group-hover:translate-x-1">
          {ui.switchToLang}
        </span>
      </a>
    </div>
  </div>
</header>

<script>
  (() => {
    const win = window as Window & {
      __bitdozeHeaderCleanup?: () => void;
    };

    function initHeader() {
      win.__bitdozeHeaderCleanup?.();
      const controller = new AbortController();
      const { signal } = controller;
      let closeMenuTimeout = 0;

      win.__bitdozeHeaderCleanup = () => {
        controller.abort();
        if (closeMenuTimeout) {
          window.clearTimeout(closeMenuTimeout);
        }
      };

      const menuButton = document.getElementById("mobile-menu-button");
      const mobileMenu = document.getElementById("mobile-menu");

      if (menuButton && mobileMenu) {
        const menuLabel = menuButton.querySelector("[data-menu-label]");

        const setMenuButtonLabel = (open: boolean) => {
          const label = open ? menuButton.dataset.labelClose : menuButton.dataset.labelOpen;
          if (label && menuLabel) menuLabel.textContent = label;
        };

        const toggleMobileMenu = () => {
          if (closeMenuTimeout) {
            window.clearTimeout(closeMenuTimeout);
          }

          const lines = menuButton.querySelectorAll(".hamburger-line");
          const [lineTop, lineMiddle, lineBottom] = Array.from(lines);
          const expanded = menuButton.getAttribute("aria-expanded") === "true";
          const isOpening = !expanded;

          menuButton.setAttribute("aria-expanded", String(isOpening));
          setMenuButtonLabel(isOpening);

          if (isOpening) {
            mobileMenu.style.display = "block";
            mobileMenu.classList.remove("hidden");
            mobileMenu.inert = false;
            // Lock background scroll while the menu is open — html too, since
            // iOS Safari ignores body-only overflow locks
            document.documentElement.style.overflow = "hidden";
            document.body.style.overflow = "hidden";
            requestAnimationFrame(() => {
              mobileMenu.classList.remove("-translate-y-2", "opacity-0");
              mobileMenu.classList.add("translate-y-0", "opacity-100");
            });

            if (lineTop instanceof HTMLElement) {
              lineTop.style.transform = "rotate(45deg) translateY(3px)";
            }
            if (lineMiddle instanceof HTMLElement) {
              lineMiddle.style.opacity = "0";
            }
            if (lineBottom instanceof HTMLElement) {
              lineBottom.style.transform = "rotate(-45deg) translateY(-3px)";
            }

            // Move focus inside the menu once it is visible
            window.setTimeout(() => {
              const firstLink = mobileMenu.querySelector<HTMLElement>("a, button");
              firstLink?.focus();
            }, 100);
          } else {
            mobileMenu.classList.remove("translate-y-0", "opacity-100");
            mobileMenu.classList.add("-translate-y-2", "opacity-0");
            mobileMenu.inert = true;
            document.documentElement.style.overflow = "";
            document.body.style.overflow = "";

            if (lineTop instanceof HTMLElement) {
              lineTop.style.transform = "translateY(-2px)";
            }
            if (lineMiddle instanceof HTMLElement) {
              lineMiddle.style.opacity = "1";
            }
            if (lineBottom instanceof HTMLElement) {
              lineBottom.style.transform = "translateY(2px)";
            }

            closeMenuTimeout = window.setTimeout(() => {
              mobileMenu.classList.add("hidden");
              mobileMenu.style.display = "none";
            }, 500);
          }
        };

        menuButton.addEventListener("click", toggleMobileMenu, { signal });

        const mobileMenuItems = mobileMenu.querySelectorAll(".mobile-menu-item");
        mobileMenuItems.forEach((item) => {
          item.addEventListener(
            "click",
            () => {
              if (menuButton.getAttribute("aria-expanded") === "true") {
                toggleMobileMenu();
              }
            },
            { signal }
          );
        });

        // Escape key to close mobile menu
        document.addEventListener(
          "keydown",
          (event) => {
            if (event.key === "Escape" && menuButton.getAttribute("aria-expanded") === "true") {
              toggleMobileMenu();
              menuButton.focus();
            }
          },
          { signal }
        );

        // Focus trap when mobile menu is open
        mobileMenu.addEventListener(
          "keydown",
          (event) => {
            if (event.key !== "Tab" || menuButton.getAttribute("aria-expanded") !== "true") return;

            const focusable = mobileMenu.querySelectorAll<HTMLElement>(
              'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
            );
            if (focusable.length === 0) return;

            const first = focusable[0];
            const last = focusable[focusable.length - 1];

            if (event.shiftKey) {
              if (document.activeElement === first || document.activeElement === menuButton) {
                event.preventDefault();
                last.focus();
              }
            } else {
              if (document.activeElement === last) {
                event.preventDefault();
                first.focus();
              }
            }
          },
          { signal }
        );
      }

      const mobileDropdownButtons = document.querySelectorAll(".mobile-dropdown-button");

      mobileDropdownButtons.forEach((button) => {
        if (button instanceof HTMLElement) {
          button.addEventListener(
            "click",
            () => {
              const content = button.nextElementSibling;
              const icon = button.querySelector(".mobile-dropdown-icon");
              const expanded = button.getAttribute("aria-expanded") === "true";

              if (content instanceof HTMLElement) {
                content.classList.toggle("hidden");
              }
              if (icon instanceof HTMLElement) {
                icon.classList.toggle("rotate-180");
              }
              button.setAttribute("aria-expanded", String(!expanded));
            },
            { signal }
          );
        }
      });

      const header = document.querySelector(".header-nav");
      if (header instanceof HTMLElement) {
        const onScroll = () => {
          header.classList.toggle("is-scrolled", window.scrollY > 100);
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true, signal });
      }

      const dropdownToggles = document.querySelectorAll(".dropdown-toggle");
      const dropdowns = document.querySelectorAll(".dropdown");

      const closeAllDropdowns = () => {
        document.querySelectorAll(".dropdown-menu").forEach((menu) => {
          menu.classList.add("hidden");
          menu.classList.remove("opacity-100");
          menu.classList.add("opacity-0");
        });
        dropdownToggles.forEach((toggle) => {
          toggle.setAttribute("aria-expanded", "false");
          const icon = toggle.querySelector(".dropdown-icon");
          if (icon instanceof HTMLElement) {
            icon.classList.remove("rotate-180");
          }
        });
      };

      document.addEventListener(
        "click",
        (event) => {
          const target = event.target;
          if (target instanceof Element && !target.closest(".dropdown")) {
            closeAllDropdowns();
          }
        },
        { signal }
      );

      dropdownToggles.forEach((toggle) => {
        toggle.addEventListener(
          "click",
          (event) => {
            event.stopPropagation();
            const dropdown = toggle.closest(".dropdown");
            if (!(dropdown instanceof HTMLElement)) return;

            const menu = dropdown.querySelector(".dropdown-menu");
            const icon = toggle.querySelector(".dropdown-icon");
            const isExpanded = toggle.getAttribute("aria-expanded") === "true";

            dropdownToggles.forEach((otherToggle) => {
              if (otherToggle !== toggle) {
                otherToggle.setAttribute("aria-expanded", "false");
                const otherIcon = otherToggle.querySelector(".dropdown-icon");
                if (otherIcon instanceof HTMLElement) {
                  otherIcon.classList.remove("rotate-180");
                }
                const otherDropdown = otherToggle.closest(".dropdown");
                if (otherDropdown instanceof HTMLElement) {
                  const otherMenu = otherDropdown.querySelector(".dropdown-menu");
                  if (otherMenu instanceof HTMLElement) {
                    otherMenu.classList.add("hidden");
                    otherMenu.classList.remove("opacity-100");
                    otherMenu.classList.add("opacity-0");
                  }
                }
              }
            });

            if (isExpanded) {
              toggle.setAttribute("aria-expanded", "false");
              if (menu instanceof HTMLElement) {
                menu.classList.add("hidden");
                menu.classList.remove("opacity-100");
                menu.classList.add("opacity-0");
              }
              if (icon instanceof HTMLElement) {
                icon.classList.remove("rotate-180");
              }
            } else {
              toggle.setAttribute("aria-expanded", "true");
              if (menu instanceof HTMLElement) {
                menu.classList.remove("hidden");
                window.setTimeout(() => {
                  if (menu instanceof HTMLElement) {
                    menu.classList.remove("opacity-0");
                    menu.classList.add("opacity-100");
                  }
                }, 10);
              }
              if (icon instanceof HTMLElement) {
                icon.classList.add("rotate-180");
              }
            }
          },
          { signal }
        );

        toggle.addEventListener(
          "keydown",
          (event) => {
            if (event instanceof KeyboardEvent) {
              if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                toggle.dispatchEvent(new Event("click", { bubbles: true }));
              }
            }
          },
          { signal }
        );
      });

      // Close a dropdown when focus leaves it (fixes keyboard users tabbing past)
      // and when Escape is pressed anywhere inside it.
      dropdowns.forEach((dropdown) => {
        dropdown.addEventListener(
          "focusout",
          (event) => {
            if (
              event instanceof FocusEvent &&
              event.relatedTarget instanceof Node &&
              dropdown.contains(event.relatedTarget)
            ) {
              return;
            }
            const menu = dropdown.querySelector(".dropdown-menu");
            const toggle = dropdown.querySelector(".dropdown-toggle");
            const icon = dropdown.querySelector(".dropdown-icon");
            if (menu instanceof HTMLElement) {
              menu.classList.add("hidden");
              menu.classList.remove("opacity-100");
              menu.classList.add("opacity-0");
            }
            toggle?.setAttribute("aria-expanded", "false");
            icon?.classList.remove("rotate-180");
          },
          { signal }
        );

        dropdown.addEventListener(
          "keydown",
          (event) => {
            if (event instanceof KeyboardEvent && event.key === "Escape") {
              const toggle = dropdown.querySelector(".dropdown-toggle");
              closeAllDropdowns();
              if (toggle instanceof HTMLElement) toggle.focus();
            }
          },
          { signal }
        );
      });
    }

    initHeader();
  })();
</script>

<style>
  /* Header enhancements */
  .header-nav {
    transition:
      background-color 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    height: 64px;
    min-height: 64px;
    max-height: 64px;
    overflow: visible;
    background-color: rgba(255, 255, 255, 0.85);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .header-nav.is-scrolled {
    background-color: rgba(255, 255, 255, 0.95);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  :global(.dark) .header-nav {
    background-color: rgba(17, 24, 39, 0.85);
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  :global(.dark) .header-nav.is-scrolled {
    background-color: rgba(17, 24, 39, 0.95);

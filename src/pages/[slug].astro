---
import Layout from "@layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { getEntrySlug } from "@utils/content";
// Import all widget components for MDX files
import { mdxComponents } from "@components/mdx-components";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  const slugs = pages.map((page) => getEntrySlug(page)).filter((slug) => slug !== "404");

  // A post slugged like a pages entry (e.g. "privacy") would be silently
  // shadowed by this route — fail the build instead of shipping a hidden post.
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const collisions = posts.map((post) => getEntrySlug(post)).filter((slug) => slugs.includes(slug));
  if (collisions.length > 0) {
    throw new Error(`Post slugs collide with pages routes: ${collisions.join(", ")}`);
  }

  return pages
    .filter((page) => getEntrySlug(page) !== "404")
    .map((page) => ({
      params: { slug: getEntrySlug(page) },
      props: { page },
    }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const { title, meta_title, description, image } = page.data;
---

<Layout title={title} metaTitle={meta_title} description={description} image={image}>
  <section class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">{title}</h1>

        <div class="prose prose-lg dark:prose-invert max-w-none">
          <Content components={mdxComponents} />
        </div>
      </div>
    </div>
  </section>
</Layout>

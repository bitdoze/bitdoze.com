---
import Layout from "@layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { getEntrySlug } from "@utils/content";
import { absoluteUrl } from "@utils/slugs";
// Import all widget components for MDX files
import { mdxComponents } from "@components/mdx-components";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  const slugs = pages.map((page) => getEntrySlug(page)).filter((slug) => slug !== "404");

  // A post slugged like a pages entry (e.g. "privacy") would be silently
  // shadowed by this route — fail the build instead of shipping a hidden post.
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const collisions = posts.map((post) => getEntrySlug(post)).filter((slug) => slugs.includes(slug));
  if (collisions.length > 0) {
    throw new Error(`Post slugs collide with pages routes: ${collisions.join(", ")}`);
  }

  return pages
    .filter((page) => getEntrySlug(page) !== "404")
    .map((page) => ({
      params: { slug: getEntrySlug(page) },
      props: { page },
    }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const { title, meta_title, description, image } = page.data;
const pageSlug = getEntrySlug(page);
const base = Astro.site || "https://www.bitdoze.com";

// ES twins are hand-written .astro pages (es/terms.astro, es/privacy.astro).
const ES_SHARED_PAGES = new Set(["terms", "privacy"]);
const hreflangs = ES_SHARED_PAGES.has(pageSlug)
  ? [
      { lang: "en", href: absoluteUrl(`/${pageSlug}/`, base) },
      { lang: "es", href: absoluteUrl(`/es/${pageSlug}/`, base) },
      { lang: "x-default", href: absoluteUrl(`/${pageSlug}/`, base) },
    ]
  : undefined;
---

<Layout
  title={title}
  metaTitle={meta_title}
  description={description}
  image={image}
  hreflangs={hreflangs}
>
  <section class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">{title}</h1>

        <div class="prose prose-lg dark:prose-invert max-w-none">
          <Content components={mdxComponents} />
        </div>
      </div>
    </div>
  </section>
</Layout>

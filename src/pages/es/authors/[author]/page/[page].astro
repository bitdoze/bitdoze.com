---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import PostArchiveView from "@components/views/PostArchiveView.astro";
import { siteConfig } from "@config/site";
import { t, tf } from "@i18n/ui";
import { formatAuthorName, getTaxonomyPagePaths } from "@utils/archivePaths";
import { getPagination } from "@utils/pagination";
import { buildArchivePath, toTaxonomySlug } from "@utils/slugs";

const locale = "es";

export const getStaticPaths = (() =>
  getTaxonomyPagePaths("authors", "es")) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { name, posts, page, count } = Astro.props;
const currentPage = typeof page === "number" ? page : parseInt(String(page), 10);
const formattedName = formatAuthorName(name);
const basePath = buildArchivePath("authors", toTaxonomySlug(name), locale).replace(/\/$/, "");

const { startIndex, endIndex, prevUrl, nextUrl, totalPages } = getPagination({
  page: currentPage,
  totalPosts: count,
  basePath,
});

const paginatedPosts = posts.slice(startIndex, endIndex);
const vars = { name: formattedName, site: siteConfig.name, page: currentPage };
---

<PostArchiveView
  locale={locale}
  title={tf(locale, "authorArchiveTitlePage", vars)}
  description={tf(locale, "authorArchiveDescPage", vars)}
  noindex={siteConfig.noindex.authors}
  heading={tf(locale, "authorHeading", vars)}
  subText={`${tf(locale, "pageOf", { page: currentPage, total: totalPages })} — ${tf(locale, count === 1 ? "guidesByAuthorOne" : "guidesByAuthorMany", { count })}`}
  emptyText={t(locale, "emptyAuthorArchive")}
  posts={paginatedPosts}
  currentPage={currentPage}
  totalPages={totalPages}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
  basePath={basePath}
/>

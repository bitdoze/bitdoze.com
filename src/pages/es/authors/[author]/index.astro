---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import PostArchiveView from "@components/views/PostArchiveView.astro";
import { siteConfig } from "@config/site";
import { t, tf } from "@i18n/ui";
import { formatAuthorName, getTaxonomyIndexPaths } from "@utils/archivePaths";
import { buildArchivePath, toTaxonomySlug } from "@utils/slugs";

const locale = "es";

export const getStaticPaths = (() =>
  getTaxonomyIndexPaths("authors", "es")) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { name, posts, count, authorDetails } = Astro.props;
const formattedName = formatAuthorName(name);
const basePath = buildArchivePath("authors", toTaxonomySlug(name), locale).replace(/\/$/, "");
const postsPerPage = siteConfig.postsPerPage;
const totalPages = Math.ceil(count / postsPerPage);
const paginatedPosts = posts.slice(0, postsPerPage);
const vars = { name: formattedName, site: siteConfig.name };
---

<PostArchiveView
  locale={locale}
  title={tf(locale, "authorArchiveTitle", vars)}
  metaTitle={authorDetails?.data.meta_title}
  description={tf(locale, "authorArchiveDesc", vars)}
  noindex={siteConfig.noindex.authors}
  heading={tf(locale, "authorHeading", vars)}
  subText={tf(locale, count === 1 ? "guidesByAuthorOne" : "guidesByAuthorMany", { count })}
  emptyText={t(locale, "emptyAuthorArchive")}
  posts={paginatedPosts}
  currentPage={1}
  totalPages={totalPages}
  prevUrl={null}
  nextUrl={count > postsPerPage ? `${basePath}/page/2/` : null}
  basePath={basePath}
  authorDetails={authorDetails}
/>

---
import PostArchiveView from "@components/views/PostArchiveView.astro";
import { siteConfig } from "@config/site";
import { t, tf } from "@i18n/ui";
import { absoluteUrl } from "@utils/slugs";
import { getPostsByLocale } from "@utils/postsCache";

const locale = "es";

const posts = await getPostsByLocale(locale);

const sortedPosts = posts.sort((a, b) => {
  return new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime();
});

const postsPerPage = siteConfig.postsPerPage;
const paginatedPosts = sortedPosts.slice(0, postsPerPage);
const basePath = "/es/blog";

const enHref = absoluteUrl("/blog/", Astro.site || siteConfig.url);
const esHref = absoluteUrl("/es/blog/", Astro.site || siteConfig.url);
---

<PostArchiveView
  locale={locale}
  title={tf(locale, "blogArchiveTitle", { site: siteConfig.name })}
  description={t(locale, "blogArchiveDesc")}
  heading={t(locale, "allGuides")}
  subText={t(locale, "blogArchiveSub")}
  emptyText={t(locale, "emptyArchive")}
  posts={paginatedPosts}
  currentPage={1}
  totalPages={Math.ceil(sortedPosts.length / postsPerPage)}
  prevUrl={null}
  nextUrl={sortedPosts.length > postsPerPage ? `${basePath}/page/2/` : null}
  basePath={basePath}
  viewTransitionName="home-latest-heading"
  hreflangs={[
    { lang: "en", href: enHref },
    { lang: "es", href: esHref },
    { lang: "x-default", href: enHref },
  ]}
/>

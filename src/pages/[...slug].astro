---
import { getCollection, render } from "astro:content";
import PostLayout from "@layouts/PostLayout.astro";
// Import all widget components for MDX files
import { mdxComponents } from "@components/mdx-components";
import { getEntrySlug } from "@utils/content";
import { getPostLocale, getLocaleFromSlug } from "@utils/i18n";
import { getAllPublishedPosts } from "@utils/postsCache";

// Get all blog posts
export async function getStaticPaths() {
  const posts = await getAllPublishedPosts();

  // Build guards against another silent slug collision (the 2026-11 incident:
  // a frontmatter `slug:` without the es/ prefix shadowed the English twin and
  // the post went 404). Fail loud instead of shipping a missing page.
  const files = Object.keys(import.meta.glob("/src/content/posts/**/*.{md,mdx}"));
  const allIncludingDrafts = await getCollection("posts");
  if (files.length !== allIncludingDrafts.length) {
    throw new Error(
      `posts collection lost entries: ${files.length} files on disk vs ${allIncludingDrafts.length} entries loaded (slug/id collision?)`
    );
  }
  for (const post of posts) {
    // Entry id is the file path (locale source of truth); canonical/slug is the
    // published URL. They must agree on locale.
    if (getLocaleFromSlug(getEntrySlug(post)) !== getPostLocale(post)) {
      throw new Error(
        `locale mismatch: ${post.id} resolves to /${getEntrySlug(post)}/ — check its canonical`
      );
    }
  }

  return posts.map((post) => ({
    params: { slug: getEntrySlug(post) },
    props: { post },
    // Incremental builds: re-render only when content changed.
    cacheKey: (post.data.lastmod ?? post.data.date)?.toISOString?.() ?? getEntrySlug(post),
  }));
}

const { post } = Astro.props;
// Expose the post date to widgets inside the MDX body (e.g. YouTubeEmbed uses
// it as the VideoObject uploadDate fallback when the real YouTube date is
// unavailable). Locals are shared per page render.
Astro.locals.postPublishDate = post.data.date;
// Pass all widget components to MDX content
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings}>
  <Content components={mdxComponents} />
</PostLayout>

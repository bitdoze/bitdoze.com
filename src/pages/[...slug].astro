---
import { render } from "astro:content";
import PostLayout from "@layouts/PostLayout.astro";
// Import all widget components for MDX files
import { mdxComponents } from "@components/mdx-components";
import { getEntrySlug } from "@utils/content";
import { getAllPublishedPosts } from "@utils/postsCache";

// Get all blog posts
export async function getStaticPaths() {
  const posts = await getAllPublishedPosts();

  return posts.map((post) => ({
    params: { slug: getEntrySlug(post) },
    props: { post },
    // Incremental builds: re-render only when content changed.
    cacheKey: (post.data.lastmod ?? post.data.date)?.toISOString?.() ?? getEntrySlug(post),
  }));
}

const { post } = Astro.props;
// Expose the post date to widgets inside the MDX body (e.g. YouTubeEmbed uses
// it as the VideoObject uploadDate fallback when the real YouTube date is
// unavailable). Locals are shared per page render.
Astro.locals.postPublishDate = post.data.date;
// Pass all widget components to MDX content
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings}>
  <Content components={mdxComponents} />
</PostLayout>

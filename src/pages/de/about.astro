---
import Layout from "@layouts/Layout.astro";
import { siteConfig } from "@config/site";
import { localeSharedHreflangs } from "@utils/slugs";
---

<Layout
  title={`Über - ${siteConfig.name}`}
  description="Lerne den Autor von Bitdoze und den Fokus des Blogs auf DevOps, Programmierung und praktische Tools kennen."
  lang="de"
  hreflangs={localeSharedHreflangs("/about/", Astro.site || siteConfig.url)}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <section class="py-6">
      <header class="mb-8 pb-4 border-b border-gray-200 dark:border-gray-700">
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-2">
          Über Bitdoze
        </h1>
        <p class="text-base text-gray-600 dark:text-gray-400">
          Praxisnahe Anleitungen zu DevOps, Linux und Entwicklung
        </p>
      </header>

      <div class="prose prose-lg dark:prose-invert max-w-none">
        <p>
          Ich bin Dragos, IT-Profi mit Schwerpunkt auf DevOps, Linux und technischen Inhalten. Auf
          Bitdoze veröffentliche ich praktische Anleitungen, die dir helfen, echte Projekte zu
          deployen, zu optimieren und zu betreiben.
        </p>
        <p>
          Das Ziel der Seite ist einfach: umsetzbare Inhalte, klare Beispiele und hilfreiche
          Vergleiche, damit du bessere technische Entscheidungen triffst.
        </p>
      </div>

      <div class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
        <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white mb-6">
          Wobei ich dir helfen kann
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white dark:bg-gray-800 p-6 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">VPS-Deployment</h3>
            <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
              Effizientes Setup und Deployment von Anwendungen und Services auf VPS.
            </p>
          </div>
          <div class="bg-white dark:bg-gray-800 p-6 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
              Docker &amp; Sicherheit
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
              Containerisierung, Observability und grundlegende Security-Best-Practices.
            </p>
          </div>
          <div class="bg-white dark:bg-gray-800 p-6 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Automatisierung</h3>
            <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
              Entwicklerproduktivität und automatisierte CI/CD-Workflows.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-8">
        <a
          href="/de/contact/"
          class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-all duration-200 font-semibold shadow-sm hover:shadow-md hover:-translate-y-px"
        >
          Kontakt aufnehmen
        </a>
      </div>
    </section>
  </div>
</Layout>

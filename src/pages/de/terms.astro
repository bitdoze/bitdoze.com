---
import Layout from "@layouts/Layout.astro";
import { siteConfig } from "@config/site";
import { localeSharedHreflangs } from "@utils/slugs";
---

<Layout
  title={`Nutzungsbedingungen - ${siteConfig.name}`}
  description="Nutzungsbedingungen, technische Hinweise, Affiliate-Offenlegung und geistiges Eigentum von Bitdoze."
  lang="de"
  hreflangs={localeSharedHreflangs("/terms/", Astro.site || siteConfig.url)}
>
  <section class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-6">
        Nutzungsbedingungen
      </h1>
      <div class="prose prose-lg dark:prose-invert max-w-none">
        <p>
          <strong>Letzte Aktualisierung:</strong> 13. November 2026
        </p>
        <p>
          Diese Bedingungen regeln die Nutzung von <strong>Bitdoze</strong>, betrieben von Dragos
          Balota (Rumänien). Die vollständige rechtliche Fassung auf Englisch findest du unter{" "}
          <a href="/terms/">Terms and Conditions</a>.
        </p>

        <h2>Technische Inhalte</h2>
        <p>
          Anleitungen, Befehle und Konfigurationen werden zu Informationszwecken „wie besehen“
          bereitgestellt. Erstelle Backups und teste Änderungen, bevor du sie auf Produktivservern
          anwendest.
        </p>

        <h2>Affiliate- und externe Links</h2>
        <p>
          Bitdoze nimmt am Amazon-Partnerprogramm und weiteren Empfehlungsprogrammen teil;
          gekennzeichnete ausgehende Links oder Links unter <code>/go/</code> können eine Provision
          einbringen – ohne zusätzliche Kosten für dich. Wir übernehmen keine Gewähr für Preise
          oder Verfügbarkeit von Drittanbietern nach der Veröffentlichung.
        </p>

        <h2>Geistiges Eigentum und Kontakt</h2>
        <p>
          Texte, Diagramme und Designs gehören Dragos Balota, sofern in Code-Snippets keine
          abweichende Lizenz angegeben ist. Bei rechtlichen Fragen oder Korrekturen schreibe an{" "}
          <a href="mailto:dragos@bitdoze.com">dragos@bitdoze.com</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>

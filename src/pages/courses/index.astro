---
import { Icon } from "astro-icon/components";
import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/common/Breadcrumb.astro";
import CourseCard from "@components/courses/CourseCard.astro";
import { getCourses } from "@utils/courses";
import { siteConfig } from "@config/site";
import { absoluteUrl } from "@utils/slugs";

const courses = getCourses();
const totalLessons = courses.reduce((n, course) => n + course.lessons.length, 0);

const title = "Video Courses";
const metaTitle = "Video Courses - Bitdoze";
const description =
  "Step-by-step video courses from the Bitdoze YouTube channel — self-hosting, DevOps and CMS builds you can follow end to end, with matching written guides on this site.";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Courses", url: "/courses/" },
];
---

<Layout
  title={metaTitle}
  metaTitle={metaTitle}
  description={description}
  breadcrumbs={breadcrumbs}
  hreflangs={[
    { lang: "en", href: absoluteUrl("/courses/", Astro.site || siteConfig.url) },
    { lang: "x-default", href: absoluteUrl("/courses/", Astro.site || siteConfig.url) },
  ]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={breadcrumbs} />

    <header class="mb-10 pb-6 border-b border-gray-200 dark:border-gray-700">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-2">
        {title}
      </h1>
      <p class="text-base text-gray-600 dark:text-gray-400 max-w-3xl">{description}</p>
      <p class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 dark:text-gray-400">
        <Icon name="mdi:school-outline" class="h-4 w-4 text-blue-600 dark:text-blue-400" />
        {courses.length} courses · {totalLessons} lessons
      </p>
    </header>

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2" aria-label="Available courses">
      {courses.map((course) => <CourseCard course={course} />)}
    </section>

    <section class="mt-14 pt-10 border-t border-gray-200 dark:border-gray-700 text-center">
      <h2 class="text-xl md:text-2xl font-bold tracking-tight text-gray-900 dark:text-white mb-2">
        More on the channel
      </h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-6">
        New videos land on YouTube first — subscribe to catch the next course as it grows.
      </p>
      <a
        href="https://www.youtube.com/@webdoze"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 text-base font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-all duration-200 shadow-md hover:shadow-lg hover:-translate-y-px"
      >
        <Icon name="mdi:youtube" class="h-5 w-5" />
        Bitdoze on YouTube
      </a>
    </section>
  </div>
</Layout>

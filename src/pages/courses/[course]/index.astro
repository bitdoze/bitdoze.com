---
import { Icon } from "astro-icon/components";
import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/common/Breadcrumb.astro";
import {
  courseHref,
  getCourses,
  lessonHref,
  lessonOgImage,
  lessonSlug,
  lessonThumbnail,
  resolveRelatedPosts,
  type Course,
} from "@utils/courses";
import { getPostsByLocale } from "@utils/postsCache";
import { siteConfig } from "@config/site";
import { absoluteUrl, serializeJsonLd } from "@utils/slugs";

interface Props {
  course: Course;
}

export function getStaticPaths() {
  return getCourses().map((course) => ({
    params: { course: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
const firstLesson = course.lessons[0];
const total = course.lessons.length;
const site = Astro.site || siteConfig.url;

const posts = await getPostsByLocale("en");
const relatedPosts = resolveRelatedPosts(posts, course.relatedPosts, `course "${course.slug}"`);

const metaTitle = `${course.title} - Bitdoze`;
const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Courses", url: "/courses/" },
  { name: course.title, url: courseHref(course) },
];

// Course rich-result schema: name/description/provider are Google's required
// props; hasPart links each lesson page so the curriculum is crawlable.
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: course.title,
  description: course.description,
  provider: {
    "@type": "Organization",
    name: siteConfig.name,
    sameAs: siteConfig.url,
  },
  inLanguage: "en",
  isAccessibleForFree: true,
  hasCourseInstance: {
    "@type": "CourseInstance",
    courseMode: "online",
    url: absoluteUrl(courseHref(course), site),
  },
  hasPart: course.lessons.map((lesson) => ({
    "@type": "LearningResource",
    learningResourceType: "Video",
    name: lesson.title,
    ...(lesson.description ? { description: lesson.description } : {}),
    url: absoluteUrl(lessonHref(course, lesson), site),
  })),
};
---

<Layout
  title={metaTitle}
  metaTitle={metaTitle}
  description={course.description}
  image={lessonOgImage(firstLesson)}
  imageWidth={1280}
  imageHeight={720}
  breadcrumbs={breadcrumbs}
  hreflangs={[
    { lang: "en", href: absoluteUrl(courseHref(course), Astro.site || siteConfig.url) },
    { lang: "x-default", href: absoluteUrl(courseHref(course), Astro.site || siteConfig.url) },
  ]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumb items={breadcrumbs} showCurrent={false} />

    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-blue-700 dark:bg-blue-900/50 dark:text-blue-300">
          <Icon name="mdi:school-outline" class="h-3.5 w-3.5" />
          Video course · {total} lessons
        </span>
        {course.level && (
          <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
            {course.level}
          </span>
        )}
      </div>
      <h1 class="mt-4 text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white">
        {course.title}
      </h1>
      <p class="mt-4 max-w-3xl text-base md:text-lg leading-relaxed text-gray-600 dark:text-gray-400">
        {course.description}
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href={lessonHref(course, firstLesson)}
          class="group inline-flex items-center gap-2 rounded-lg bg-linear-to-r from-blue-600 to-indigo-600 px-6 py-3 text-base font-semibold text-white shadow-[0_10px_15px_rgba(0,0,0,0.08)] transition-all duration-200 hover:scale-105 hover:from-blue-700 hover:to-indigo-700 dark:shadow-[0_10px_15px_rgba(0,0,0,0.2)]"
        >
          <Icon name="mdi:play-circle" class="h-5 w-5" />
          Start the course
        </a>
        {course.playlist && (
          <a
            href={course.playlist}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-1.5 text-base font-semibold text-gray-700 transition-colors duration-200 hover:text-blue-600 dark:text-gray-300 dark:hover:text-blue-400"
          >
            <Icon name="mdi:youtube" class="h-5 w-5 text-red-600" />
            Watch on YouTube
          </a>
        )}
      </div>
    </header>

    <section data-course-progress data-course={course.slug} data-total={total} aria-label="Course curriculum">
      <div class="flex items-center justify-between border-b-2 border-blue-600 pb-2 dark:border-blue-400">
        <h2 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-white">Curriculum</h2>
        <span
          data-progress-label
          class="rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-semibold text-blue-700 dark:bg-blue-900/40 dark:text-blue-300"
        >
          0/{total} watched
        </span>
      </div>

      <ol class="mt-6 space-y-3">
        {course.lessons.map((lesson, index) => {
          const slug = lessonSlug(lesson);
          return (
            <li>
              <a
                href={lessonHref(course, lesson)}
                data-lesson-item
                data-slug={slug}
                data-keep-num
                class="group flex items-center gap-3 rounded-lg border border-gray-200 bg-white p-3 transition-colors duration-200 hover:border-blue-300 hover:bg-blue-50/40 sm:gap-4 sm:p-4 dark:border-gray-700 dark:bg-gray-800 dark:hover:border-blue-700 dark:hover:bg-blue-950/20"
              >
                <span class="relative hidden w-28 shrink-0 overflow-hidden rounded-md bg-gray-900 aspect-video min-[420px]:block sm:w-36">
                  <img
                    src={lessonThumbnail(lesson)}
                    alt=""
                    width="320"
                    height="180"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                  <span class="absolute inset-0 flex items-center justify-center bg-gray-950/25">
                    <Icon name="mdi:play" class="h-7 w-7 text-white drop-shadow" />
                  </span>
                </span>

                <span
                  data-num
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gray-100 font-mono text-xs font-semibold text-gray-500 dark:bg-gray-700 dark:text-gray-300"
                >
                  {index + 1}
                </span>

                <span class="min-w-0 grow">
                  <span class="block text-sm font-semibold leading-snug text-gray-900 group-hover:text-blue-700 sm:text-base dark:text-white dark:group-hover:text-blue-400">
                    {lesson.title}
                  </span>
                  {lesson.description && (
                    <span class="mt-1 hidden text-sm leading-relaxed text-gray-500 line-clamp-2 sm:block dark:text-gray-400">
                      {lesson.description}
                    </span>
                  )}
                  <span class="mt-1.5 flex items-center gap-2">
                    {lesson.duration && (
                      <span class="font-mono text-xs text-gray-400 dark:text-gray-500">
                        {lesson.duration}
                      </span>
                    )}
                    <span data-check class="hidden">
                      <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700 dark:bg-green-900/40 dark:text-green-400">
                        <Icon name="mdi:check" class="h-3 w-3" />
                        Watched
                      </span>
                    </span>
                  </span>
                </span>

                <Icon
                  name="mdi:chevron-right"
                  class="h-5 w-5 shrink-0 text-gray-300 transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-blue-500 dark:text-gray-600 dark:group-hover:text-blue-400"
                />
              </a>
            </li>
          );
        })}
      </ol>
    </section>

    {relatedPosts.length > 0 && (
      <section class="mt-12 rounded-lg border border-gray-200 bg-gray-50/60 p-5 sm:p-6 dark:border-gray-700 dark:bg-gray-800/40">
        <div class="flex items-center gap-2">
          <Icon name="mdi:book-open-variant" class="h-5 w-5 text-blue-600 dark:text-blue-400" />
          <h2 class="text-lg font-bold tracking-tight text-gray-900 dark:text-white">
            Matching written guides
          </h2>
        </div>
        <p class="mt-1.5 text-sm text-gray-600 dark:text-gray-400">
          Prefer reading? These lessons have tested, copy-paste-ready article versions.
        </p>
        <ul class="mt-4 grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
          {relatedPosts.map((post) => (
            <li>
              <a href={post.href} class="group flex items-start gap-2 text-sm">
                <Icon
                  name="mdi:file-document-outline"
                  class="mt-0.5 h-4 w-4 shrink-0 text-blue-500 dark:text-blue-400"
                />
                <span class="font-medium text-gray-800 transition-colors group-hover:text-blue-700 dark:text-gray-200 dark:group-hover:text-blue-400">
                  {post.title}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-12 border-t border-gray-200 pt-8 text-center dark:border-gray-700">
      <a
        href="/courses/"
        class="group inline-flex items-center gap-1.5 text-sm font-semibold text-gray-600 transition-colors duration-200 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400"
      >
        <Icon
          name="mdi:arrow-left"
          class="h-4 w-4 transition-transform duration-200 group-hover:-translate-x-0.5"
        />
        All courses
      </a>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={serializeJsonLd(courseSchema)} />

  <script>
    import { initCourseProgress } from "@utils/course-progress";

    const scope = document.querySelector<HTMLElement>("[data-course-progress]");
    const courseSlug = scope?.dataset.course;
    if (courseSlug) {
      initCourseProgress(courseSlug);
    }
  </script>
</Layout>

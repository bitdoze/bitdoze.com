---
import { Icon } from "astro-icon/components";
import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/common/Breadcrumb.astro";
import CourseSidebar from "@components/courses/CourseSidebar.astro";
import YouTubeEmbed from "@components/widgets/YouTubeEmbed.astro";
import {
  courseHref,
  getCourses,
  getLessonNav,
  lessonHref,
  lessonOgImage,
  lessonSlug,
  resolveRelatedPosts,
  type Course,
} from "@utils/courses";
import { getPostsByLocale } from "@utils/postsCache";
import { siteConfig } from "@config/site";
import { absoluteUrl } from "@utils/slugs";

interface Props {
  course: Course;
  slug: string;
}

export function getStaticPaths() {
  return getCourses().flatMap((course) =>
    course.lessons.map((lesson) => ({
      params: { course: course.slug, lesson: lessonSlug(lesson) },
      props: { course, slug: lessonSlug(lesson) },
    }))
  );
}

const { course, slug } = Astro.props;
const nav = getLessonNav(course, slug);
const { lesson, index, prev, next } = nav;
const position = `Lesson ${index + 1} of ${course.lessons.length}`;

const posts = await getPostsByLocale("en");
const relatedPosts = resolveRelatedPosts(
  posts,
  lesson.relatedPosts,
  `lesson "${course.slug}/${slug}"`
);

const metaTitle = `${lesson.title} - Bitdoze`;
const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Courses", url: "/courses/" },
  { name: course.title, url: courseHref(course) },
  { name: position, url: lessonHref(course, lesson) },
];

const navCard =
  "group flex min-w-0 flex-1 items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2.5 transition-colors duration-200 hover:border-blue-300 hover:bg-blue-50/50 sm:px-4 sm:py-3 dark:border-gray-700 dark:bg-gray-800 dark:hover:border-blue-700 dark:hover:bg-blue-950/30";
---

<Layout
  title={metaTitle}
  metaTitle={metaTitle}
  description={lesson.description || course.description}
  image={lessonOgImage(lesson)}
  imageWidth={1280}
  imageHeight={720}
  breadcrumbs={breadcrumbs}
  wideContent={true}
  hreflangs={[
    {
      lang: "en",
      href: absoluteUrl(lessonHref(course, lesson), Astro.site || siteConfig.url),
    },
    {
      lang: "x-default",
      href: absoluteUrl(lessonHref(course, lesson), Astro.site || siteConfig.url),
    },
  ]}
>
  <div
    class="mx-auto max-w-6xl px-4 pb-14 sm:px-6"
    data-course-slug={course.slug}
    data-lesson-slug={slug}
  >
    <Breadcrumb items={breadcrumbs} className="pt-6" showCurrent={false} />

    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_21rem] lg:items-start lg:gap-8 xl:gap-10">
      <div class="min-w-0">
        <YouTubeEmbed
          url={lesson.video}
          label={lesson.title}
          description={lesson.description}
        />

        {/* Prev / chapters / next — the primary in-course navigation */}
        <nav aria-label="Lesson navigation" class="mt-4 flex items-stretch gap-2 sm:gap-3">
          {prev ? (
            <a href={lessonHref(course, prev)} class={navCard}>
              <Icon
                name="mdi:chevron-left"
                class="h-5 w-5 shrink-0 text-blue-600 transition-transform duration-200 group-hover:-translate-x-0.5 dark:text-blue-400"
              />
              <span class="min-w-0">
                <span class="block text-xs font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500">
                  Previous
                </span>
                <span class="block truncate text-sm font-semibold text-gray-800 dark:text-gray-200">
                  {prev.title}
                </span>
              </span>
            </a>
          ) : (
            <a href={courseHref(course)} class={navCard}>
              <Icon
                name="mdi:chevron-left"
                class="h-5 w-5 shrink-0 text-blue-600 transition-transform duration-200 group-hover:-translate-x-0.5 dark:text-blue-400"
              />
              <span class="min-w-0">
                <span class="block text-xs font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500">
                  Start of course
                </span>
                <span class="block truncate text-sm font-semibold text-gray-800 dark:text-gray-200">
                  Course overview
                </span>
              </span>
            </a>
          )}

          <button
            type="button"
            data-chapters-open
            aria-expanded="false"
            aria-controls="course-chapters"
            class="inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-blue-200 bg-blue-50 px-3 py-2.5 text-sm font-semibold text-blue-700 transition-colors duration-200 hover:bg-blue-100 sm:px-4 dark:border-blue-800 dark:bg-blue-950/40 dark:text-blue-300 dark:hover:bg-blue-900/50 lg:hidden"
          >
            <Icon name="mdi:format-list-bulleted" class="h-5 w-5" />
            <span class="hidden min-[420px]:inline">Chapters</span>
            <span class="font-mono text-xs">{index + 1}/{course.lessons.length}</span>
          </button>

          {next ? (
            <a href={lessonHref(course, next)} class={`${navCard} justify-end text-right`}>
              <span class="min-w-0">
                <span class="block text-xs font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500">
                  Next
                </span>
                <span class="block truncate text-sm font-semibold text-gray-800 dark:text-gray-200">
                  {next.title}
                </span>
              </span>
              <Icon
                name="mdi:chevron-right"
                class="h-5 w-5 shrink-0 text-blue-600 transition-transform duration-200 group-hover:translate-x-0.5 dark:text-blue-400"
              />
            </a>
          ) : (
            <a href={courseHref(course)} class={`${navCard} justify-end text-right`}>
              <span class="min-w-0">
                <span class="block text-xs font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500">
                  Course complete
                </span>
                <span class="block truncate text-sm font-semibold text-blue-700 dark:text-blue-300">
                  Finish course
                </span>
              </span>
              <Icon
                name="mdi:flag-checkered"
                class="h-5 w-5 shrink-0 text-blue-600 transition-transform duration-200 group-hover:translate-x-0.5 dark:text-blue-400"
              />
            </a>
          )}
        </nav>

        <header class="mt-6">
          <a
            href={courseHref(course)}
            class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-blue-700 transition-colors hover:text-blue-800 dark:text-blue-300 dark:hover:text-blue-200"
          >
            <Icon name="mdi:school-outline" class="h-4 w-4" />
            {course.title}
          </a>
          <h1 class="mt-2 text-2xl font-bold leading-tight tracking-tight text-gray-900 sm:text-3xl dark:text-white">
            {lesson.title}
          </h1>
          {lesson.description && (
            <p class="mt-3 max-w-3xl text-base leading-relaxed text-gray-600 dark:text-gray-400">
              {lesson.description}
            </p>
          )}

          {relatedPosts.length > 0 && (
            <div class="mt-4 max-w-3xl rounded-lg border border-blue-100 bg-blue-50/60 p-4 dark:border-blue-900/50 dark:bg-blue-950/30">
              <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-blue-700 dark:text-blue-300">
                <Icon name="mdi:book-open-variant" class="h-4 w-4" />
                Written guide{relatedPosts.length > 1 ? "s" : ""}
              </p>
              <ul class="mt-2.5 space-y-2">
                {relatedPosts.map((post) => (
                  <li>
                    <a
                      href={post.href}
                      class="group inline-flex items-start gap-1.5 text-sm font-medium text-gray-800 transition-colors hover:text-blue-700 dark:text-gray-200 dark:hover:text-blue-300"
                    >
                      <span class="underline-offset-2 group-hover:underline">{post.title}</span>
                      <Icon
                        name="mdi:arrow-right"
                        class="mt-0.5 h-4 w-4 shrink-0 text-blue-500 transition-transform duration-200 group-hover:translate-x-0.5 dark:text-blue-400"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <p class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
            <Icon name="mdi:counter" class="h-3.5 w-3.5 text-blue-600 dark:text-blue-400" />
            {position}
          </p>
        </header>
      </div>

      <div class="mt-6 lg:mt-0">
        <CourseSidebar course={course} currentSlug={slug} />
      </div>
    </div>
  </div>

  {/* Mobile drawer backdrop */}
  <div
    data-chapters-backdrop
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 z-40 bg-gray-950/50 opacity-0 transition-opacity duration-300 data-[open=true]:pointer-events-auto data-[open=true]:opacity-100 lg:hidden"
  ></div>

  <script>
    import { initCourseProgress } from "@utils/course-progress";

    const root = document.querySelector<HTMLElement>("[data-course-slug]");
    const panel = document.querySelector<HTMLElement>("[data-chapters-panel]");
    const backdrop = document.querySelector<HTMLElement>("[data-chapters-backdrop]");
    const openers = document.querySelectorAll<HTMLButtonElement>("[data-chapters-open]");
    let lastOpener: HTMLButtonElement | null = null;

    const setChaptersOpen = (open: boolean) => {
      if (!panel || !backdrop) return;
      if (open) {
        panel.dataset.open = "true";
        backdrop.dataset.open = "true";
        document.documentElement.style.overflow = "hidden";
        panel.querySelector<HTMLElement>("[data-chapters-close]")?.focus();
      } else {
        delete panel.dataset.open;
        delete backdrop.dataset.open;
        document.documentElement.style.overflow = "";
        lastOpener?.focus();
      }
      openers.forEach((btn) => btn.setAttribute("aria-expanded", String(open)));
    };

    openers.forEach((btn) =>
      btn.addEventListener("click", () => {
        lastOpener = btn;
        setChaptersOpen(true);
      })
    );
    panel
      ?.querySelector("[data-chapters-close]")
      ?.addEventListener("click", () => setChaptersOpen(false));
    backdrop?.addEventListener("click", () => setChaptersOpen(false));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && panel?.dataset.open === "true") {
        setChaptersOpen(false);
      }
    });

    if (root?.dataset.courseSlug) {
      initCourseProgress(root.dataset.courseSlug, root.dataset.lessonSlug);
    }
  </script>
</Layout>

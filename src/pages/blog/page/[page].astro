---
import type { GetStaticPaths } from "astro";
import PostArchiveView from "@components/views/PostArchiveView.astro";
import { siteConfig } from "@config/site";
import { t, tf } from "@i18n/ui";
import { absoluteUrl } from "@utils/slugs";
import { getPostsByLocale } from "@utils/postsCache";

const locale = "en";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPostsByLocale("en");

  const sortedPosts = posts.sort((a, b) => {
    return new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime();
  });

  const allPages = paginate(sortedPosts, { pageSize: siteConfig.postsPerPage });
  // Skip page 1 since it's handled by blog.astro
  return allPages.filter((entry) => entry.params.page !== "1");
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const currentPage = page.currentPage;
const totalPages = page.lastPage;
const basePath = "/blog";

// Override prev URL: page 2's prev should link to /blog/ not /blog/page/1/
const prevUrl = currentPage === 2 ? `${basePath}/` : (page.url.prev ?? null);

const vars = { page: currentPage, site: siteConfig.name };
---

<PostArchiveView
  locale={locale}
  title={tf(locale, "blogArchiveTitlePage", vars)}
  description={tf(locale, "blogArchiveDescPage", vars)}
  noindex={true}
  heading={t(locale, "allGuides")}
  subText={`${tf(locale, "pageOf", { page: currentPage, total: totalPages })} — ${t(locale, "blogArchiveSub")}`}
  emptyText={t(locale, "emptyArchive")}
  posts={page.data}
  currentPage={currentPage}
  totalPages={totalPages}
  prevUrl={prevUrl}
  nextUrl={page.url.next ?? null}
  basePath={basePath}
  hreflangs={[
    {
      lang: "en",
      href: absoluteUrl(`/blog/page/${currentPage}/`, Astro.site || siteConfig.url),
    },
    {
      lang: "es",
      href: absoluteUrl(`/es/blog/page/${currentPage}/`, Astro.site || siteConfig.url),
    },
    {
      lang: "x-default",
      href: absoluteUrl(`/blog/page/${currentPage}/`, Astro.site || siteConfig.url),
    },
  ]}
/>

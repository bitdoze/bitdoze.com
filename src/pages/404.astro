---
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { getLocaleFromPathname } from "@utils/i18n";
import { localizeInternalPath } from "@utils/localeRoutes";

const locale = getLocaleFromPathname(Astro.url.pathname);
const isEs = locale === "es";

const popular = isEs
  ? [
      { href: "/es/instalar-dokploy/", label: "Instalar Dokploy" },
      { href: "/es/categories/self-hosting/", label: "Guías de self-hosting" },
      { href: "/es/blog/", label: "Todas las guías" },
    ]
  : [
      { href: "/dokploy-install/", label: "Install Dokploy" },
      { href: "/self-hosted/", label: "Self-hosting route map" },
      { href: "/blog/", label: "All guides" },
    ];
---

<Layout
  title={isEs ? "404 - Página no encontrada" : "404 - Page Not Found"}
  description={
    isEs ? "La página que buscas no existe." : "The page you're looking for doesn't exist."
  }
  lang={locale}
  noindex={true}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex flex-col items-center justify-center text-center">
    <div class="max-w-md w-full bg-white dark:bg-gray-800 p-8 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm">
      <div class="w-16 h-16 rounded-full bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 flex items-center justify-center mx-auto mb-6">
        <Icon name="mdi:alert-circle-outline" class="w-8 h-8" />
      </div>

      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-gray-900 dark:text-white mb-2">
        404
      </h1>

      <h2 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-gray-200 mb-4">
        {isEs ? "Página no encontrada" : "Page Not Found"}
      </h2>

      <p class="text-sm text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
        {isEs
          ? "La página que buscas no existe o ha sido trasladada. Prueba a buscarla:"
          : "The page you're looking for doesn't exist or has been moved. Try searching for it:"}
      </p>

      <form
        action={localizeInternalPath("/search/", locale)}
        method="get"
        role="search"
        class="mb-6"
      >
        <label class="relative block">
          <span class="sr-only">{isEs ? "Buscar" : "Search"}</span>
          <Icon
            name="mdi:magnify"
            class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400"
          />
          <input
            id="notfound-q"
            name="q"
            type="search"
            placeholder={isEs ? "Buscar guías…" : "Search guides…"}
            autocomplete="off"
            class="w-full rounded-lg border border-(--color-border-base) bg-(--color-bg-muted) py-2.5 pl-9 pr-3 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20"
          />
        </label>
      </form>

      <div class="mb-6 text-left">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-wider text-(--color-text-muted) mb-2">
          {isEs ? "Lo más buscado:" : "Most looked for:"}
        </p>
        <ul class="space-y-1.5">
          {popular.map((item) => (
            <li>
              <a
                href={item.href}
                class="group inline-flex items-center gap-1.5 text-sm font-medium text-blue-700 transition-colors hover:text-blue-800 dark:text-blue-300 dark:hover:text-blue-200"
              >
                <Icon
                  name="mdi:arrow-right"
                  class="h-3.5 w-3.5 transition-transform duration-150 group-hover:translate-x-0.5"
                />
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <a
        href={isEs ? "/es/" : "/"}
        class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-all duration-200 font-semibold shadow-sm inline-flex items-center justify-center gap-2"
      >
        <Icon name="mdi:home" class="w-4 h-4" />
        {isEs ? "Ir al inicio" : "Go Home"}
      </a>
    </div>
  </div>

  <script is:inline>
    // Pre-fill search from the dead URL: /install-dokploy/ -> "install dokploy"
    (function () {
      var input = document.getElementById("notfound-q");
      if (!input) return;
      var words = location.pathname
        .replace(/^\/es\//, "/")
        .split("/")
        .filter(Boolean)
        .pop();
      if (words) input.value = words.replace(/[-_]+/g, " ").replace(/\.html?$/i, "");
    })();
  </script>
</Layout>

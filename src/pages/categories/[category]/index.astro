---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import PostArchiveView from "@components/views/PostArchiveView.astro";
import { siteConfig } from "@config/site";
import { t, tf } from "@i18n/ui";
import { categoryIndexSeo, getTaxonomyIndexPaths } from "@utils/archivePaths";
import { buildArchivePath, toTaxonomySlug } from "@utils/slugs";

const locale = "en";

export const getStaticPaths = (() =>
  getTaxonomyIndexPaths("categories", "en")) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { name, posts, count } = Astro.props;
const basePath = buildArchivePath("categories", toTaxonomySlug(name), locale).replace(/\/$/, "");
const postsPerPage = siteConfig.postsPerPage;
const totalPages = Math.ceil(count / postsPerPage);
const paginatedPosts = posts.slice(0, postsPerPage);

const categorySlug = toTaxonomySlug(name);
const { meta, hreflangs, jsonLd } = await categoryIndexSeo(
  locale,
  categorySlug,
  count,
  paginatedPosts,
  Astro.site || siteConfig.url
);
---

<PostArchiveView
  locale={locale}
  title={tf(locale, "categoryArchiveTitle", { name: meta.label, site: siteConfig.name })}
  description={meta.intro}
  noindex={siteConfig.noindex.categories}
  heading={meta.label}
  intro={meta.intro}
  subText={tf(locale, count === 1 ? "guidesInCategoryOne" : "guidesInCategoryMany", { count })}
  emptyText={t(locale, "emptyArchive")}
  posts={paginatedPosts}
  currentPage={1}
  totalPages={totalPages}
  prevUrl={null}
  nextUrl={count > postsPerPage ? `${basePath}/page/2/` : null}
  basePath={basePath}
  hreflangs={hreflangs}
  jsonLd={jsonLd}
/>

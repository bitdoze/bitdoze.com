---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import PostArchiveView from "@components/views/PostArchiveView.astro";
import { siteConfig } from "@config/site";
import { t, tf } from "@i18n/ui";
import { getTaxonomyPagePaths } from "@utils/archivePaths";
import { formatTaxonomyLabel } from "@utils/labels";
import { getPagination } from "@utils/pagination";
import { buildArchivePath, toTaxonomySlug } from "@utils/slugs";

const locale = "en";

export const getStaticPaths = (() => getTaxonomyPagePaths("tags", "en")) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { name, posts, page, count } = Astro.props;
const currentPage = typeof page === "number" ? page : parseInt(String(page), 10);
const formattedName = formatTaxonomyLabel(name);
const basePath = buildArchivePath("tags", toTaxonomySlug(name), locale).replace(/\/$/, "");

const { startIndex, endIndex, prevUrl, nextUrl, totalPages } = getPagination({
  page: currentPage,
  totalPosts: count,
  basePath,
});

const paginatedPosts = posts.slice(startIndex, endIndex);
const vars = { name: formattedName, site: siteConfig.name, page: currentPage };
---

<PostArchiveView
  locale={locale}
  title={tf(locale, "tagArchiveTitlePage", vars)}
  description={tf(locale, "tagArchiveDescPage", vars)}
  noindex={siteConfig.noindex.tags}
  heading={tf(locale, "tagHeading", vars)}
  subText={`${tf(locale, "pageOf", { page: currentPage, total: totalPages })} — ${tf(locale, count === 1 ? "guidesWithTagOne" : "guidesWithTagMany", { count })}`}
  emptyText={t(locale, "emptyTagArchive")}
  posts={paginatedPosts}
  currentPage={currentPage}
  totalPages={totalPages}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
  basePath={basePath}
/>

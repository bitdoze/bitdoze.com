---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import PostArchiveView from "@components/views/PostArchiveView.astro";
import { siteConfig } from "@config/site";
import { t, tf } from "@i18n/ui";
import { getTaxonomyIndexPaths } from "@utils/archivePaths";
import { formatTaxonomyLabel } from "@utils/labels";
import { buildArchivePath, toTaxonomySlug } from "@utils/slugs";

const locale = "en";

export const getStaticPaths = (() => getTaxonomyIndexPaths("tags", "en")) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { name, posts, count } = Astro.props;
const formattedName = formatTaxonomyLabel(name);
const basePath = buildArchivePath("tags", toTaxonomySlug(name), locale).replace(/\/$/, "");
const postsPerPage = siteConfig.postsPerPage;
const totalPages = Math.ceil(count / postsPerPage);
const paginatedPosts = posts.slice(0, postsPerPage);
const vars = { name: formattedName, site: siteConfig.name };
---

<PostArchiveView
  locale={locale}
  title={tf(locale, "tagArchiveTitle", vars)}
  description={tf(locale, "tagArchiveDesc", vars)}
  noindex={siteConfig.noindex.tags}
  heading={tf(locale, "tagHeading", vars)}
  subText={tf(locale, count === 1 ? "guidesWithTagOne" : "guidesWithTagMany", { count })}
  emptyText={t(locale, "emptyTagArchive")}
  posts={paginatedPosts}
  currentPage={1}
  totalPages={totalPages}
  prevUrl={null}
  nextUrl={count > postsPerPage ? `${basePath}/page/2/` : null}
  basePath={basePath}
/>

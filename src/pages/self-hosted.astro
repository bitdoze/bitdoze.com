---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/common/Breadcrumb.astro";
import JourneyCard from "@components/blog/JourneyCard.astro";
import { journeyStages, plannedGuides } from "../data/self-hosted-journey";
import { getEntryHref, getEntrySlug } from "@utils/content";
import { isPostIdInLocale } from "@utils/i18n";
import { siteConfig } from "@config/site";
import { absoluteUrl } from "@utils/slugs";

// Resolve every journey slug against the posts collection — fail loudly on typos
const posts = await getCollection("posts", ({ id, data }) => {
  return !data.draft && isPostIdInLocale(id, "en");
});

const bySlug = new Map<string, (typeof posts)[number]>();
for (const post of posts) {
  bySlug.set(getEntrySlug(post), post);
  bySlug.set(post.id.replace(/\.(md|mdx)$/i, ""), post);
}

const missingSlugs: string[] = [];
const stages = journeyStages.map((stage, index) => ({
  ...stage,
  number: String(index + 1).padStart(2, "0"),
  navLabel:
    stage.id === "level-up"
      ? "Level up"
      : stage.id[0].toUpperCase() + stage.id.slice(1),
  cards: stage.links
    .map((link) => {
      const post = bySlug.get(link.slug);
      if (!post) {
        missingSlugs.push(link.slug);
        return null;
      }
      return {
        href: getEntryHref(post),
        title: post.data.title,
        description: post.data.description,
        tag: link.tag,
      };
    })
    .filter((card): card is NonNullable<typeof card> => card !== null),
}));

if (missingSlugs.length > 0) {
  throw new Error(
    `self-hosted journey: no post found for slug(s): ${missingSlugs.join(", ")}`,
  );
}

const totalGuides = stages.reduce((n, s) => n + s.cards.length, 0);
const epilogueIndex = stages.findIndex((s) => s.epilogue);

const title = "The Self-Hosted Journey: From Zero to a Running Home Lab";
const description =
  "A step-by-step path through our self-hosting guides: pick the hardware, learn Docker, deploy apps, expose them safely, monitor and back up — every guide tested end to end.";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Self-Hosted", url: "/self-hosted/" },
];
---

<Layout
  title={title}
  description={description}
  wideContent={true}
  breadcrumbs={breadcrumbs}
  hreflangs={[
    { lang: "en", href: absoluteUrl("/self-hosted/", Astro.site || siteConfig.url) },
    { lang: "x-default", href: absoluteUrl("/self-hosted/", Astro.site || siteConfig.url) },
  ]}
>
  <!-- Hero band: same max-w-6xl canvas as the homepage -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <Breadcrumb items={breadcrumbs} className="pt-6" />

    <!-- ============ HERO ============ -->
    <header class="grid lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] gap-12 lg:gap-10 items-center pt-8 pb-12 md:pt-10 md:pb-16 lg:pb-20">
      <div>
        <span
          class="inline-flex items-center gap-1.5 rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-blue-700 dark:bg-blue-900/50 dark:text-blue-300"
        >
          <Icon name="mdi:map-marker-path" class="h-3.5 w-3.5" />
          Guide hub · Start here
        </span>
        <h1
          class="mt-5 text-4xl sm:text-5xl font-bold leading-[1.08] tracking-[-0.02em] text-gray-900 dark:text-white"
        >
          The Self-Hosted Journey
        </h1>
        <p class="mt-5 text-lg sm:text-xl leading-relaxed text-pretty text-gray-600 dark:text-gray-300">
          One path through {totalGuides} tested guides — from picking a mini PC
          to running your own apps on your own domain, monitored and backed up.
          Follow it start to finish, or jump to the stage you're on.
        </p>

        <ul
          class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-gray-500 dark:text-gray-400"
        >
          <li class="inline-flex items-center gap-1.5">
            <Icon
              name="mdi:sign-direction"
              class="h-4 w-4 text-blue-600 dark:text-blue-400"
            />
            {stages.length} guided stages
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Icon
              name="mdi:check-circle-outline"
              class="h-4 w-4 text-blue-600 dark:text-blue-400"
            />
            {totalGuides} guides, tested end to end
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Icon
              name="mdi:clock-outline"
              class="h-4 w-4 text-blue-600 dark:text-blue-400"
            />
            Evening & weekend-sized steps
          </li>
        </ul>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a
            href="#plan"
            class="group inline-flex items-center gap-2 rounded-lg bg-linear-to-r from-blue-600 to-indigo-600 px-6 py-3 text-base font-semibold text-white shadow-md transition-all duration-200 hover:from-blue-700 hover:to-indigo-700 hover:shadow-lg hover:-translate-y-px"
          >
            Start the journey
            <Icon
              name="mdi:arrow-down"
              class="h-5 w-5 transition-transform duration-200 group-hover:translate-y-0.5"
            />
          </a>
          <a
            href="#apps"
            class="group inline-flex items-center gap-1.5 text-base font-semibold text-gray-700 transition-colors duration-200 hover:text-blue-600 dark:text-gray-300 dark:hover:text-blue-400"
          >
            <Icon
              name="mdi:apps"
              class="h-5 w-5 text-blue-600 dark:text-blue-400"
            />
            Skip to the apps
            <Icon
              name="mdi:arrow-right"
              class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
            />
          </a>
        </div>
      </div>

      <!-- Route map, terminal-style -->
      <div class="lg:justify-self-end w-full max-w-lg" aria-hidden="true">
        <div
          class="overflow-hidden rounded-xl border border-[#374151] bg-[#111827] shadow-2xl shadow-gray-900/20 dark:shadow-black/40"
        >
          <div
            class="flex items-center gap-2 border-b border-[#1f2937] bg-[#0b1220] px-4 py-3"
          >
            <span class="h-3 w-3 rounded-full bg-[#ef4444]/80"></span>
            <span class="h-3 w-3 rounded-full bg-[#eab308]/80"></span>
            <span class="h-3 w-3 rounded-full bg-[#22c55e]/80"></span>
            <span class="ml-3 select-none font-mono text-xs text-[#6b7280]"
              >you@homelab: ~</span
            >
            <span
              class="ml-auto inline-flex items-center gap-1 rounded-full border border-[#3b82f6]/30 bg-[#3b82f6]/10 px-2 py-0.5 font-mono text-[10px] font-medium text-[#60a5fa]"
            >
              route map
            </span>
          </div>
          <div
            class="px-4 sm:px-5 py-4 font-mono text-[12.5px] sm:text-[13px] leading-[1.75] overflow-x-auto"
          >
            <p class="whitespace-pre">
              <span class="text-[#60a5fa]">you@homelab</span><span
                class="text-[#6b7280]">:</span
              ><span class="text-[#93c5fd]">~</span><span class="text-[#6b7280]"
                >$</span
              >
              <span class="text-[#f9fafb]">journey --map</span>
            </p>
            {
              stages.map((stage) => (
                <p class="whitespace-pre text-[#d1d5db]">
                  <span class="text-[#3b82f6]"> ▸</span>{" "}
                  <span class="text-[#93c5fd]">{stage.number}</span>{" "}
                  <span class="text-[#f9fafb]">{stage.id.padEnd(11, " ")}</span>
                  <span class="text-[#6b7280]">{stage.mapLabel}</span>
                </p>
              ))
            }
            <p class="whitespace-pre pt-1">
              <span class="text-[#60a5fa]">you@homelab</span><span
                class="text-[#6b7280]">:</span
              ><span class="text-[#93c5fd]">~</span><span class="text-[#6b7280]"
                >$</span
              >
              <span
                class="journey-caret ml-2 inline-block h-[1.1em] w-[0.55em] translate-y-[0.2em] bg-[#d1d5db]"
              ></span>
            </p>
          </div>
        </div>
        <p
          class="mt-3 text-center font-mono text-xs text-gray-400 dark:text-gray-500"
        >
          {stages.length} stops · ~{totalGuides} guides · one working lab
        </p>
      </div>
    </header>
  </div>

  <!-- Content band: 5xl like the other hub pages -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-8">
    <!-- ============ STICKY STAGE NAV ============ -->
    <nav
      aria-label="Journey stages"
      class="sticky top-18 z-30 mb-12 rounded-lg border border-gray-200 bg-white/90 shadow-sm backdrop-blur-md dark:border-gray-700 dark:bg-gray-900/90"
    >
      <div
        class="flex items-center gap-1 overflow-x-auto px-2 py-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {
          stages.map((stage) => (
            <a
              href={`#${stage.id}`}
              class="whitespace-nowrap rounded-full px-2.5 py-1.5 text-xs font-medium text-gray-600 transition-colors hover:bg-blue-50 hover:text-blue-700 dark:text-gray-300 dark:hover:bg-blue-900/40 dark:hover:text-blue-300"
            >
              <span class="mr-1 font-mono text-blue-600 dark:text-blue-400">
                {stage.number}
              </span>
              {stage.navLabel}
            </a>
          ))
        }
      </div>
    </nav>

    <!-- ============ JOURNEY RAIL ============ -->
    <div class="relative">
      <div
        class="absolute bottom-6 left-[19px] top-2 w-0.5 rounded bg-gray-200 dark:bg-gray-700"
        aria-hidden="true"
      >
      </div>

      <!-- Journey start marker -->
      <div class="relative pb-10 pl-14 sm:pl-16">
        <span
          class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-full bg-green-600 text-white shadow-sm ring-4 ring-white dark:ring-gray-900"
        >
          <Icon name="mdi:flag-variant" class="h-5 w-5" />
        </span>
        <div class="pt-1.5">
          <p
            class="text-xs font-bold uppercase tracking-[0.14em] text-green-700 dark:text-green-400"
          >
            Journey start
          </p>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
            New to this? Read stages in order. Already have a running box? Jump
            in anywhere — every stage stands alone.
          </p>
        </div>
      </div>

      <!-- Stages (epilogue follows the "journey complete" panel) -->
      {
        stages.map((stage) => (
          <>
            {stage.epilogue && stage === stages[epilogueIndex] && (
              <div class="relative pb-12 pl-14 sm:pl-16">
                <span class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-full bg-green-600 text-white shadow-sm ring-4 ring-white dark:ring-gray-900">
                  <Icon name="mdi:flag-checkered" class="h-5 w-5" />
                </span>
                <div class="rounded-lg border border-green-200 bg-green-50 p-5 sm:p-6 dark:border-green-800/60 dark:bg-green-900/15">
                  <p class="text-xs font-bold uppercase tracking-[0.14em] text-green-700 dark:text-green-400">
                    Journey complete
                  </p>
                  <h2 class="mt-1 text-xl md:text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                    You have a real home lab now
                  </h2>
                  <p class="mt-2 max-w-2xl text-sm leading-relaxed text-gray-700 dark:text-gray-300">
                    A quiet box running your apps on real HTTPS URLs, hardened
                    against drive-by scans, watched by monitors, and restorable
                    from backups. That's not a toy — it's infrastructure you
                    own.
                  </p>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {[
                      "Running lab",
                      "Public HTTPS URLs",
                      "Private remote access",
                      "Hardened edge",
                      "Monitoring + alerts",
                      "Tested backups",
                    ].map((item) => (
                      <span class="inline-flex items-center gap-1.5 rounded-full border border-green-300/70 bg-white/70 px-2.5 py-1 text-xs font-medium text-green-800 dark:border-green-700/60 dark:bg-green-900/30 dark:text-green-300">
                        <Icon name="mdi:check" class="h-3.5 w-3.5" />
                        {item}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            )}

            <section
              id={stage.id}
              class="relative scroll-mt-36 pb-12 pl-14 sm:pl-16"
            >
              {stage.epilogue ? (
                <span class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-full border-2 border-dashed border-blue-400 bg-white text-blue-600 shadow-sm ring-4 ring-white dark:border-blue-500 dark:bg-gray-900 dark:text-blue-400 dark:ring-gray-900">
                  <Icon name={stage.icon} class="h-5 w-5" />
                </span>
              ) : (
                <span class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-full bg-blue-600 font-mono text-sm font-bold text-white shadow-sm ring-4 ring-white dark:ring-gray-900">
                  {stage.number}
                </span>
              )}

              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                {!stage.epilogue && (
                  <Icon
                    name={stage.icon}
                    class="h-6 w-6 text-blue-600 dark:text-blue-400"
                  />
                )}
                <h2 class="text-xl md:text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                  {stage.title}
                </h2>
                <span class="inline-flex items-center gap-1 rounded-full bg-gray-100 px-2.5 py-1 text-[11px] font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
                  <Icon name="mdi:clock-outline" class="h-3.5 w-3.5" />
                  {stage.effort}
                </span>
              </div>
              <p class="mt-2 max-w-2xl text-sm font-medium leading-relaxed text-gray-700 dark:text-gray-300">
                {stage.goal}
              </p>
              {stage.intro && (
                <p class="mt-1 max-w-2xl text-sm leading-relaxed text-gray-500 dark:text-gray-400">
                  {stage.intro}
                </p>
              )}

              <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {stage.cards.map((card) => (
                  <JourneyCard
                    href={card.href}
                    title={card.title}
                    description={card.description}
                    tag={card.tag}
                  />
                ))}
              </div>
            </section>
          </>
        ))
      }
    </div>

    <!-- ============ ROADMAP ============ -->
    <section
      class="rounded-lg border border-dashed border-gray-300 bg-gray-50/60 p-6 dark:border-gray-600 dark:bg-gray-800/40"
    >
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <Icon
          name="mdi:tools"
          class="h-6 w-6 text-blue-600 dark:text-blue-400"
        />
        <h2
          class="text-xl md:text-2xl font-bold tracking-tight text-gray-900 dark:text-white"
        >
          Still on the roadmap
        </h2>
        <span
          class="inline-flex items-center rounded-full bg-gray-200 px-2.5 py-1 text-[11px] font-medium text-gray-600 dark:bg-gray-700 dark:text-gray-300"
        >
          {plannedGuides.length} guides being written
        </span>
      </div>
      <p
        class="mt-2 max-w-2xl text-sm leading-relaxed text-gray-600 dark:text-gray-400"
      >
        The journey has a few gaps we're filling in. These guides are planned —
        check back, or subscribe to the <a
          href="/rss.xml"
          class="font-medium text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
          >RSS feed</a
        > to catch them.
      </p>
      <ul class="mt-5 grid grid-cols-1 gap-x-8 gap-y-2.5 sm:grid-cols-2">
        {
          plannedGuides.map((guide) => (
            <li class="flex items-baseline gap-2 text-sm">
              <Icon
                name="mdi:plus-circle-outline"
                class="h-4 w-4 shrink-0 translate-y-0.5 text-blue-500 dark:text-blue-400"
              />
              <span>
                <code class="font-mono text-[13px] text-gray-800 dark:text-gray-200">
                  {guide.slug}
                </code>
                <span class="ml-2 text-xs text-gray-500 dark:text-gray-400">
                  stage: {guide.stage}
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ============ FOOTER CTA ============ -->
    <section
      class="mt-12 border-t border-gray-200 pt-10 text-center dark:border-gray-700"
    >
      <h2
        class="text-xl md:text-2xl font-bold tracking-tight text-gray-900 dark:text-white"
      >
        Want to wander off the path?
      </h2>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        The full self-hosting archive has every guide we've ever published —
        including the ones that didn't fit a stage.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-4">
        <a
          href="/categories/self-hosting/"
          class="group inline-flex items-center gap-2 rounded-lg bg-blue-600 px-6 py-3 text-base font-semibold text-white shadow-md transition-all duration-200 hover:bg-blue-700 hover:shadow-lg hover:-translate-y-px"
        >
          Browse all self-hosting guides
          <Icon
            name="mdi:arrow-right"
            class="h-5 w-5 transition-transform duration-200 group-hover:translate-x-0.5"
          />
        </a>
        <a
          href="/series/"
          class="group inline-flex items-center gap-1.5 text-base font-semibold text-gray-700 transition-colors duration-200 hover:text-blue-600 dark:text-gray-300 dark:hover:text-blue-400"
        >
          <Icon
            name="mdi:book-open-variant"
            class="h-5 w-5 text-blue-600 dark:text-blue-400"
          />
          Multi-part series
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .journey-caret {
    animation: journey-caret-blink 1.1s step-end infinite;
  }
  @keyframes journey-caret-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .journey-caret {
      animation: none;
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import NewsDigestCard from '@components/news/NewsDigestCard.astro';
import Pagination from '@components/common/Pagination.astro';
import { getPagination } from '@utils/pagination';
import { siteConfig } from '@config/site';
import { absoluteUrl } from '@utils/slugs';

const DIGESTS_PER_PAGE = 12;

// All published digests, newest first
const digests = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime(),
);

const { postsPerPage: pageSize } = getPagination({
  page: 1,
  totalPosts: digests.length,
  postsPerPage: DIGESTS_PER_PAGE,
  basePath: '/news',
});
const paginatedDigests = digests.slice(0, pageSize);

const newsIndexUrl = absoluteUrl('/news/', Astro.site || siteConfig.url);
---

<Layout
  title={`AI & Tech News - ${siteConfig.name}`}
  description="Daily AI and tech news digests for developers and DevOps engineers — model releases, tools, and infrastructure news, curated and summarized."
  hreflangs={[
    { lang: 'en', href: newsIndexUrl },
    { lang: 'x-default', href: newsIndexUrl },
  ]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="mb-10 pb-4 border-b border-gray-200 dark:border-gray-700">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-2">
        AI &amp; Tech News
      </h1>
      <p class="text-base text-gray-600 dark:text-gray-400">
        Daily digests of AI releases, developer tools, and DevOps news — what
        shipped, why it matters, with links to the source
      </p>
    </header>

    {
      paginatedDigests.length > 0 ? (
        <>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {paginatedDigests.map((digest, index) => (
              <NewsDigestCard digest={digest} featured={index === 0} />
            ))}
          </div>

          <Pagination
            currentPage={1}
            totalPages={Math.ceil(digests.length / pageSize)}
            prevUrl={null}
            nextUrl={digests.length > pageSize ? `/news/page/2/` : null}
            basePath="/news"
          />
        </>
      ) : (
        <p class="text-gray-600 dark:text-gray-400">
          No digests published yet. The first daily digest lands soon.
        </p>
      )
    }
  </div>
</Layout>

---
import Layout from "@layouts/Layout.astro";
import NewsDigestCard from "@components/news/NewsDigestCard.astro";
import LatestPosts from "@components/news/LatestPosts.astro";
import { siteConfig } from "@config/site";
import { absoluteUrl } from "@utils/slugs";
import { getLatestDigests } from "@utils/news";

// Rolling window: the hub lists only the newest digests (see utils/news)
const digests = await getLatestDigests();

const newsIndexUrl = absoluteUrl("/news/", Astro.site || siteConfig.url);
---

<Layout
  title={`AI & Tech News - ${siteConfig.name}`}
  description="Daily AI and tech news digests for developers and DevOps engineers — model releases, tools, and infrastructure news, curated and summarized."
  hreflangs={[
    { lang: "en", href: newsIndexUrl },
    { lang: "x-default", href: newsIndexUrl },
  ]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="mb-10 pb-4 border-b border-gray-200 dark:border-gray-700">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-2">
        AI &amp; Tech News
      </h1>
      <p class="text-base text-gray-600 dark:text-gray-400">
        Daily digests of AI releases, developer tools, and DevOps news — what shipped, why it
        matters, with links to the source
      </p>
    </header>

    {digests.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {digests.map((digest, index) => (
          <NewsDigestCard digest={digest} featured={index === 0} />
        ))}
      </div>
    ) : (
      <p class="text-gray-600 dark:text-gray-400">
        No digests published yet. The first daily digest lands soon.
      </p>
    )}

    <LatestPosts />
  </div>
</Layout>

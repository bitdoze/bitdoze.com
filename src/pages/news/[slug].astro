---
import { render } from "astro:content";
import NewsLayout from "@layouts/NewsLayout.astro";
import { mdxComponents } from "@components/mdx-components";
import NewsSectionHeading from "@components/news/NewsSectionHeading.astro";
import NewsListItem from "@components/news/NewsListItem.astro";
import NewsTable from "@components/news/NewsTable.astro";
import { getEntrySlug } from "@utils/content";
import { getLatestDigests } from "@utils/news";

export async function getStaticPaths() {
  // Rolling window: only the newest digests get pages; each links to its neighbors
  const sorted = await getLatestDigests();

  return sorted.map((digest, index) => ({
    params: { slug: getEntrySlug(digest) },
    props: {
      digest,
      // prev = older, next = newer
      prev: index < sorted.length - 1 ? sorted[index + 1] : null,
      next: index > 0 ? sorted[index - 1] : null,
    },
  }));
}

const { digest, prev, next } = Astro.props;
const { Content, headings } = await render(digest);

// Widget components for MDX plus digest-specific element overrides:
// section headings (icon + badge), item panels (title/sources/summary),
// and scrollable tables
const components = {
  ...mdxComponents,
  h2: NewsSectionHeading,
  li: NewsListItem,
  table: NewsTable,
};
---

<NewsLayout digest={digest} headings={headings} prev={prev} next={next}>
  <Content components={components} />
</NewsLayout>

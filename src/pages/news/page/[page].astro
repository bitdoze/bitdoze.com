---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import NewsDigestCard from '@components/news/NewsDigestCard.astro';
import Pagination from '@components/common/Pagination.astro';
import { siteConfig } from '@config/site';
 export const getStaticPaths = (async ({ paginate }) => {
  const DIGESTS_PER_PAGE = 12;
  const digests = (await getCollection('news', ({ data }) => !data.draft)).sort(
    (a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime(),
  );

  const allPages = paginate(digests, { pageSize: DIGESTS_PER_PAGE });
  // Skip page 1 since it's handled by news/index.astro
  return allPages.filter((entry) => entry.params.page !== '1');
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const currentPage = page.currentPage;
const totalPages = page.lastPage;
const basePath = '/news';

// Override prev URL: page 2's prev should link to /news/ not /news/page/1/
const prevUrl = currentPage === 2 ? `${basePath}/` : (page.url.prev ?? null);
---

<Layout
  title={`AI & Tech News - Page ${currentPage} - ${siteConfig.name}`}
  description={`Daily AI and tech news digests for developers and DevOps engineers - Page ${currentPage}`}
  noindex={true}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <header class="mb-10 pb-4 border-b border-gray-200 dark:border-gray-700">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-2">
        AI &amp; Tech News
      </h1>
      <p class="text-base text-gray-600 dark:text-gray-400">
        Page {currentPage} of {totalPages} — daily digests of AI releases,
        developer tools, and DevOps news
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {page.data.map((digest) => (
        <NewsDigestCard digest={digest} />
      ))}
    </div>

    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      prevUrl={prevUrl}
      nextUrl={page.url.next ?? null}
      basePath={basePath}
    />
  </div>
</Layout>

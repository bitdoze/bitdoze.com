---
// Internal index of all /go/ affiliate redirects — handy for verifying slugs.
// noindex, not linked from public pages.
import links from "../../data/affiliate-links.json";

const entries = Object.entries(links).sort(([a], [b]) => a.localeCompare(b));
---

<!doctype html>
<html lang="en" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <title>Affiliate redirect links</title>
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body data-pagefind-ignore>
    <h1>/go/ redirects ({entries.length})</h1>
    <table>
      <thead>
        <tr><th>Slug</th><th>Product</th><th>Destination</th></tr>
      </thead>
      <tbody>
        {
          entries.map(([slug, l]) => (
            <tr>
              <td>
                <a href={`/go/${slug}/`}>/go/{slug}/</a>
              </td>
              <td>{l.name}</td>
              <td>{l.url}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </body>
</html>

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-XSS-Protection: 0
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  No-Vary-Search: key-order, params=("utm_source" "utm_medium" "utm_campaign" "utm_content" "utm_term")
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://an3.bitdoze.com; img-src 'self' data: https://i.ytimg.com https://i3.ytimg.com https://img.youtube.com https://m.media-amazon.com https://cdn.shopify.com https://www.caldigit.com https://media.giphy.com https://astro.build https://app.factory.ai https://bookface-images.s3.amazonaws.com https://brightdata.com https://bunny.net https://context7.com https://exa.ai https://jina.ai https://openrouter.ai https://payhip.com https://ref.tools https://tanstack.com https://vercel.com https://www.brevo.com https://www.cloudflare.com https://www.convex.dev https://www.zoho.com https://z.ai https://z-cdn.chatglm.cn https://zed.dev; frame-src https://www.youtube-nocookie.com https://www.youtube.com; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'self' https://formsubmit.co; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://an3.bitdoze.com

# Agent discovery links — moved here from the deleted Pages Function so they
# ship as static headers instead of paying a Function invocation per request.
/
  Link: </.well-known/api-catalog>; rel="api-catalog", </rss.xml>; rel="alternate"; type="application/rss+xml"; title="Bitdoze RSS Feed", </llms.txt>; rel="llms-txt"

# Hashed build assets (content-addressed by Astro) — safe to cache forever.
# Keep this list path-scoped: extension-wide rules (e.g. /*.webp) merge into
# these and produce conflicting duplicate Cache-Control values.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind indexes are regenerated in-place on every deploy without filename hashes.
/pagefind/*
  Cache-Control: public, max-age=300, must-revalidate

# Public images are NOT content-hashed — a regenerated file under the same name
# must not stay stale for a year. Cache a day, allow a week of SWR.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Root-level files that are not content-hashed either.
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/dragos.jpeg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Markdown copies served for AI/agent consumption — keep out of search indexes
# to avoid duplicate-content signals against the canonical HTML pages.
/md/*
  X-Robots-Tag: noindex
